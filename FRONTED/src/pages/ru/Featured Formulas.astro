---
// src/pages/ru/Featured Formulas.astro — Russian Scientific Formulation Showcase Page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'ru';
const t = useTranslations(lang);
const siteUrl = 'https://ginkvora.com';

// WebPage schema
const featuredFormulasSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Рекомендуемые научные формулы и библиотека рецептур | GINKVORA",
  "description": "Готовые к использованию рецепты научных формул для нутрицевтиков, косметики и здоровья животных. Использование высокочистых NMN, PQQ, глабридина и EGCG.",
  "url": `${siteUrl}/ru/Featured%20Formulas`,
  "isPartOf": { "@type": "WebSite", "url": siteUrl, "name": "GINKVORA" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Главная", "item": `${siteUrl}/ru` },
      { "@type": "ListItem", "position": 2, "name": "Рекомендуемые формулы", "item": `${siteUrl}/ru/Featured%20Formulas` }
    ]
  }
};

const formulas = [
  {
    id: "mitochondria-energy",
    title: "Комплекс для митохондрий и клеточной энергии",
    category: "Биологически активные добавки",
    icon: "⚡",
    form: "Твердая капсула (Размер #0)",
    targetWeight: "500 мг",
    description: "Синергетическая B2B рецептура, направленная на клеточное долголетие, восстановление уровня NAD+ и оптимизацию выработки митохондриального АТФ.",
    actives: [
      { name: "NMN (Никотинамидмононуклеотид)", dose: "250 мг", purity: "≥99.5% (HPLC)", overage: "5%" },
      { name: "Динатриевая соль PQQ (Пирролохинолинхинон)", dose: "20 мг", purity: "≥99.0% (HPLC)", overage: "3%" },
      { name: "Коэнзим Q10 (Убихинон)", dose: "100 мг", purity: "≥98.0% (HPLC)", overage: "2%" }
    ],
    excipients: [
      { name: "Микрокристаллическая целлюлоза (МКЦ 102)", role: "Наполнитель / Связующее", ratio: "115 мг" },
      { name: "Стеарат магния", role: "Смазывающее вещество (скольжение)", ratio: "5 мг" },
      { name: "Диоксид кремния", role: "Антислеживающий агент", ratio: "10 мг" }
    ],
    sop: [
      "Взвесьте NMN, PQQ и CoQ10 отдельно в соответствии с размером партии, учитывая коэффициент технологической потери.",
      "Просейте все активные компоненты и МКЦ через сито из нержавеющей стали (40 меш) для удаления комков.",
      "Предварительно смешайте микродозированный PQQ (20 мг/ед.) с МКЦ методом геометрического разбавления для равномерного распределения.",
      "Загрузите NMN, CoQ10 и смесь PQQ/МКЦ в V-образный смеситель. Смешивайте 15 минут на скорости 20 об/мин.",
      "Добавьте диоксид кремния и стеарат магния в смеситель и проведите финальное смешивание в течение 3 минут.",
      "Расфасуйте однородный порошок в растительные капсулы HPMC размера #0 с целевой массой наполнения 500 мг."
    ],
    notes: "Хранить в сухом вакуумном контейнере при температуре ниже 25°C. Избегать воздействия света, так как NMN и CoQ10 чувствительны к теплу и фотоокислению."
  },
  {
    id: "skin-brightening-serum",
    title: "Улучшенная фитохимическая отбеливающая эмульсия",
    category: "Косметические активы",
    icon: "✨",
    form: "Эмульсия масло-в-воде (М/В) / Крем",
    targetWeight: "100 г Основы",
    description: "Высокоэффективный осветляющий крем, использующий глабридин и EGCG для ингибирования синтеза меланина, уменьшения возрастных пятен и антиоксидантной защиты.",
    actives: [
      { name: "Глабридин (стандартизированный экстракт солодки)", dose: "0.5 г (0.5%)", purity: "40.0% (HPLC)", overage: "2%" },
      { name: "EGCG (эпигаллокатехин галлат)", dose: "1.0 г (1.0%)", purity: "≥98.0% (HPLC)", overage: "4%" },
      { name: "Феруловая кислота", dose: "0.5 г (0.5%)", purity: "≥99.0% (HPLC)", overage: "2%" }
    ],
    excipients: [
      { name: "Фаза А: Деионизированная вода, Глицерин, Карбомер", role: "Водная фаза основы", ratio: "82.0 г" },
      { name: "Фаза B: Каприлик Триглицерид, Масло жожоба, Глицерилстеарат", role: "Масляная фаза и эмульгатор", ratio: "15.0 г" },
      { name: "Фаза D: Феноксиэтанол, Этилгексилглицерин", role: "Консервирующая система", ratio: "1.0 г" }
    ],
    sop: [
      "Подготовьте Фазу А (водную фазу), диспергировав карбомер в деионизированной воде и глицерине. Нагрейте до 75-80°C при умеренном перемешивании.",
      "Подготовьте Фазу B (масляную фазу), соединив липиды и глицерилстеарат. Нагрейте до 75-80°C до полного расплавления и однородности.",
      "Медленно введите Фазу B в Фазу А при высокосдвиговой гомогенизации (3000-3500 об/мин) в течение 8 минут для формирования эмульсии.",
      "Медленно охлаждайте эмульсию при якорном перемешивании (50-60 об/мин). Когда температура опустится ниже 40°C, подготовьте Фазу C.",
      "Фаза C (активные вещества): растворите феруловую кислоту и EGCG в небольшой части воды/пропандиола. Растворите глабридин в каприлик триглицериде. Введите обе смеси в эмульсию.",
      "Добавьте Фазу D (консерванты) при 35°C, измерьте pH и скорректируйте его с помощью триэтаноламина до целевого значения 5.5 - 6.0."
    ],
    notes: "Рекомендуемое значение гидрофильно-липофильного баланса (HLB) эмульгатора составляет около 10.5. Растворяйте глабридин в липидной фазе при температуре ниже 40°C во избежание термической деградации."
  },
  {
    id: "pet-joint-mobility",
    title: "Жевательная таблетка для суставов и подвижности животных",
    category: "Здоровье животных",
    icon: "🐕",
    form: "Мягкая жевательная таблетка холодного прессования",
    targetWeight: "4.0 г",
    description: "Вкусовая функциональная жевательная таблетка ветеринарного класса, разработанная для снижения воспаления суставов и поддержки когнитивных функций пожилых собак.",
    actives: [
      { name: "Экстракт куркумина (стандартизированные куркуминоиды)", dose: "150 мг", purity: "95.0% (HPLC)", overage: "5%" },
      { name: "Экстракт босвеллии пильчатой (босвеллиевые кислоты)", dose: "100 мг", purity: "65.0% (Анализ)", overage: "3%" },
      { name: "Экстракт листьев гинкго билоба", dose: "40 мг", purity: "24% флавонов / 6% лактонов", overage: "2%" }
    ],
    excipients: [
      { name: "Глицерин и растительное масло", role: "Влагоудерживающие агенты / Мягчители", ratio: "800 мг" },
      { name: "Пивные дрожжи и натуральный куриный ароматизатор", role: "Улучшители вкусовой привлекательности", ratio: "1400 мг" },
      { name: "Картофельный крахмал и нутовая мука", role: "Структурообразователи", ratio: "1510 мг" }
    ],
    sop: [
      "Смешайте все сухие ингредиенты, включая экстракты куркумы, босвеллии, гинкго, крахмал, муку и куриный ароматизатор в горизонтальном лопастном смесителе.",
      "Просейте сухую смесь через сито (30 меш) для обеспечения равномерного распределения частиц.",
      "Медленно введите жидкие увлажнители (глицерин, растительное масло, воду) в сухую порошковую смесь при непрерывном перемешивании.",
      "Обработайте массу при комнатной температуре (ниже 35°C) до образования пластичного теста. Не применяйте нагрев для сохранения куркуминоидов.",
      "Подайте тесто в экструдер холодного формования. Нарежьте изделия с целевой массой 4.0 г.",
      "Пропустите экструдированные таблетки через низкотемпературный сушильный туннель до достижения активности воды (Aw) < 0.65 для предотвращения плесени."
    ],
    notes: "Куркумин обладает сильным натуральным желтым пигментом. Используйте оборудование из нержавеющей стали и очищайте его сразу после работы во избежание окрашивания."
  },
  {
    id: "neuro-cognitive-protection",
    title: "Комплекс для нейрокогнитивной защиты и концентрации",
    category: "Биологически активные добавки",
    icon: "🧠",
    form: "Стандартная прессованная таблетка",
    targetWeight: "650 мг",
    description: "Современная когнитивная формула, связывающая лютеолин и экстракт гинкго билоба для поддержки мозгового кровообращения, внимания и борьбы с усталостью.",
    actives: [
      { name: "Лютеолин (стандартизированный экстракт оболочки)", dose: "100 мг", purity: "≥98.0% (HPLC)", overage: "4%" },
      { name: "Экстракт листьев гинкго билоба", dose: "120 мг", purity: "24/6 Стандартизированный (HPLC)", overage: "2%" },
      { name: "Альфа-GPC (L-альфа-глицерилфосфорилхолин)", dose: "150 мг", purity: "50.0% порошок (HPLC)", overage: "5%" }
    ],
    excipients: [
      { name: "Дикальцийфосфат дигидрат (Emcompress)", role: "Наполнитель прямого прессования", ratio: "250 мг" },
      { name: "Кроскармеллоза натрия (Ac-Di-Sol)", role: "Супердезинтегрант", ratio: "20 мг" },
      { name: "Стеариновая кислота и диоксид кремния", role: "Смазывающие и скользящие вещества", ratio: "10 мг" }
    ],
    sop: [
      "Взвесьте лютеолин, гинкго билоба, Альфа-GPC, Emcompress и кроскармеллозу натрия в соответствии с пропорциями.",
      "Альфа-GPC чрезвычайно гигроскопичен; строго поддерживайте относительную влажность (RH) в помещении ниже 35%.",
      "Смешивайте активные ингредиенты и дикальцийфосфат в барабанном смесителе в течение 12 минут для распределения плотных порошков.",
      "Добавьте кроскармеллозу натрия (супердезинтегрант) и смешивайте еще 3 минуты.",
      "Добавьте стеариновую кислоту и диоксид кремния. Смешивайте финальные 2 минуты. Избегайте избыточного смазывания для сохранения твердости таблеток.",
      "Подайте сухую смесь непосредственно в роторный таблеточный пресс с овальными пуансонами 11 мм. Прессуйте до твердости 10-12 kp."
    ],
    notes: "Альфа-GPC быстро поглощает влагу из воздуха. Таблетки должны быть упакованы в блистеры Alu-Alu с высоким барьером или герметичные флаконы HDPE с влагопоглотителем сразу после прессования."
  }
];
---

<BaseLayout
  lang={lang}
  title="Рекомендуемые научные формулы и рецепты"
  description="Изучите профессиональные формулы для B2B биологически активных добавок, косметических активов и здоровья животных. Точные пропорции ингредиентов и инструкции SOP."
>
  <script type="application/ld+json" set:html={JSON.stringify(featuredFormulasSchema)} slot="head" />

  <main class="formulas-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">Библиотека рецептур</span>
        <h1 class="banner-title">Рекомендуемые научные формулы</h1>
        <p class="banner-desc">
          Готовые проекты формул, объединяющие высокочистые растительные экстракты, активные кофакторы и стандартизированные фармацевтические наполнители.
        </p>
      </div>
    </header>

    <!-- Main Content Section -->
    <section class="container section">
      <div class="formulas-intro">
        <p class="intro-text">
          Наша научная команда R&D разработала эти эталонные формулы для помощи разработчикам продуктов, специалистам по закупкам и ученым. Все активные ингредиенты, представленные ниже, доступны для оптового заказа и заказа индивидуальных образцов. Используйте нашу <a href="/ru/calculator" class="highlight-link">Консоль научных рецептур</a> для масштабирования веса партии, корректировки технологических потерь или расчета сложных разведений.
        </p>
      </div>

      <div class="formulas-grid">
        {formulas.map((formula) => (
          <article class="formula-card glass" id={formula.id}>
            <!-- Card Header -->
            <div class="card-header-bar">
              <span class="category-badge">{formula.category}</span>
              <span class="form-badge">{formula.form}</span>
            </div>

            <div class="card-main-title">
              <span class="card-icon">{formula.icon}</span>
              <div>
                <h2>{formula.title}</h2>
                <span class="target-weight">Целевой вес единицы: <strong>{formula.targetWeight}</strong></span>
              </div>
            </div>

            <p class="formula-desc">{formula.description}</p>

            <details class="formula-details">
              <summary class="details-toggle">
                <span>Просмотреть формулу и SOP</span>
                <svg class="toggle-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </summary>

              <div class="details-content">
                <!-- Actives Table -->
                <div class="table-wrapper">
                  <h3>Активные ингредиенты (Активы GINKVORA)</h3>
                  <table class="recipe-table">
                    <thead>
                      <tr>
                        <th>Активный ингредиент</th>
                        <th>Доза / Единица</th>
                        <th>Мин. чистота</th>
                        <th>Коэф. потери</th>
                      </tr>
                    </thead>
                    <tbody>
                      {formula.actives.map(active => (
                        <tr>
                          <td class="font-bold text-white">{active.name}</td>
                          <td class="font-mono font-bold text-primary">{active.dose}</td>
                          <td class="font-mono">{active.purity}</td>
                          <td class="font-mono text-muted">{active.overage}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <!-- Excipients Table -->
                <div class="table-wrapper mt-4">
                  <h3>Рекомендуемые вспомогательные вещества</h3>
                  <table class="recipe-table">
                    <thead>
                      <tr>
                        <th>Компонент</th>
                        <th>Функциональная роль</th>
                        <th>Предлагаемая доза</th>
                      </tr>
                    </thead>
                    <tbody>
                      {formula.excipients.map(exc => (
                        <tr>
                          <td class="font-bold text-white">{exc.name}</td>
                          <td>{exc.role}</td>
                          <td class="font-mono font-bold text-accent">{exc.ratio}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <!-- Step-by-Step SOP -->
                <div class="sop-section mt-4">
                  <h3>Инструкция по приготовлению и смешиванию SOP</h3>
                  <ol class="sop-list">
                    {formula.sop.map(step => (
                      <li>{step}</li>
                    ))}
                  </ol>
                </div>

                <!-- Technical Notes -->
                <div class="notes-block mt-4">
                  <strong>💡 Примечания по формулировке и стабильности:</strong>
                  <p>{formula.notes}</p>
                </div>
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .formulas-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 5rem 2.5rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Intro Section ── */
  .formulas-intro {
    max-width: 800px;
    margin: 0 auto var(--space-2xl) auto;
    text-align: center;
  }

  .intro-text {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .highlight-link {
    color: var(--color-primary-light);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--transition-base);
  }

  .highlight-link:hover {
    color: var(--color-primary);
  }

  /* ── Formulas Grid & Cards ── */
  .formulas-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 900px;
    margin: 0 auto;
  }

  .formula-card {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .formula-card:hover {
    border-color: var(--color-border-strong);
  }

  .card-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-sm);
  }

  .category-badge {
    background: var(--color-primary-glow);
    color: var(--color-primary-light);
    font-size: 0.6875rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 166, 84, 0.2);
  }

  .form-badge {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .card-main-title {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .card-icon {
    font-size: 2.25rem;
    line-height: 1;
  }

  .card-main-title h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .target-weight {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    display: block;
    margin-top: 0.125rem;
  }

  .target-weight strong {
    color: var(--color-text-secondary);
  }

  .formula-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  /* ── Expandable Details ── */
  .formula-details {
    border-top: 1px dashed var(--color-border);
    padding-top: var(--space-md);
  }

  .details-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-light);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color var(--transition-base);
  }

  .details-toggle::-webkit-details-marker {
    display: none;
  }

  .details-toggle:hover {
    color: var(--color-primary);
  }

  .toggle-arrow {
    transition: transform 0.25s ease;
  }

