---
// BaseLayout.astro — Master layout with SEO, i18n, and performance optimizations
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { stripLangPrefix } from '../i18n/utils';

const gtmId = import.meta.env.PUBLIC_GTM_ID as string | undefined;

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  type?: 'website' | 'article' | 'product';
  canonicalUrl?: string;
  noindex?: boolean;
  structuredData?: object;
}

const {
  title,
  description = 'GINKVORA — Premium B2B plant extract supplier. PQQ, NMN, EGCG, Glabridin, Luteolin and specialized high-purity botanical ingredients for nutraceutical, cosmetic and pet health industries.',
  image,
  lang = 'en',
  dir = 'ltr',
  type = 'website',
  canonicalUrl,
  noindex = false,
  structuredData,
} = Astro.props;

const siteUrl = 'https://ginkvora.com';
const fullTitle = title.includes('GINKVORA') ? title : `${title} | GINKVORA`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const basePath = stripLangPrefix(Astro.url.pathname);

// Auto-detect query parameters and force noindex if URL has search parameters
const hasQueryParams = Boolean(Astro.url.search && Astro.url.search.trim().length > 0);
const shouldNoindex = noindex || hasQueryParams;


// Use dynamic OG image generator if no explicit image is provided
const ogImageParams = new URLSearchParams({
  title: fullTitle,
  subtitle: description.slice(0, 80),
});
const ogImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/og-image.png?${ogImageParams.toString()}`;

// Organization structured data (always present)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'GINKVORA',
  url: siteUrl,
  logo: `${siteUrl}/images/logo.svg`,
  description: 'Premium B2B supplier of innovative anti-aging raw materials and high-purity botanical ingredients, specializing in active ingredients powered by Extracellular Matrix (ECM) science. Serving the global cosmetic, nutraceutical, and skin longevity industries with GMP, ISO 9001:2015, Halal, and Kosher certifications.',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'inquiry@ginkvora.com',
    availableLanguage: ['English', 'Russian'],
  },
  sameAs: [
    'https://www.facebook.com/ginkvora',
    'https://www.youtube.com/@Ginkvora',
  ],
};


---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Google Tag Manager (Deferred load after page load for performance) -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function() {
          let gtmLoaded = false;
          function loadGTM() {
            if (gtmLoaded) return;
            gtmLoaded = true;
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;
            f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer',gtmId);
          }

          function scheduleGTM() {
            // Load on idle callback after a short delay to keep initial thread completely free
            if ('requestIdleCallback' in window) {
              requestIdleCallback(function() {
                setTimeout(loadGTM, 1500);
              });
            } else {
              setTimeout(loadGTM, 2000);
            }

            // Also load immediately on first user interaction to ensure no events are lost
            const triggerEvents = ['click', 'mousedown', 'mousemove', 'touchstart', 'scroll', 'keydown'];
            function triggerLoad() {
              loadGTM();
              triggerEvents.forEach(function(event) {
                window.removeEventListener(event, triggerLoad);
              });
            }
            triggerEvents.forEach(function(event) {
              window.addEventListener(event, triggerLoad, { passive: true });
            });
          }

          if (document.readyState === 'complete') {
            scheduleGTM();
          } else {
            window.addEventListener('load', scheduleGTM, { passive: true });
          }
        })();
      </script>
    )}
    <!-- End Google Tag Manager -->

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex, follow" />}
    {!shouldNoindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="canonical" href={canonical} />

    <!--
      ╔══════════════════════════════════════════════════════════╗
      ║  CRITICAL CSS — Inlined to eliminate render-blocking    ║
      ║  delay for above-the-fold H1 text and body background.  ║
      ║  Allows the browser to paint the hero text immediately  ║
      ║  before external CSS sheets finish downloading.          ║
      ╚══════════════════════════════════════════════════════════╝
    -->
    <style is:inline>
      /* Critical: body background + text color (prevents white flash) */
      body{margin:0;background-color:#060503;color:#f5efe0;font-family:'DM Sans','Helvetica Neue',sans-serif;-webkit-font-smoothing:antialiased}
      /* Critical: H1 sizing and font for LCP element */
      h1,h2,h3{font-family:'Cormorant Garamond','Georgia',serif;font-weight:600;line-height:1.15;color:#f5efe0}
      h1{font-size:clamp(2.5rem,6vw,5rem);font-weight:700}
      /* Critical: container + hero layout for first paint */
      .container{width:100%;max-width:1280px;margin-inline:auto;padding-inline:clamp(1rem,5vw,2.5rem)}
      /* Critical: gradient text for hero title gold highlight */
      .gradient-text--gold{background:linear-gradient(135deg,#f0c878 0%,#d4a654 60%,#a07830 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
      /* Critical: section-label badge rendering */
      .section-label{font-size:0.8125rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#e07830}
      .badge{display:inline-flex;align-items:center;gap:0.375rem;padding:0.3rem 0.875rem;border-radius:9999px;font-size:0.8125rem;font-weight:500}
      .badge--gold{background:rgba(212,166,84,0.15);color:#f0c878;border:1px solid rgba(212,166,84,0.3)}
      /* Critical: fade-in-up initial state (prevents layout shift) */
      .fade-in-up{opacity:0}
      /* Critical: skip-link accessibility hiding to prevent FOUC */
      .skip-link{position:absolute;top:-100px;left:1rem;z-index:9999}
      .skip-link:focus{top:0}
    </style>

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="GINKVORA" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : lang === 'ru' ? 'ru_RU' : lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#080d08" />
    <meta name="msapplication-TileColor" content="#080d08" />

    <!-- hreflang for i18n -->
    <link rel="alternate" hreflang="en" href={`${siteUrl}${basePath === '/' ? '' : basePath}`} />
    <link rel="alternate" hreflang="ru" href={`${siteUrl}/ru${basePath === '/' ? '' : basePath}`} />
    <!-- <link rel="alternate" hreflang="es" href={`${siteUrl}/es${basePath === '/' ? '' : basePath}`} /> -->
    <!-- <link rel="alternate" hreflang="ar" href={`${siteUrl}/ar${basePath === '/' ? '' : basePath}`} /> -->
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${basePath === '/' ? '' : basePath}`} />

    <!-- Keywords (B2B SEO) -->
    <meta name="keywords" content="plant extract supplier, botanical ingredients, PQQ supplier, NMN bulk, EGCG extract, Glabridin, Luteolin, Flavone, nutraceutical ingredients, cosmetic actives, pet supplement ingredients, B2B botanical extracts" />

    <!-- Business meta -->
    <meta name="author" content="GINKVORA" />
    <meta name="copyright" content="GINKVORA" />

    <!--
      Performance: Font Preloads
      All font weights used above-the-fold are preloaded to parallelize
      font downloads with CSS parsing, eliminating FOIT (Flash of Invisible Text).
    -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-normal-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-normal-600.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-normal-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-normal-700.woff2" crossorigin />

    <!-- Performance: Preload Critical Hero Background Image -->
    <link rel="preload" as="image" href="/images/hero-bg.webp" type="image/webp" />

    <!-- Performance: DNS prefetch & Preconnect -->
    <link rel="dns-prefetch" href="//cdn.sanity.io" />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="preconnect" href="https://analytics.ginkvora.com" />

    <!-- Analytics (Umami) — loaded async to avoid blocking initial render -->
    <script is:inline>
      try {
        const url = new URL(window.location.href);
        if (url.searchParams.get('access') === 'gkv_admin_debug') {
          localStorage.setItem('umami.disabled', '1');
          console.log('[Umami] Access token detected. Analytics disabled.');
          url.searchParams.delete('access');
          window.history.replaceState({}, document.title, url.pathname + url.search + url.hash);
        }
      } catch (e) {
        console.warn('[Umami] Failed to process access token:', e);
      }
    </script>
    <script
      async
      src="https://analytics.ginkvora.com/script.js"
      data-website-id="df5768a4-e9af-4c4b-8c72-620a91411e86">
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <slot name="head" />
  </head>

  <body class="bg-noise">
    <!-- Google Tag Manager (noscript) -->
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->

    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Navbar lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <!--
      Footer uses content-visibility: auto to skip layout/paint
      computation until the user scrolls near it. This eliminates
      ~100ms of layout work from the initial critical rendering path.
    -->
    <div class="cv-deferred-footer">
      <Footer lang={lang} />
    </div>

    <!-- Reveal animation script -->
    <script>
      // Intersection Observer for scroll reveal animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      );

      document.querySelectorAll('.reveal').forEach((el) => {
        observer.observe(el);
      });
    </script>

    <!--
      GTM Virtual Pageview — Astro ClientRouter (SPA) support.
      On every client-side navigation (astro:after-swap), the new page's
      pathname and title are already updated in the DOM, so we push a
      virtualPageview event to the dataLayer for GTM to pick up.
      This is a no-op if GTM is not loaded (dataLayer falls back to an
      empty array, which is safe).
    -->
    <script is:inline>
      document.addEventListener('astro:after-swap', function () {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'virtualPageview',
          pagePath: window.location.pathname,
          pageTitle: document.title,
        });
      });
    </script>
  </body>
</html>

<style>
  .skip-link {
    background: var(--color-primary);
    color: var(--color-text-inverse);
    padding: 0.5rem 1rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    font-weight: 600;
    transition: top var(--transition-fast);
  }
</style>
