---
// src/pages/es/quality.astro — Spanish Quality page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
const lang = 'es';
const t = useTranslations(lang);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://ginkvora.com/es' },
    { '@type': 'ListItem', position: 2, name: 'Calidad y Certificaciones', item: 'https://ginkvora.com/es/quality' },
  ],
};
---
<BaseLayout lang={lang} title="Calidad y Certificaciones GMP | GINKVORA" description="Los estándares de calidad de GINKVORA: Análisis de pureza HPLC, pruebas GC-MS, ISO 9001, certificación GMP y cumplimiento REACH. Descargue COAs.">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <main class="quality-page bg-noise">
    <header class="page-banner">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label fade-in-up">{t('quality.label')}</span>
        <h1 class="banner-title fade-in-up delay-1">{t('quality.title')}</h1>
        <p class="banner-desc fade-in-up delay-2">Garantizar una pureza constante, documentación fiable y el cumplimiento total de los requisitos para cada lote.</p>
      </div>
    </header>
    <section class="container section lab-section" aria-label="Instrumentos analíticos">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <h2>Análisis y ensayos de vanguardia</h2>
          <p>En GINKVORA, creemos que el análisis químico es la base de la confianza. Nuestro centro de I+D asociado en Xi'an cuenta con instrumentos de alto rendimiento para analizar la pureza de los componentes activos e identificar impurezas.</p>
          <div class="instrument-list">
            <div class="instrument-item"><span class="inst-icon">⚗️</span><div><strong>HPLC (cromatografía líquida de alta resolución)</strong><p>Garantiza una cuantificación precisa de los componentes activos, por ejemplo, verificando Glabridin ≥40,0 % o Luteolin ≥98,0 %.</p></div></div>
            <div class="instrument-item"><span class="inst-icon">🧬</span><div><strong>ICP-MS (espectrometría de masas con plasma acoplado inductivamente)</strong><p>Verifica el cumplimiento de límites internacionales estrictos para metales pesados: plomo, arsénico, cadmio y mercurio.</p></div></div>
            <div class="instrument-item"><span class="inst-icon">🧪</span><div><strong>GC-MS (cromatografía de gases-espectrometría de masas)</strong><p>Evalúa compuestos volátiles y residuos de pesticidas para asegurar el cumplimiento de límites agrícolas estrictos.</p></div></div>
          </div>
        </div>
        <div class="intro-right reveal reveal-delay-2"><div class="image-showcase glass"><img src="/images/ginkvora QC Laboratory.webp" alt="Laboratorio de control de calidad de GINKVORA" class="showcase-img" /></div></div>
      </div>
    </section>

    <section class="section certs-grid-section bg-deep" aria-label="Catálogo de certificaciones">
      <div class="container">
        <div class="section-header"><span class="section-label">Cumplimiento normativo</span><h2 class="section-title">Certificaciones internacionales</h2><p class="section-desc">Las instalaciones de nuestros socios de fabricación cumplen las normativas globales para ingredientes alimentarios y cosméticos.</p></div>
        <div class="grid-4">
          <div class="cert-box glass reveal"><div class="cert-badge-icon">🛡️</div><h3>Cumplimiento GMP</h3><p>Nuestros ingredientes se procesan en instalaciones que cumplen las Buenas Prácticas de Manufactura (GMP), con controles de contaminación cruzada.</p></div>
          <div class="cert-box glass reveal reveal-delay-1"><div class="cert-badge-icon">📜</div><h3>ISO 9001:2015</h3><p>Los sistemas de gestión de calidad certificados cubren desde la recepción de materias primas hasta el envasado y el envío.</p></div>
          <div class="cert-box glass reveal reveal-delay-2"><div class="cert-badge-icon">🕌</div><h3>Certificación Halal</h3><p>Certificada por consejos islámicos reconocidos, cumpliendo los requisitos dietéticos religiosos de los mercados globales.</p></div>
          <div class="cert-box glass reveal reveal-delay-3"><div class="cert-badge-icon">✡️</div><h3>Certificación Kosher</h3><p>Procesado bajo supervisión Kosher, verificando la higiene de fabricación y el cumplimiento de las leyes dietéticas tradicionales.</p></div>
        </div>
      </div>
    </section>

    <section class="container section specs-limits-section" aria-label="Límites estandarizados">
      <div class="section-header"><span class="section-label">Normas de verificación</span><h2>Parámetros de ensayo estandarizados</h2><p class="section-desc">Salvo indicación contraria, cada lote se verifica frente a los siguientes límites.</p></div>
      <div class="specs-limit-box glass reveal"><table class="limits-table"><thead><tr><th>Categoría de ensayo</th><th>Parámetro estándar</th><th>Límite de especificación</th><th>Referencia del método</th></tr></thead><tbody>
        <tr><td><strong>Metales pesados</strong></td><td>Plomo (Pb)</td><td>≤ 0,5 ppm</td><td>USP &lt;233&gt; ICP-MS</td></tr>
        <tr><td><strong>Metales pesados</strong></td><td>Arsénico (As)</td><td>≤ 1,0 ppm</td><td>USP &lt;233&gt; ICP-MS</td></tr>
        <tr><td><strong>Metales pesados</strong></td><td>Mercurio (Hg)</td><td>≤ 0,1 ppm</td><td>USP &lt;233&gt; ICP-MS</td></tr>
        <tr><td><strong>Microbiología</strong></td><td>Recuento total en placa</td><td>≤ 1.000 ufc/g</td><td>USP &lt;2021&gt;</td></tr>
        <tr><td><strong>Microbiología</strong></td><td>Levaduras y mohos</td><td>≤ 100 ufc/g</td><td>USP &lt;2021&gt;</td></tr>
        <tr><td><strong>Microbiología</strong></td><td>E. coli / Salmonella</td><td>Negativo</td><td>USP &lt;2022&gt;</td></tr>
        <tr><td><strong>Químico</strong></td><td>Residuos de pesticidas</td><td>Cumple los límites EP/USP</td><td>GC-MS / LC-MS</td></tr>
        <tr><td><strong>Químico</strong></td><td>Residuos de disolventes</td><td>≤ 500 ppm (etanol)</td><td>GC-Headspace</td></tr>
      </tbody></table></div>
    </section>
  </main>
</BaseLayout>
<style>
  .quality-page { padding-bottom: var(--space-4xl); }
  .page-banner { position: relative; padding-block: 7rem 3.5rem; overflow: hidden; background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%); border-bottom: 1px solid var(--color-border); }
  .banner-gradient { position: absolute; inset: 0; background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%); }
  .banner-title { font-size: clamp(2rem, 3.8vw, 3.1rem); font-weight: 700; line-height: 1.15; margin-top: 0.5rem; color: var(--color-text); }
  .banner-desc { max-width: 600px; margin-top: 1rem; color: var(--color-text-secondary); font-size: 1.0625rem; }
  .intro-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 4rem; align-items: center; }
  .intro-left h2 { font-size: 2.25rem; margin-bottom: 1.25rem; }.intro-left p { color: var(--color-text-secondary); margin-bottom: 2rem; }
  .instrument-list { display: flex; flex-direction: column; gap: 1.5rem; }.instrument-item { display: flex; gap: 1.25rem; align-items: flex-start; }.inst-icon { font-size: 1.75rem; line-height: 1; background: rgba(212,166,84,0.1); padding: 0.5rem; border-radius: var(--radius-sm); color: var(--color-primary); }.instrument-item strong { color: var(--color-primary-light); font-size: 1rem; display: block; margin-bottom: 0.15rem; }.instrument-item p { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; }
  .image-showcase { position: relative; aspect-ratio: 4/3; overflow: hidden; border-color: rgba(212,166,84,0.18) !important; }.showcase-img { width: 100%; height: 100%; object-fit: cover; }
  .bg-deep { background-color: var(--color-bg-deep); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }.cert-box { padding: 2rem 1.5rem; border-radius: var(--radius-lg); border-color: rgba(212,166,84,0.1) !important; text-align: center; }.cert-box:hover { border-color: var(--color-border-strong) !important; box-shadow: var(--shadow-glow-gold); }.cert-badge-icon { font-size: 2.25rem; margin-bottom: 0.875rem; }.cert-box h3 { font-size: 1.25rem; color: var(--color-primary-light); margin-bottom: 0.5rem; }.cert-box p { font-size: 0.8125rem; line-height: 1.6; }
  .specs-limit-box { padding: 1.5rem; overflow-x: auto; border-radius: var(--radius-lg); border-color: rgba(212,166,84,0.15) !important; }.limits-table { width: 100%; border-collapse: collapse; min-width: 600px; }.limits-table th, .limits-table td { padding: 0.875rem 1rem; text-align: left; border-bottom: 1px solid var(--color-border); }.limits-table th { background: var(--color-surface); color: var(--color-primary-light); font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }.limits-table td { font-size: 0.875rem; color: var(--color-text-secondary); }.limits-table tbody tr:hover td { color: var(--color-text); }
  @media (max-width: 900px) { .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
