---
// src/pages/es/thank-you.astro — Spanish B2B Thank-You Page
export const prerender = false; // Disable prerendering to support dynamic content updates
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostsPaginated, urlFor, getLocalizedField, MOCK_POSTS } from '../../lib/sanity';

const lang = 'es';

// Dynamic fetch: get 1 post in "Market Trends" category, or fall back to the latest real Sanity post
let recommendedPost = null;
try {
  const { posts } = await getPostsPaginated({ category: 'Market Trends', page: 1, pageSize: 1 });
  if (posts && posts.length > 0) {
    recommendedPost = posts[0];
  } else {
    const { posts: latest } = await getPostsPaginated({ page: 1, pageSize: 1 });
    if (latest && latest.length > 0) {
      recommendedPost = latest[0];
    }
  }
} catch (err) {
  console.warn('Failed to fetch recommended post from Sanity in thank-you page, using local fallback.');
  recommendedPost = MOCK_POSTS[0];
}

// Localize article details with translation fallback
let localTitle = getLocalizedField(recommendedPost, 'title', lang) ?? recommendedPost.title;
let localExcerpt = getLocalizedField(recommendedPost, 'excerpt', lang) ?? recommendedPost.excerpt;

// Manual fallback translations for mock data in Spanish
if (recommendedPost.slug === 'mitochondrial-health-pqq-science') {
  localTitle = 'Salud mitocondrial: la ciencia detrás del PQQ y el envejecimiento saludable';
  localExcerpt = 'Descubra cómo la pirroloquinolina quinona (PQQ) estimula la biogénesis mitocondrial y su potencial como ingrediente clave para fórmulas de longevidad.';
}
---

<BaseLayout lang={lang} title="Gracias por contactar con nosotros | GINKVORA" description="Gracias por ponerse en contacto con GINKVORA. Su solicitud ha sido recibida con éxito.">
  <main class="thank-you-page bg-noise">
    <div class="container thank-you-container">
      <!-- Success Header Section -->
      <section class="success-header glass reveal" aria-label="Confirmación de envío exitoso">
        <div class="success-icon-wrapper">
          <svg class="success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h1>Solicitud recibida</h1>
        <p class="subtitle">Gracias por ponerse en contacto con GINKVORA.</p>
        <div class="divider"></div>
        <p class="reassurance">
          Nuestro servicio comercial B2B ha recibido su solicitud. Un gerente comercial asignado está analizando sus requisitos (pureza objetiva, volumen de lote y documentación requerida) y se pondrá en contacto con usted por correo electrónico en un plazo de <strong>12 horas</strong> para proporcionarle un presupuesto o coordinar el envío de muestras.
        </p>
        <div class="action-btn-row">
          <a href="/es" class="btn btn--secondary">Volver al inicio</a>
        </div>
      </section>

      <!-- Grid for Recommendations -->
      <div class="recommendations-grid">
        <!-- Recommended Article (Left/Main) -->
        {recommendedPost && (
          <section class="rec-article-card glass reveal" aria-label="Artículo de análisis recomendado">
            <span class="rec-badge">Análisis recomendado de la industria</span>
            <div class="article-content-wrapper">
              <div class="article-image-box">
                <picture style="display: contents;">
                  <source srcset={urlFor(recommendedPost.coverImage).width(800).format('webp').url()} type="image/webp" />
                  <img
                    src={urlFor(recommendedPost.coverImage).width(800).url()}
                    alt={localTitle}
                    class="article-img"
                    loading="lazy"
                  />
                </picture>
              </div>
              <div class="article-text-box">
                <div class="article-meta">
                  <time datetime={recommendedPost.publishedAt}>
                    {recommendedPost.publishedAt ? new Date(recommendedPost.publishedAt).toLocaleDateString('es-ES', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    }) : ''}
                  </time>
                  {recommendedPost.readTime && (
                    <>
                      <span class="meta-dot">•</span>
                      <span>{recommendedPost.readTime} min. de lectura</span>
                    </>
                  )}
                </div>
                <h2>
                  <a href={`/es/insights/${recommendedPost.slug}`}>{localTitle}</a>
                </h2>
                <p class="excerpt">{localExcerpt}</p>
                <a href={`/es/insights/${recommendedPost.slug}`} class="read-more-link">
                  Leer artículo
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </div>
          </section>
        )}

        <!-- Recommended Tools (Right/Sidebar) -->
        <section class="rec-tools-section" aria-label="Secciones útiles del sitio web">
          <div class="tool-card glass reveal">
            <div class="tool-icon">🧮</div>
            <div class="tool-body">
              <h3>Calculadora científica de formulaciones</h3>
              <p>Calcule dosis de ingredientes, proporciones de dilución de solventes y pureza objetiva de activos en tiempo real.</p>
              <a href="/es/calculator" class="tool-link">
                Iniciar calculadora →
              </a>
            </div>
          </div>

          <div class="tool-card glass reveal mt-6">
            <div class="tool-icon">🧪</div>
            <div class="tool-body">
              <h3>Biblioteca de fórmulas recomendadas</h3>
              <p>Explore modelos de fórmulas listos para usar con entrega liposomal para la renovación de la matriz dérmica (ECM).</p>
              <a href="/es/Featured%20Formulas" class="tool-link">
                Ver fórmulas →
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .thank-you-page {
    padding-block: 8rem 5rem;
    min-height: calc(100vh - 200px);
  }

  .thank-you-container {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Success Header ── */
  .success-header {
    padding: 3.5rem;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(212, 166, 84, 0.2) !important;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .success-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.1);
    color: var(--color-success);
    border: 1px solid var(--color-success);
    margin-bottom: 1.5rem;
  }

  .success-icon {
    width: 32px;
    height: 32px;
  }

  .success-header h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .success-header .subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
  }

  .success-header .divider {
    width: 60px;
    height: 2px;
    background: var(--color-primary-light);
    margin: 1.5rem auto;
  }

  .success-header .reassurance {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto 2rem;
  }

  .success-header .reassurance strong {
    color: var(--color-primary-light);
  }

  .action-btn-row {
    display: flex;
    justify-content: center;
  }

  /* ── Recommendations Grid ── */
  .recommendations-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 2.5rem;
  }

  @media (max-width: 900px) {
    .recommendations-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ── Recommended Article Card ── */
  .rec-article-card {
    padding: 2.5rem;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(212, 166, 84, 0.12) !important;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rec-badge {
    align-self: start;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-primary-light);
    border: 1px solid rgba(212, 166, 84, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-content-wrapper {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  @media (max-width: 640px) {
    .article-content-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  .article-image-box {
    width: 220px;
    height: 150px;
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .article-image-box {
      width: 100%;
      height: 180px;
    }
  }

  .article-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-text-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .meta-dot {
    margin-inline: 0.35rem;
  }

  .article-text-box h2 {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .article-text-box h2 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-text-box h2 a:hover {
    color: var(--color-primary-light);
  }

  .article-text-box .excerpt {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-light);
    transition: color var(--transition-fast);
    text-decoration: none;
  }

  .read-more-link:hover {
    color: var(--color-accent-light);
  }

  .read-more-link svg {
    transition: transform var(--transition-fast);
  }

  .read-more-link:hover svg {
    transform: translateX(3px);
  }

  /* ── Recommended Tools ── */
  .rec-tools-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tool-card {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .tool-card:hover {
    border-color: var(--color-border-strong) !important;
    box-shadow: var(--shadow-glow-gold);
  }

  .tool-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .tool-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tool-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .tool-body p {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .tool-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary-light);
    text-decoration: none;
    margin-top: 0.25rem;
    transition: color var(--transition-fast);
  }

  .tool-link:hover {
    color: var(--color-accent-light);
  }
</style>
