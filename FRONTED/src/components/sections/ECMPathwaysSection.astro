---
// ECMPathwaysSection.astro — Three pathways to ECM renewal
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as Lang);
const lp = (path: string) => getLocalePath(lang as Lang, path);

const pathways = [
  {
    icon: '🧬',
    title: t('pathways.collagen_title'),
    description: t('pathways.collagen_desc'),
    anchorText: t('pathways.collagen_anchor'),
    href: lp('/products?mechanism=matrix-rebuilder')
  },
  {
    icon: '🛡️',
    title: t('pathways.mmp_title'),
    description: t('pathways.mmp_desc'),
    anchorText: t('pathways.mmp_anchor'),
    href: lp('/products?mechanism=matrix-shield')
  },
  {
    icon: '⏳',
    title: t('pathways.glyco_title'),
    description: t('pathways.glyco_desc'),
    anchorText: t('pathways.glyco_anchor'),
    href: lp('/products?mechanism=glyco-defense')
  }
];
---

<section class="pathways-section section" id="ecm-pathways">
  <div class="container">
    <!-- Header -->
    <div class="section-header reveal">
      <span class="section-label">{t('pathways.label')}</span>
      <h2 class="section-title">
        {t('pathways.title')}
      </h2>
      <p class="section-desc">
        {t('pathways.desc')}
      </p>
    </div>

    <!-- Pathways Grid -->
    <div class="pathways-grid">
      {pathways.map((path, idx) => (
        <div class={`pathway-card glass reveal reveal-delay-${idx + 1}`}>
          <div class="pathway-icon" aria-hidden="true">{path.icon}</div>
          <h3 class="pathway-title">{path.title}</h3>
          <p class="pathway-desc">{path.description}</p>
          <div class="pathway-link-wrapper">
            <a href={path.href} class="pathway-anchor-link">
              Browse {path.anchorText}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pathways-section {
    position: relative;
    padding-block: 3.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 2.5rem;
  }

  .section-title {
    margin: 0.75rem 0 1rem;
    line-height: 1.2;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }

  .section-desc {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* Grid */
  .pathways-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 992px) {
    .pathways-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .pathway-card {
    padding: 2.25rem 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
    display: flex;
    flex-direction: column;
    transition: all 0.35s ease;
  }

  .pathway-card:hover {
    border-color: var(--color-border-strong) !important;
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow-gold);
  }

  .pathway-icon {
    font-size: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .pathway-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .pathway-desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .pathway-link-wrapper {
    margin-top: auto;
  }

  .pathway-anchor-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: color 0.25s ease;
  }

  .pathway-anchor-link:hover {
    color: var(--color-accent-light);
  }

  .pathway-anchor-link svg {
    transition: transform 0.25s ease;
  }

  .pathway-anchor-link:hover svg {
    transform: translateX(3px);
  }
</style>
