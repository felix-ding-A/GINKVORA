---
// ProductCategoriesSection.astro — Product category showcase with imagery
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
interface Props { lang?: string; }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as Lang);
const lp = (path: string) => getLocalePath(lang as Lang, path);

const categories = [
  {
    id: 'superfood',
    icon: '🍎',
    titleKey: 'categories.health_title',
    descKey: 'categories.health_desc',
    href: lp('/products?category=superfood'),
    ingredientsKeys: ['categories.tag_pqq', 'categories.tag_egcg'],
    color: '#10B981',
    colorBg: 'rgba(16, 185, 129, 0.06)',
    glowColor: '#10B981',
    glowBgColor: 'rgba(16, 185, 129, 0.22)',
    glowColorShadow: 'rgba(16, 185, 129, 0.45)',
    gradientText: 'linear-gradient(135deg, #10B981 0%, #34D399 100%)',
    image: '/images/natural-botanical-health-supplement-ingredients.webp',
    fallbackImage: 'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&q=80&w=800',
    imageAlt: 'Premium natural botanical raw materials and health supplement ingredients.',
  },
  {
    id: 'liposomal',
    icon: '🧬',
    titleKey: 'categories.cosmetic_title',
    descKey: 'categories.cosmetic_desc',
    href: lp('/products?category=liposomal'),
    ingredientsKeys: ['categories.tag_glabridin', 'categories.tag_ghkcu'],
    color: '#F59E0B',
    colorBg: 'rgba(245, 158, 11, 0.06)',
    glowColor: '#F59E0B',
    glowBgColor: 'rgba(245, 158, 11, 0.22)',
    glowColorShadow: 'rgba(245, 158, 11, 0.45)',
    gradientText: 'linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%)',
    image: '/images/natural-botanical-cosmetic-active-ingredients.webp',
    fallbackImage: 'https://images.unsplash.com/photo-1608248597461-807e4620f3e6?auto=format&fit=crop&q=80&w=800',
    imageAlt: 'High-end cosmetic active ingredients and botanical serums formulated for premium skincare.',
  },
  {
    id: 'pet-longevity',
    icon: '🐾',
    titleKey: 'categories.pet_title',
    descKey: 'categories.pet_desc',
    href: lp('/products?category=pet-longevity'),
    ingredientsKeys: ['categories.tag_boswellia', 'categories.tag_glucosamine'],
    color: '#3B82F6',
    colorBg: 'rgba(59, 130, 246, 0.06)',
    glowColor: '#3B82F6',
    glowBgColor: 'rgba(59, 130, 246, 0.22)',
    glowColorShadow: 'rgba(59, 130, 246, 0.45)',
    gradientText: 'linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%)',
    image: '/images/natural-botanical-pet-health-ingredients.webp',
    fallbackImage: 'https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&q=80&w=800',
    imageAlt: 'A group of happy, healthy companion dogs representing natural botanical ingredients formulated for premium pet supplements.',
  },
  {
    id: 'custom',
    icon: '⚗️',
    titleKey: 'categories.custom_title',
    descKey: 'categories.custom_desc',
    href: lp('/custom-formulation'),
    ingredientsKeys: ['categories.tag_liposomal', 'categories.tag_otf'],
    color: '#F97316',
    colorBg: 'rgba(249, 115, 22, 0.06)',
    glowColor: '#F97316',
    glowBgColor: 'rgba(249, 115, 22, 0.22)',
    glowColorShadow: 'rgba(249, 115, 22, 0.45)',
    gradientText: 'linear-gradient(135deg, #F97316 0%, #FB923C 100%)',
    image: '/images/advanced-delivery-formulation-liposomal-otf.webp',
    fallbackImage: 'https://images.unsplash.com/photo-1581093588401-fbb62a02f120?auto=format&fit=crop&q=80&w=800',
    imageAlt: 'Advanced delivery formulation technologies showing liposomal encapsulation and oral thin-film R&D.',
  },
];
---

<section class="categories-section section" id="product-categories">
  <div class="container">
    <!-- Header -->
    <div class="section-header reveal">
      <span class="section-label">{t('categories.label')}</span>
      <h2 class="section-title">
        {t('categories.title_1')}<br/>
        <span class="gradient-text">{t('categories.title_2')}</span>
      </h2>
      <p class="section-desc">
        {t('categories.desc')}
      </p>
    </div>

    <!-- Category cards -->
    <div class="categories-grid">
      {categories.map((cat, idx) => (
        <a
          href={cat.href}
          class={`category-card reveal reveal-delay-${idx + 1}`}
          style={`--cat-color: ${cat.color}; --cat-bg: ${cat.colorBg}; --glow-color: ${cat.glowColor}; --glow-bg-color: ${cat.glowBgColor}; --glow-color-shadow: ${cat.glowColorShadow}; --gradient-text: ${cat.gradientText};`}
          id={`category-${cat.id}`}
          aria-label={`View ${t(cat.titleKey as any)}`}
        >
          <!-- Image -->
          <div class="cat-image">
            <img src={cat.image} alt={cat.imageAlt} loading="lazy" width="400" height="240" onerror={`this.onerror=null;this.src='${cat.fallbackImage}'`} />
            <div class="cat-image-overlay"></div>
            <span class="cat-icon-badge" role="img" aria-hidden="true">{cat.icon}</span>
          </div>

          <!-- Body -->
          <div class="cat-body">
            <h3 class="cat-title">{t(cat.titleKey as any)}</h3>
            <p class="cat-desc">{t(cat.descKey as any)}</p>
            <div class="cat-tags">
              {cat.ingredientsKeys.map((key) => (
                <span class="cat-tag">{t(key as any)}</span>
              ))}
            </div>
            <div class="cat-cta">
              {t('categories.explore_cta')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="categories-cta reveal">
      <a href={lp('/products')} class="btn btn--secondary" id="all-products-btn">
        {t('categories.cta')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    margin: 0.75rem 0 1rem;
    line-height: 1.1;
  }

  .section-desc {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  /* ── Card ── */
  .category-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: var(--color-surface);
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), border-color 0.35s ease, box-shadow 0.35s ease;
    cursor: pointer;
    position: relative;
    transform-style: preserve-3d;
  }

  .category-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    background: radial-gradient(circle at 50% 40%, var(--glow-bg-color), transparent 85%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 0;
  }

  .category-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--glow-color);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    z-index: 2;
  }

  .category-card:hover::before,
  .category-card:hover::after {
    opacity: 1;
  }

  .category-card:hover {
    box-shadow: 0 20px 45px rgba(0,0,0,0.45), 0 0 60px var(--glow-color-shadow);
  }

  /* Individual card-specific styles removed because they are passed inline via styles attribute */

  /* ── Image ── */
  .cat-image {
    position: relative;
    aspect-ratio: 5/3;
    overflow: hidden;
    flex-shrink: 0;
    transform: translateZ(20px);
    transform-style: preserve-3d;
  }

  .cat-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    display: block;
  }

  .category-card:hover .cat-image img {
    transform: scale(1.06) translateZ(20px);
  }

  .cat-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(6,5,3,0) 30%,
      rgba(6,5,3,0.7) 100%
    );
    z-index: 1;
  }

  .cat-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, var(--glow-bg-color), transparent 80%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 2;
  }

  .category-card:hover .cat-image::after {
    opacity: 1;
  }

  .cat-icon-badge {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background: rgba(8,8,6,0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    line-height: 1;
    transform: translateZ(40px);
    transition: transform 0.25s ease;
  }

  .category-card:hover .cat-icon-badge {
    transform: translateZ(50px) scale(1.1);
  }

  /* ── Body ── */
  .cat-body {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transform: translateZ(20px);
    transform-style: preserve-3d;
  }

  .cat-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
    margin: 0;
    transform: translateZ(30px);
    transition: transform 0.25s ease;
  }

  .category-card:hover .cat-title {
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    transform: translateZ(40px);
  }

  .cat-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  .cat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .cat-tag {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    padding: 0.18rem 0.55rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    border: 1px solid var(--color-border);
    letter-spacing: 0.02em;
  }

  .cat-cta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--cat-color);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .category-card:hover .cat-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .categories-cta {
    text-align: center;
  }

  @media (max-width: 768px) {
    .categories-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 3D Tilt Effect for Category Cards
  const cards = document.querySelectorAll('.category-card');
  cards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      // Calculate mouse position relative to card [-1, 1]
      const x = ((e as MouseEvent).clientX - rect.left) / rect.width * 2 - 1;
      const y = ((e as MouseEvent).clientY - rect.top) / rect.height * 2 - 1;

      // Calculate tilt angles (-8deg to 8deg)
      const rotateX = -y * 8;
      const rotateY = x * 8;

      // @ts-ignore
      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px) scale3d(1.02, 1.02, 1.02)`;
    });

    card.addEventListener('mouseleave', () => {
      // @ts-ignore
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0) scale3d(1, 1, 1)';
    });
  });
</script>
