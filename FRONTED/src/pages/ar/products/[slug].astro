    width: 100%;
  }
  .modal-privacy-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.4;
    margin-top: 0.75rem;
  }
  .success-icon-wrap {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .success-check {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: block;
    stroke-width: 2;
    stroke: var(--color-success);
    stroke-miterlimit: 10;
    box-shadow: inset 0px 0px 0px var(--color-success);
    animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s dashed;
    margin: 0 auto;
  }
  .success-check-circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    stroke-width: 2;
    stroke-miterlimit: 10;
    stroke: var(--color-success);
    fill: none;
    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
  }
  .success-check-mark {
    transform-origin: 50% 50%;
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    stroke-width: 3;
    stroke: var(--color-success);
    animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
  }
  @keyframes stroke {
    100% { stroke-dashoffset: 0; }
  }
  @keyframes fill {
    100% { box-shadow: inset 0px 0px 0px 30px rgba(124, 184, 122, 0.05); }
  }
</style>

<script>
  function initTabs() {
    const tabs = document.querySelectorAll('.detail-tab');
    const contents = document.querySelectorAll('.tab-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        contents.forEach((c) => ((c as HTMLElement).style.display = 'none'));

        tab.classList.add('active');
        const targetId = `tab-${tab.getAttribute('data-tab')}`;
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.style.display = 'block';
        }
      });
    });

    // Inquiry submission handler
    const rfqForm = document.getElementById('product-rfq-form') as HTMLFormElement;
    const successMsg = document.getElementById('rfq-success-msg');
    const submitBtn = document.getElementById('rfq-submit-btn') as HTMLButtonElement;

    if (rfqForm) {
      rfqForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending Request...';
        }

        const formData = new FormData(rfqForm);
        // Honeypot check: if hidden field filled, likely a bot
        if (formData.get('b_website')) {
          console.warn('Bot submission detected via honeypot field.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Quotation Request';
          }
          return;
        }

        const submitRfq = async (token?: string) => {
          const data = {
            name: formData.get('name'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            quantity: formData.get('quantity') || 'Not specified',
            message: formData.get('message') || 'None',
            productName: formData.get('productName'),
            b_website: formData.get('b_website'),
            recaptchaToken: token || null,
          };

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });

            if (res.ok) {
              rfqForm.reset();
              if (successMsg) successMsg.style.display = 'block';
              if (submitBtn) submitBtn.textContent = 'Submitted ✓';
              window.location.href = '/ar/thank-you';
            } else {
              const errData = await res.json();
              alert(errData.error || 'Failed to send request. Please try again or contact us directly.');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send Quotation Request';
              }
            }
          } catch (err) {
            alert('Network error. Please try again.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send Quotation Request';
            }
          }
        };

        // @ts-ignore
        if (typeof grecaptcha !== 'undefined') {
          // @ts-ignore
          grecaptcha.ready(() => {
            // @ts-ignore
            grecaptcha.execute('6LfauEktAAAAAMqxmIliI2O9cby28DZr-cQyhLid', { action: 'submit_rfq' })
              .then((token) => {
                submitRfq(token);
              })
              .catch((err) => {
                console.error('reCAPTCHA execution failed:', err);
                submitRfq();
              });
          });
        } else {
          submitRfq();
        }
      });
    }
  }

  function initCOAModal() {
    const coaBtn = document.getElementById('download-coa-btn');
    const modal = document.getElementById('coa-modal');
    const closeBtn = document.getElementById('coa-modal-close');
    const form = document.getElementById('coa-lead-form') as HTMLFormElement;
    const formState = document.getElementById('coa-form-state');
    const successState = document.getElementById('coa-success-state');
    const fallbackLink = document.getElementById('coa-fallback-link') as HTMLAnchorElement;
    const successClose = document.getElementById('coa-success-close');
    const submitBtn = document.getElementById('coa-submit-btn') as HTMLButtonElement;

    if (!coaBtn || !modal) return;

    const productName = coaBtn.getAttribute('data-product-name') || '';
    const coaUrl = coaBtn.getAttribute('data-coa-url') || '';

    coaBtn.addEventListener('click', (e) => {
      e.preventDefault();
      
      // Reset form and states
      if (form) form.reset();
      if (formState) formState.style.display = 'block';
      if (successState) successState.style.display = 'none';
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit & Instant Download';
      }
      
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
    });

    const closeModal = () => {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (successClose) successClose.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Processing...';
        }

        const formData = new FormData(form);

        // Honeypot check
        if (formData.get('b_website')) {
          console.warn('Bot detected.');
          closeModal();
          return;
        }

        const applications: string[] = [];
        form.querySelectorAll('input[name="application"]:checked').forEach((el) => {
          applications.push((el as HTMLInputElement).value);
        });

        const submitCoa = async (token?: string) => {
          const data = {
            name: formData.get('name'),
            company: formData.get('company') || 'None',
            email: formData.get('email'),
            phone: formData.get('phone'),
            role: formData.get('role'),
            demand: formData.get('demand'),
            application: applications,
            productName,
            coaUrl,
            b_website: formData.get('b_website'),
            recaptchaToken: token || null,
          };

          try {
            const res = await fetch('/api/coa-lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });

            if (res.ok) {
              if (formState) formState.style.display = 'none';
              if (successState) successState.style.display = 'block';
              
              if (fallbackLink) {
                fallbackLink.href = coaUrl;
              }

              // Push custom event to dataLayer for GTM tracking
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({
                event: 'coa_lead_submit',
                productName: productName,
                coaUrl: coaUrl
              });

              // Trigger the download in a new window
              window.open(coaUrl, '_blank');
            } else {
              const errData = await res.json();
              alert(errData.error || 'Failed to submit form. Please try again.');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit & Instant Download';
              }
            }
          } catch (err) {
            alert('Network error. Please check your connection and try again.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Submit & Instant Download';
            }
          }
        };

        // @ts-ignore
        if (typeof grecaptcha !== 'undefined') {
          // @ts-ignore
          grecaptcha.ready(() => {
            // @ts-ignore
            grecaptcha.execute('6LfauEktAAAAAMqxmIliI2O9cby28DZr-cQyhLid', { action: 'submit_coa' })
              .then((token) => {
                submitCoa(token);
              })
              .catch((err) => {
                console.error('reCAPTCHA execution failed:', err);
                submitCoa();
              });
          });
        } else {
          submitCoa();
        }
      });
    }
  }

  function runInit() {
    initTabs();
    initCOAModal();
  }

  // Astro page-load support
  runInit();
  document.addEventListener('astro:page-load', runInit);
</script>
