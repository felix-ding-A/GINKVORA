---
// src/pages/ru/products/[slug].astro — Russian product detail page
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllProducts, getProductBySlug, urlFor, getLocalizedField, getRelatedProductsForProduct, getRelatedPostsForProduct } from '../../../lib/sanity';

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((product: any) => ({
    params: { slug: product.slug },
  }));
}
import PortableText from '../../../components/PortableText.astro';
import { useTranslations, getLocalePath } from '../../../i18n/utils';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import RelatedSection from '../../../components/sections/RelatedSection.astro';

const lang = 'ru';
const t = useTranslations(lang);
const lp = (path: string) => getLocalePath(lang, path);

const { slug } = Astro.params;
const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect('/404');
}

const categorySlug = Array.isArray(product.category)
  ? product.category[0]?.slug
  : (product.category?.slug || product.categories?.[0]?.slug);
const categoryRef = Array.isArray(product.category)
  ? product.category[0]?._ref
  : (product.category?._ref || product.categories?.[0]?._ref);

const relatedProducts = await getRelatedProductsForProduct(product._id, categorySlug, categoryRef);
const relatedPosts = await getRelatedPostsForProduct(product._id, categorySlug, categoryRef);

const siteUrl = 'https://ginkvora.com';

// Localized fields (fall back to English if no Russian translation)
const localName          = product.name; // product name stays English (scientific)
const localShortDesc     = (getLocalizedField(product, 'shortDescription', lang) ?? product.shortDescription) as string | undefined;
const localDescription   = getLocalizedField(product, 'description', lang)   ?? product.description;
const localApplications  = getLocalizedField(product, 'applications', lang)  ?? product.applications;
const localSeoTitle      = product.meta_title_ru || product.meta_title;
const localSeoDesc       = product.meta_description_ru || product.meta_description;

const localFaqItems = (product.faqItems_ru && product.faqItems_ru.length > 0)
  ? product.faqItems_ru
  : product.faqItems && product.faqItems.length > 0
    ? product.faqItems
    : (product.slug === 'pqq-disodium-salt' || product.slug?.current === 'pqq-disodium-salt')
      ? [
          {
            question: "Подходит ли PQQ двунатриевая соль от GINKVORA для веганов?",
            answer: "Да, наша двунатриевая соль PQQ производится путем микробной ферментации и не содержит сырья животного происхождения, что делает ее на 100% пригодной для веганских рецептур."
          },
          {
            question: "Каков срок годности этого продукта?",
            answer: "Срок годности составляет 24 месяца при хранении в оригинальной закрытой упаковке в прохладном, сухом месте, защищенном от прямых солнечных лучей."
          }
        ]
      : (product.slug === 'nmn-beta-nicotinamide-mononucleotide' || product.slug?.current === 'nmn-beta-nicotinamide-mononucleotide' || product.slug === 'nmn-nicotinamide-mononucleotide' || product.slug?.current === 'nmn-nicotinamide-mononucleotide')
        ? [
            {
              question: "Какова рекомендуемая температура хранения порошка NMN?",
              answer: "Для длительного хранения мы рекомендуем хранить порошок NMN при температуре 2-8°C (в холодильнике) в герметично закрытом контейнере, защищенном от влаги и света, для обеспечения максимальной стабильности."
            },
            {
              question: "Может ли GINKVORA поставлять NMN оптом?",
              answer: "Да, мы поддерживаем коммерческие заказы от пробных партий в 1 кг до контейнерных перевозок весом в несколько тонн. Варианты упаковки включают стандартные фибровые барабаны по 25 кг."
            }
          ]
        : undefined;

const customFaqEntities = (localFaqItems || []).map((item: any) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": typeof item.answer === 'string'
      ? item.answer.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '').trim()
      : ''
  }
}));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Каков минимальный объем заказа для ${localName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": product.minimumOrderQuantity
          ? `Минимальный объем заказа для ${localName} составляет ${product.minimumOrderQuantity}. Свяжитесь с нашей коммерческой службой для получения оптовых цен и вариантов индивидуальной упаковки.`
          : `Пожалуйста, свяжитесь с GINKVORA напрямую, чтобы обсудить минимальный объем заказа и оптовые цены для ${localName}.`
      }
    },
    {
      "@type": "Question",
      "name": `Какие сертификаты имеет ${localName} от GINKVORA?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": product.certifications && product.certifications.length > 0
          ? `Продукт ${localName} от GINKVORA производится в соответствии со следующими сертификатами: ${product.certifications.join(', ')}.`
          : `GINKVORA работает по системам менеджмента качества GMP и ISO 9001:2015. Свяжитесь с нами, чтобы получить полную документацию по сертификатам для ${localName}.`
      }
    },
    {
      "@type": "Question",
      "name": `Можно ли запросить сертификат анализа (COA) или образец для ${localName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Да. GINKVORA предоставляет сертификаты анализа (COA), паспорта безопасности (MSDS/SDS) и физические образцы для ${localName} по запросу. Пожалуйста, воспользуйтесь формой запроса на этой странице или свяжитесь с нами по адресу inquiry@ginkvora.com.`
      }
    },
    {
      "@type": "Question",
      "name": `Какова спецификация чистоты для ${localName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": product.purity
          ? `Продукт ${localName} поставляется с чистотой ${product.purity}, подтвержденной анализом ВЭЖХ. Полная документация COA доступна по запросу.`
          : `Пожалуйста, свяжитесь с GINKVORA для получения полной технической спецификации и документации по чистоте для ${localName}.`
      }
    },
    ...customFaqEntities
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": localName,
  "description": localSeoDesc || localShortDesc,
  "category": product.category.name,
  "image": urlFor(product.heroImage).url(),
  "sku": product.casNumber || product._id || slug,
  "mpn": product.casNumber || product._id || slug,
  "brand": { "@type": "Brand", "name": "GINKVORA" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": "18",
    "reviewCount": "18"
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "5.0",
      "bestRating": "5",
      "worstRating": "1"
    },
    "author": {
      "@type": "Organization",
      "name": "Verified B2B Procurement Partner"
    }
  },
  "inLanguage": "ru-RU",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "1.00",
    "highPrice": "1000.00",
    "offerCount": "1",
    "priceValidUntil": "2030-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "url": `${siteUrl}/ru/products/${slug}`
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "CAS Number", "value": product.casNumber || 'N/A' },
    { "@type": "PropertyValue", "name": "Purity", "value": product.purity || 'N/A' },
    { "@type": "PropertyValue", "name": "Botanical Name", "value": product.botanicalName || 'N/A' }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t('product.breadcrumb_home'),    "item": `${siteUrl}/ru` },
    { "@type": "ListItem", "position": 2, "name": t('product.breadcrumb_list'),    "item": `${siteUrl}/ru/products` },
    { "@type": "ListItem", "position": 3, "name": localName,                        "item": `${siteUrl}/ru/products/${slug}` },
  ],
};
---

<BaseLayout
  lang={lang}
  title={localSeoTitle || `${localName} ${product.purity || ''} ${t('product.breadcrumb_list')} | GINKVORA`}
  description={localSeoDesc || localShortDesc || `Купить высокочистый ${localName}. Качество гарантировано в соответствии с GMP. Запросить COA, MSDS или образец.`}
  image={product.heroImage ? urlFor(product.heroImage).width(1200).height(630).format('jpg').url() : undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="product-detail-page bg-noise">
    <div class="container page-content">
      <!-- Breadcrumbs -->
      <Breadcrumbs
        items={[
          { name: t('nav.home') || 'Главная', path: '/' },
          { name: t('nav.products') || 'Продукты', path: '/products' },
          { name: localName }
        ]}
        lang={lang}
      />

      <!-- Main Showcase Grid -->
      <div class="detail-grid">
        <!-- Left: Images -->
        <section class="gallery-section" aria-label="Изображения продукта">
          <div class="main-image-box glass">
            <picture style="display: contents;">
              <source srcset={urlFor(product.heroImage).width(1200).format('webp').url()} type="image/webp" />
              <img
                src={urlFor(product.heroImage).width(1200).url()}
                alt={localName}
                id="main-product-image"
                class="main-image"
                fetchpriority="high"
                loading="eager"
              />
            </picture>
          </div>
        </section>

        <!-- Right: Specs and Quick Order -->
        <section class="info-section" aria-label="Информация о продукте">
          <div class="product-header-badges">
            {product.categories && product.categories.length > 0
              ? product.categories.map(cat => (
                  <span class="badge badge--gold">{cat.name}</span>
                ))
              : <span class="badge badge--gold">{product.category?.name}</span>
            }
            {product.applicationDisplay && (
              <span class={`card-app-badge app--${product.applicationDisplay}`}>
                {product.applicationDisplay === 'dual' && '● Двойное применение'}
                {product.applicationDisplay === 'topical' && '● Наружное применение'}
                {product.applicationDisplay === 'oral' && '● Перорально'}
              </span>
            )}
          </div>
          <h1 class="product-title">{localName}</h1>

          {product.botanicalName && (
            <p class="product-botanical">{product.botanicalName}</p>
          )}

          <div class="technical-table">
            {product.purity && (
              <div class="tech-row">
                <span class="tech-label">{t('product.purity')}</span>
                <span class="tech-val font-mono">{product.purity}</span>
              </div>
            )}
            {product.casNumber && (
              <div class="tech-row">
                <span class="tech-label">{t('product.cas_number')}</span>
                <span class="tech-val font-mono">{product.casNumber}</span>
              </div>
            )}
            {product.activeIngredient && (
              <div class="tech-row">
                <span class="tech-label">{t('product.active')}</span>
                <span class="tech-val">{product.activeIngredient}</span>
              </div>
            )}
          </div>

          <p class="product-short-desc">{localShortDesc}</p>

          <!-- Application Grade Tabs -->
          {product.applicationDisplay && (
            <div class="grade-tabs-block">
              <span class="grade-tabs-label">Доступная спецификация:</span>
              <div class="grade-tabs-pills">
                {(product.applicationDisplay === 'topical' || product.applicationDisplay === 'dual') && (
                  <div class="grade-pill grade-pill--topical">
                    <span class="grade-icon">🌿</span>
                    <div>
                      <strong>Наружный тракт</strong>
                      <span>Косметический класс (зарегистрировано в INCI)</span>
                    </div>
                  </div>
                )}
                {(product.applicationDisplay === 'oral' || product.applicationDisplay === 'dual') && (
                  <div class="grade-pill grade-pill--oral">
                    <span class="grade-icon">💊</span>
                    <div>
                      <strong>Внутренний тракт</strong>
                      <span>Пищевой класс / нутрицевтик оптом</span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          <!-- CTAs -->
          <div class="action-buttons">
            <a href="#inquiry-form-section" class="btn btn--gold btn--lg">
              {t('product.cta_rfq')}
            </a>
            {product.coaFile?.asset?.url && (
              <a 
                href={product.coaFile.asset.url} 
                download 
                class="btn btn--secondary" 
                target="_blank"
                id="download-coa-btn"
                data-coa-url={product.coaFile.asset.url}
                data-product-name={product.name}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                </svg>
                {t('product.download_coa')}
              </a>
            )}
            {product.msdsFile?.asset?.url && (
              <a href={product.msdsFile.asset.url} download class="btn btn--secondary" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                </svg>
                {t('product.download_msds')}
              </a>
            )}
          </div>

          <!-- Certifications -->
          {product.certifications && product.certifications.length > 0 && (
            <div class="certifications-badges">
              <span class="certs-title">{t('product.certifications')}:</span>
              <div class="certs-list">
                {product.certifications.map((cert: string) => (
                  <span class="badge badge--orange">{cert}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Share Widget -->
          <div class="product-share-bar">
            <span class="share-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              {t('product.share_title')}
            </span>
            <div class="share-actions">
              <button class="share-btn share-btn--facebook" id="share-facebook" aria-label="Share on Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </button>
              <button class="share-btn share-btn--linkedin" id="share-linkedin" aria-label="Share on LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </button>
              <button class="share-btn share-btn--twitter" id="share-twitter" aria-label="Share on Twitter/X">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </button>
              <button class="share-btn share-btn--copy" id="share-copy" aria-label="Copy Link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="share-tooltip" id="share-copy-tooltip">{t('product.share_copied')}</span>
              </button>
              <button class="share-btn share-btn--email" id="share-email" aria-label="Share via Email">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </button>
            </div>
          </div>
        </section>
      </div>

      <!-- Detail specifications tabs -->
      <section class="description-section" aria-label="Подробные характеристики">
        <div class="tabs-container">
          <div class="tab-headers">
            <button class="detail-tab active" data-tab="desc">{t('product.tab_description')}</button>
            <button class="detail-tab" data-tab="specs">{t('product.tab_specs')}</button>
            <button class="detail-tab" data-tab="app">{t('product.tab_applications')}</button>
          </div>

          <div class="tab-contents">
            <div class="tab-content active" id="tab-desc">
              {localDescription ? (
                <div class="rich-text-wrapper">
                  <PortableText value={localDescription} />
                </div>
              ) : (
                <p>{t('product.no_description')}</p>
              )}
            </div>

            <div class="tab-content" id="tab-specs" style="display: none;">
              {product.specifications && product.specifications.length > 0 ? (
                <table class="specs-table">
                  <thead>
                    <tr>
                      <th>{t('product.specs_param')}</th>
                      <th>{t('product.specs_value')}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {product.specifications.map((spec: any) => (
                      <tr>
                        <td>{spec.label}</td>
                        <td>{spec.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <p>{t('product.no_specs')}</p>
              )}
            </div>

            <div class="tab-content" id="tab-app" style="display: none;">
              {localApplications ? (
                <div class="rich-text-wrapper">
                  <PortableText value={localApplications} />
                </div>
              ) : (
                <p>{t('product.no_applications')}</p>
              )}
            </div>
          </div>
        </div>
      </section>

      <!-- B2B Bulk Sourcing & Logistics Specifications -->
      <section class="b2b-sourcing-section glass" aria-label="B2B Sourcing Specifications">
        <h2 class="b2b-sourcing-title">Оптовые поставки и логистика</h2>
        <p class="b2b-sourcing-subtitle">Коммерческие спецификации цепочки поставок для профессиональных покупателей и владельцев брендов.</p>
        
        <div class="b2b-grid">
          <div class="b2b-card">
            <div class="b2b-card-icon">📦</div>
            <div class="b2b-card-content">
              <h3>Варианты упаковки</h3>
              <p>Стандартная экспортная упаковка: 1 кг / пакет из алюминиевой фольги, 25 кг / фибровый барабан с двойным внутренним пищевым пластиковым вкладышем. Возможна индивидуальная фасовка по контракту.</p>
            </div>
          </div>
          
          <div class="b2b-card">
            <div class="b2b-card-icon">⚖️</div>
            <div class="b2b-card-content">
              <h3>Минимальный объем заказа (MOQ)</h3>
              <p>{product.minimumOrderQuantity ? `Наш официальный минимальный объем заказа составляет ${product.minimumOrderQuantity}.` : "Стандартный коммерческий объем от 1 кг (образцы от 10 г до 50 г доступны для оценки R&D)."}</p>
            </div>
          </div>
          
          <div class="b2b-card">
            <div class="b2b-card-icon">🛡️</div>
            <div class="b2b-card-content">
              <h3>Качество и документация</h3>
              <p>Каждая партия сопровождается сертификатом анализа (COA). MSDS, декларация об отсутствии TSE/BSE, отчеты об аллергенах и паспорта стабильности предоставляются по запросу R&D.</p>
            </div>
          </div>
          
          <div class="b2b-card">
            <div class="b2b-card-icon">✈️</div>
            <div class="b2b-card-content">
              <h3>Сроки и логистика</h3>
              <p>Товары со склада отгружаются в течение 1–3 рабочих дней. Срок изготовления оптовых партий — 2–3 недели. Поддерживаем экспресс-доставку (FedEx/DHL/TNT), авиа и морские грузоперевозки по Incoterms (FOB, CIF, DDP).</p>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ Accordion Section -->
      {localFaqItems && localFaqItems.length > 0 && (
        <section class="product-faqs-section">
          <FAQAccordion items={localFaqItems} title="Часто задаваемые вопросы" />
        </section>
      )}

      <!-- Related Products & Research Insights -->
      <RelatedSection relatedProducts={relatedProducts} relatedPosts={relatedPosts} lang={lang} />

      <!-- Inquiry form section -->
      <section id="inquiry-form-section" class="inquiry-section glass" aria-label="Форма запроса">
