---
// src/pages/es/contact.astro — Spanish Contact page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
const lang = 'es';
const t = useTranslations(lang);

const title = "Contáctenos | Proveedor de Ingredientes Botánicos y Bioactivos";
const description = "Solicite especificaciones de ingredientes, documentación reglamentaria o muestras de GINKVORA. Nuestro equipo de suministro B2B responde en 24 horas.";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contactar con GINKVORA",
  "description": description,
  "url": "https://ginkvora.com/es/contact"
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "GINKVORA",
  "image": "https://ginkvora.com/images/logo.svg",
  "email": "inquiry@ginkvora.com",
  "telephone": "+86 13201818603",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Xi'an International Trade & Logistics Park",
    "addressLocality": "Xi'an",
    "addressCountry": "CN"
  },
  "url": "https://ginkvora.com/es"
};
---
<BaseLayout lang={lang} title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <main class="contact-page bg-noise">
    <header class="page-banner">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <h1 class="banner-title fade-in-up delay-1">{t('contact.title')}</h1>
        <p class="banner-desc fade-in-up delay-2">{t('contact.subtitle')}</p>
      </div>
    </header>
    <div class="container contact-layout">
      <div class="contact-info glass">
        <h2>Póngase en contacto con nosotros</h2>
        <div class="info-items">
          <div class="info-item">
            <span class="info-icon p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 text-[var(--color-primary-light)] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </span>
            <div>
              <span class="info-label">Correo electrónico</span>
              <a href="mailto:inquiry@ginkvora.com" class="info-val">inquiry@ginkvora.com</a>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 text-[var(--color-primary-light)] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <div>
              <span class="info-label">Tiempo de respuesta</span>
              <span class="info-val">En un plazo de 24 horas</span>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 text-[var(--color-primary-light)] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </span>
            <div>
              <span class="info-label">Regiones atendidas</span>
              <span class="info-val">Más de 50 países en todo el mundo</span>
            </div>
          </div>
          <div class="info-item">
            <span class="info-icon">☎</span>
            <div>
              <span class="info-label">Teléfono / WhatsApp directo</span>
              <a href="https://wa.me/8613201818603" target="_blank" rel="noopener noreferrer" class="info-val">+86 132 0181 8603</a>
            </div>
          </div>
        </div>
        <div class="policy-summary"><h3>Políticas de suministro B2B</h3><p><strong>Muestras:</strong> se ofrecen muestras estándar de 10–50 g a fabricantes cualificados; se aplican gastos de envío.</p><p><strong>Documentación:</strong> cada lote se acompaña de COA y la documentación disponible se confirma antes de la cotización.</p></div>
      </div>
      <div class="contact-form-wrap glass">
        <h2>Formulario de Consulta</h2>
        <form id="es-contact-form" class="contact-form" novalidate>
          <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="Leave this field empty" />
          <div class="form-group">
            <label for="name">{t('contact.form_name')} *</label>
            <input type="text" id="name" name="name" required placeholder="Juan Pérez / Nombre de la empresa" />
          </div>
          <div class="form-group">
            <label for="email">{t('contact.form_email')} *</label>
            <input type="email" id="email" name="email" required placeholder="juan@empresa.es" />
          </div>
          <div class="form-group">
            <label for="phone">Teléfono / WhatsApp *</label>
            <input type="tel" id="phone" name="phone" required placeholder="+34 600 123 456" />
          </div>
          <div class="form-group">
            <label for="website">Sitio web de la empresa</label>
            <input type="url" id="website" name="website" placeholder="https://suempresa.com" />
          </div>
          <div class="form-group">
            <label for="industry">Sector *</label>
            <select id="industry" name="industry" required><option value="">Seleccione una opción</option><option>Cosmética</option><option>Suplementos / nutracéuticos</option><option>Alimentos y bebidas</option><option>Fabricación OEM/ODM</option><option>Investigación y desarrollo</option><option>Otro</option></select>
          </div>
          <div class="form-group">
            <label for="productSelect">Producto o ingrediente de interés</label>
            <input type="text" id="productSelect" name="productSelect" placeholder="Ej.: PDRN, Glabridin, NMN" />
          </div>
          <div class="form-group">
            <label for="quantity">Cantidad estimada</label>
            <input type="text" id="quantity" name="quantity" placeholder="Ej.: 10 kg, 100 kg o muestra" />
          </div>
          <div class="form-group">
            <label for="message">{t('contact.form_message')}</label>
            <textarea id="message" name="message" rows="5" placeholder="Opcional. Especifique el nombre del producto, cantidad requerida, especificaciones..."></textarea>
          </div>
          <button type="submit" class="btn btn--gold btn--lg" id="es-submit-btn" style="width: 100%; justify-content: center;">
            {t('contact.form_submit')}
          </button>
          <div id="es-form-success" class="form-success" style="display:none;">{t('contact.form_success')}</div>
          <div id="es-form-error" class="form-error" style="display:none;">Ocurrió un error. Por favor, inténtelo de nuevo.</div>
        </form>
      </div>
    </div>
  </main>
</BaseLayout>
<style>
  .contact-page { padding-block: 0 var(--space-4xl); }
  .page-banner { position: relative; padding-block: 8rem 5rem; background: linear-gradient(135deg, #030201 0%, #0e1007 60%, #0a0703 100%); overflow: hidden; margin-bottom: var(--space-2xl); }
  .banner-gradient { position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(212,166,84,0.07) 0%, transparent 70%); }
  .banner-content { position: relative; z-index: 1; text-align: center; max-width: 700px; margin-inline: auto; }
  .banner-title { font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 700; line-height: 1.15; margin-bottom: 1rem; }
  .banner-desc { font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.75; }
  .contact-layout { display: grid; grid-template-columns: 1fr 1.5fr; gap: 3rem; }
  @media (max-width: 900px) { .contact-layout { grid-template-columns: 1fr; } }
  .contact-info, .contact-form-wrap { padding: 2.5rem; border-radius: var(--radius-xl); border: 1px solid var(--color-border) !important; }
  .contact-info h2, .contact-form-wrap h2 { font-size: 1.5rem; font-family: var(--font-display); margin-bottom: 1.5rem; color: var(--color-text); }
  .info-items { display: flex; flex-direction: column; gap: 1.5rem; }
  .info-item { display: flex; gap: 1rem; align-items: flex-start; }
  .info-icon { font-size: 1.5rem; }
  .info-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: 0.25rem; }
  .info-val { color: var(--color-text-secondary); font-size: 0.9375rem; text-decoration: none; transition: color var(--transition-fast); }
  a.info-val:hover { color: var(--color-primary-light); }
  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.375rem; }
  .form-group label { font-size: 0.875rem; font-weight: 500; color: var(--color-text-muted); }
  .form-group input, .form-group select, .form-group textarea { padding: 0.75rem 1rem; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font-size: 0.9375rem; transition: border-color var(--transition-fast); font-family: inherit; resize: vertical; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--color-primary); }
  .policy-summary { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.65; }.policy-summary h3 { color: var(--color-primary-light); font-size: 1rem; margin-bottom: 0.75rem; }.policy-summary p + p { margin-top: 0.65rem; }
  .form-success { padding: 1rem; background: rgba(52,211,153,0.1); border: 1px solid rgba(52,211,153,0.3); border-radius: var(--radius-md); color: #34d399; text-align: center; font-size: 0.9375rem; }
  .form-error { padding: 1rem; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: var(--radius-md); color: #ef4444; text-align: center; font-size: 0.9375rem; }
</style>
<script>
  const form = document.getElementById('es-contact-form') as HTMLFormElement;
  const success = document.getElementById('es-form-success');
  const error = document.getElementById('es-form-error');
  const btn = document.getElementById('es-submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    
    const formData = new FormData(form);
    if (formData.get('b_website')) {
      console.warn('Bot submission detected via honeypot field.');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando...';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (res.ok) {
        if (success) success.style.display = 'block';
        form.reset();
        (window as any).gkvTrackLeadAndRedirect('/es/thank-you', 'contact');
      } else {
        if (error) error.style.display = 'block';
      }
    } catch {
      if (error) error.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar consulta';
    }
  });
</script>
