---
// src/pages/thank-you.astro — English B2B Thank-You Page
export const prerender = false; // Disable prerendering so that it can dynamically fetch current posts if updated in Sanity CMS
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsPaginated, urlFor, MOCK_POSTS } from '../lib/sanity';

// Dynamic fetch: get 1 post in "Market Trends" category
let recommendedPost = null;
try {
  const { posts } = await getPostsPaginated({ category: 'Market Trends', page: 1, pageSize: 1 });
  if (posts && posts.length > 0) {
    recommendedPost = posts[0];
  }
} catch (err) {
  console.warn('Failed to fetch recommended post from Sanity in thank-you page, using local fallback.');
}

// Fallback to local mock data
if (!recommendedPost) {
  recommendedPost = MOCK_POSTS.find(p => p.tags && p.tags.includes('Market Trends')) || MOCK_POSTS[0];
}
---

<BaseLayout title="Thank You | GINKVORA" description="Thank you for contacting GINKVORA. Your inquiry has been successfully received.">
  <main class="thank-you-page bg-noise">
    <div class="container thank-you-container">
      <!-- Success Header Section -->
      <section class="success-header glass reveal" aria-label="Submission Success Confirmation">
        <div class="success-icon-wrapper">
          <svg class="success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h1>Inquiry Received</h1>
        <p class="subtitle">Thank you for reaching out to GINKVORA.</p>
        <div class="divider"></div>
        <p class="reassurance">
          Our B2B commercial desk has received your request. A dedicated account manager is reviewing your specifications (target purity, volume, and documentation requirements) and will contact you via email within <strong>12 hours</strong> with custom pricing or sample shipping details.
        </p>
        <div class="action-btn-row">
          <a href="/" class="btn btn--secondary">Back to Homepage</a>
        </div>
      </section>

      <!-- Grid for Recommendations -->
      <div class="recommendations-grid">
        <!-- Recommended Article (Left/Main) -->
        {recommendedPost && (
          <section class="rec-article-card glass reveal" aria-label="Recommended Market Analysis Article">
            <span class="rec-badge">Recommended Industry Analysis</span>
            <div class="article-content-wrapper">
              <div class="article-image-box">
                <picture style="display: contents;">
                  <source srcset={urlFor(recommendedPost.coverImage).width(800).format('webp').url()} type="image/webp" />
                  <img
                    src={urlFor(recommendedPost.coverImage).width(800).url()}
                    alt={recommendedPost.title}
                    class="article-img"
                    loading="lazy"
                  />
                </picture>
              </div>
              <div class="article-text-box">
                <div class="article-meta">
                  <time datetime={recommendedPost.publishedAt}>
                    {recommendedPost.publishedAt ? new Date(recommendedPost.publishedAt).toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    }) : 'May 2026'}
                  </time>
                  {recommendedPost.readTime && (
                    <>
                      <span class="meta-dot">•</span>
                      <span>{recommendedPost.readTime} min read</span>
                    </>
                  )}
                </div>
                <h2>
                  <a href={`/insights/${recommendedPost.slug}`}>{recommendedPost.title}</a>
                </h2>
                <p class="excerpt">{recommendedPost.excerpt}</p>
                <a href={`/insights/${recommendedPost.slug}`} class="read-more-link">
                  Read Article
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </div>
          </section>
        )}

        <!-- Recommended Tools (Right/Sidebar) -->
        <section class="rec-tools-section" aria-label="Related Site Pages">
          <div class="tool-card glass reveal">
            <div class="tool-icon">🧮</div>
            <div class="tool-body">
              <h3>Scientific Formulation Calculator</h3>
              <p>Calculate ingredient dosages, solvent dilution targets, active component purity adjustments, and blend ratios on the fly.</p>
              <a href="/calculator" class="tool-link">
                Launch Calculator →
              </a>
            </div>
          </div>

          <div class="tool-card glass reveal mt-6">
            <div class="tool-icon">🧪</div>
            <div class="tool-body">
              <h3>Featured Formulas Library</h3>
              <p>Browse pre-designed, synergistic B2B formulation models featuring liposomal delivery and active ECM remodeling botanicals.</p>
              <a href="/Featured%20Formulas" class="tool-link">
                Explore Formulas →
              </a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .thank-you-page {
    padding-block: 8rem 5rem;
    min-height: calc(100vh - 200px);
  }

  .thank-you-container {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Success Header ── */
  .success-header {
    padding: 3.5rem;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(212, 166, 84, 0.2) !important;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .success-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.1);
    color: var(--color-success);
    border: 1px solid var(--color-success);
    margin-bottom: 1.5rem;
  }

  .success-icon {
    width: 32px;
    height: 32px;
  }

  .success-header h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .success-header .subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
  }

  .success-header .divider {
    width: 60px;
    height: 2px;
    background: var(--color-primary-light);
    margin: 1.5rem auto;
  }

  .success-header .reassurance {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto 2rem;
  }

  .success-header .reassurance strong {
    color: var(--color-primary-light);
  }

  .action-btn-row {
    display: flex;
    justify-content: center;
  }

  /* ── Recommendations Grid ── */
  .recommendations-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 2.5rem;
  }

  @media (max-width: 900px) {
    .recommendations-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* ── Recommended Article Card ── */
  .rec-article-card {
    padding: 2.5rem;
    border-radius: var(--radius-xl);
    border: 1px solid rgba(212, 166, 84, 0.12) !important;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .rec-badge {
    align-self: start;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-primary-light);
    border: 1px solid rgba(212, 166, 84, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-content-wrapper {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  @media (max-width: 640px) {
    .article-content-wrapper {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  .article-image-box {
    width: 220px;
    height: 150px;
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .article-image-box {
      width: 100%;
      height: 180px;
    }
  }

  .article-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-text-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .meta-dot {
    margin-inline: 0.35rem;
  }

  .article-text-box h2 {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .article-text-box h2 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .article-text-box h2 a:hover {
    color: var(--color-primary-light);
  }

  .article-text-box .excerpt {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-light);
    transition: color var(--transition-fast);
    text-decoration: none;
  }

  .read-more-link:hover {
    color: var(--color-accent-light);
  }

  .read-more-link svg {
    transition: transform var(--transition-fast);
  }

  .read-more-link:hover svg {
    transform: translateX(3px);
  }

  /* ── Recommended Tools ── */
  .rec-tools-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tool-card {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .tool-card:hover {
    border-color: var(--color-border-strong) !important;
    box-shadow: var(--shadow-glow-gold);
  }

  .tool-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .tool-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tool-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .tool-body p {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .tool-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary-light);
    text-decoration: none;
    margin-top: 0.25rem;
    transition: color var(--transition-fast);
  }

  .tool-link:hover {
    color: var(--color-accent-light);
  }
</style>
