{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["hkg1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/blog/:slug", "destination": "/insights/:slug", "permanent": true },
    { "source": "/es/ru/:path*", "destination": "/ru/:path*", "permanent": true },
    { "source": "/ar/ru/:path*", "destination": "/ru/:path*", "permanent": true },
    { "source": "/ru/ru/:path*", "destination": "/ru/:path*", "permanent": true },
    { "source": "/es/formulator", "destination": "/calculator", "permanent": true },
    { "source": "/ar/formulator", "destination": "/calculator", "permanent": true },
    { "source": "/ru/formulator", "destination": "/ru/calculator", "permanent": true },
    { "source": "/es/ru/formulator", "destination": "/ru/calculator", "permanent": true },
    { "source": "/ar/ru/formulator", "destination": "/ru/calculator", "permanent": true },
    { "source": "/(es|ar)/products/egcg-epigallocatechin-gallate", "destination": "/products/egcg", "permanent": true },
    { "source": "/(es|ar)/products/flavone", "destination": "/products/luteolin", "permanent": true },
    { "source": "/ru/products/flavone-99", "destination": "/ru/products/luteolin", "permanent": true },
    { "source": "/ru/products/glabridin-40", "destination": "/ru/products/glabridin", "permanent": true },
    { "source": "/es/products/glabridin-40", "destination": "/products/glabridin", "permanent": true },
    { "source": "/es/products/flavone-99", "destination": "/products/luteolin", "permanent": true },
    { "source": "/(es|ar)/insights/quercetin-senolytic-anti-aging", "destination": "/insights/quercetin-senolytic-aging", "permanent": true },
    { "source": "/es/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/ar/:path*", "destination": "/:path*", "permanent": true }
  ]
}
