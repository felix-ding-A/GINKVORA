---
// src/pages/es/insights/index.astro — Spanish insights listing
export const prerender = false; // Disable prerendering so SSR handles searchParams (category, q, page)

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPostsPaginated, urlFor, getLocalizedField } from '../../../lib/sanity';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const pageParam = Astro.url.searchParams.get('page');
const category = Astro.url.searchParams.get('category') || null;
const searchQuery = Astro.url.searchParams.get('q') || '';
const pageSize = 9;

const { posts: allPosts, total } = await getPostsPaginated({ category, search: searchQuery, page: 1, pageSize: 100 });
const totalPages = Math.max(1, Math.ceil(total / pageSize));
const rawPage = parseInt(pageParam ?? '1', 10);
const currentPage = Math.min(Math.max(1, isNaN(rawPage) ? 1 : rawPage), totalPages);
const page = currentPage;

// Helper function to build page URLs while preserving category query params
function getPageHref(pageNum: number) {
  const url = new URL(Astro.url.href);
  if (pageNum <= 1) {
    url.searchParams.delete('page');
  } else {
    url.searchParams.set('page', pageNum.toString());
  }
  const q = url.searchParams.toString();
  return url.pathname + (q ? '?' + q : '');
}

const siteUrl = 'https://ginkvora.com';

// Breadcrumb structured data
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": `${siteUrl}/es`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": `${siteUrl}/es/insights`
    }
  ]
};

// ItemList structured data
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Blog de la Industria GINKVORA",
  "description": "Investigaciones sobre ingredientes, actualizaciones regulatorias y experiencia en formulación de la mano del equipo científico de GINKVORA.",
  "url": `${siteUrl}/es/insights`,
  "numberOfItems": allPosts.length,
  "itemListElement": allPosts.map((post: any, i: number) => {
    const localTitle = getLocalizedField(post, 'title', lang) ?? post.title;
    return {
      "@type": "ListItem",
      "position": i + 1,
      "url": `${siteUrl}/es/insights/${post.slug}`,
      "name": localTitle,
    };
  })
};
---

<BaseLayout
  lang={lang}
  title="Blog de GINKVORA — Investigaciones, formulación y análisis de activos de la matriz extracelular (ECM)"
  description="Investigaciones y artículos de GINKVORA: revisiones científicas de dosis, guías de formulación de PDRN, NMN, glabridina y bioactivos antienvejecimiento de la ECM."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />
  <main class="insights-page bg-noise">
    <header class="page-banner" aria-label="Cabecera de página">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">{t('insights.title')}</span>
        <h1 class="banner-title">{t('insights.title')}</h1>
        <p class="banner-desc">{t('insights.subtitle')}</p>

        <!-- Search bar inside Banner -->
        <form action="/es/insights" method="GET" class="search-form">
          <div class="search-input-wrapper">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input 
              type="text" 
              name="q" 
              value={searchQuery} 
              placeholder={t('insights.search_placeholder')} 
              class="search-input"
            />
            {searchQuery && (
              <a href={category ? `/es/insights?category=${encodeURIComponent(category)}` : "/es/insights"} class="search-clear-btn" aria-label="Clear search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18" />
                  <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
              </a>
            )}
          </div>
          {category && (
            <input type="hidden" name="category" value={category} />
          )}
          <button type="submit" class="btn btn--primary search-submit-btn">{t('common.search')}</button>
        </form>
      </div>
    </header>

    <div class="container">
      {allPosts.length > 0 ? (
        <div class="posts-grid" id="insights-grid" data-current-page={currentPage}>
          {allPosts.map((post: any, index: number) => {
            const pageIndex = Math.floor(index / pageSize) + 1;
            const isVisible = pageIndex === currentPage;
            const localTitle   = (getLocalizedField(post, 'title', lang)   ?? post.title)   as string;
            const localExcerpt = (getLocalizedField(post, 'excerpt', lang)  ?? post.excerpt) as string | undefined;
            return (
              <article
                class="post-card glass reveal"
                data-page-index={pageIndex}
                style={isVisible ? "display: flex;" : "display: none;"}
              >
                <a href={`/es/insights/${post.slug}`} class="card-image-link" aria-label={localTitle}>
                  <picture>
                    <source srcset={urlFor(post.coverImage).width(600).format('webp').url()} type="image/webp" />
                    <img src={urlFor(post.coverImage).width(600).url()} alt={localTitle} width="600" height="338" loading="lazy" decoding="async" class="card-cover" />
                  </picture>
                </a>
                <div class="card-body">
                  <div class="card-meta">
                    {post.publishedAt && (
                      <time datetime={post.publishedAt}>
                        {new Date(post.publishedAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
                      </time>
                    )}
                    {post.readTime && (
                      <span>{post.readTime} {t('insights.min_read')}</span>
                    )}
                  </div>
                  <h2 class="card-title">
                    <a href={`/es/insights/${post.slug}`}>{localTitle}</a>
                  </h2>
                  {localExcerpt && (
                    <p class="card-excerpt">{localExcerpt}</p>
                  )}
                  {post.tags && post.tags.length > 0 && (
                    <div class="card-tags">
                      {post.tags.slice(0, 3).map((tag: string) => (
                        <span class="tag-chip">{tag}</span>
                      ))}
                    </div>
                  )}
                  <a href={`/es/insights/${post.slug}`} class="read-more">
                    {t('insights.read_more')}
                    <span class="sr-only"> sobre {localTitle}</span>
                    →
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Pagination Component -->
        {totalPages > 1 && (
          <nav class="pagination" aria-label="Navegación de paginación">
            {page > 1 ? (
              <a href={getPageHref(page - 1)} class="page-btn page-arrow" aria-label="Ir a la página anterior">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
                {t('common.previous')}
              </a>
            ) : (
              <span class="page-btn page-btn--disabled page-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6" />
                </svg>
                {t('common.previous')}
              </span>
            )}

            <div class="page-numbers">
              {Array.from({ length: totalPages }).map((_, idx) => {
                const pageNum = idx + 1;
                const isCurrent = pageNum === page;
                return isCurrent ? (
                  <span class="page-btn page-btn--active" aria-current="page">
                    {pageNum}
                  </span>
                ) : (
                  <a href={getPageHref(pageNum)} class="page-btn" aria-label={`Ir a la página ${pageNum}`}>
                    {pageNum}
                  </a>
                );
              })}
            </div>

            {page < totalPages ? (
              <a href={getPageHref(page + 1)} class="page-btn page-arrow" aria-label="Ir a la siguiente página">
                {t('common.next')}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </a>
            ) : (
              <span class="page-btn page-btn--disabled page-arrow">
                {t('common.next')}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </span>
            )}
          </nav>
        )}
      ) : (
        <div class="no-posts-container glass">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <line x1="10" y1="9" x2="8" y2="9"/>
          </svg>
          <h3>{t('insights.no_posts')}</h3>
          <p>
            {searchQuery 
              ? t('insights.search_no_results').replace('{query}', searchQuery) 
              : t('insights.no_posts')}
          </p>
          <a href="/es/insights" class="btn btn--secondary">{t('insights.all_posts')}</a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .insights-page { padding-block: 0 var(--space-4xl); }
  .page-banner { position: relative; padding-block: 8rem 5rem; background: linear-gradient(135deg, #030201 0%, #0e1007 60%, #0a0703 100%); overflow: hidden; margin-bottom: var(--space-2xl); }
  .banner-gradient { position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(212,166,84,0.07) 0%, transparent 70%); }
  .banner-content { position: relative; z-index: 1; text-align: center; max-width: 700px; margin-inline: auto; }
  .banner-title { font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 700; line-height: 1.15; margin-bottom: 1rem; }
  .banner-desc { font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.75; }

  .posts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 1.75rem; }
  .post-card { display: flex; flex-direction: column; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--color-border) !important; transition: transform var(--transition-base), box-shadow var(--transition-base); }
  .post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-xl); border-color: rgba(212,166,84,0.25) !important; }
  .card-image-link { display: block; aspect-ratio: 16/9; overflow: hidden; }
  .card-cover { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .post-card:hover .card-cover { transform: scale(1.04); }
  .card-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .card-meta { display: flex; gap: 0.75rem; font-size: 0.8125rem; color: var(--color-text-muted); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; }
  .card-title { font-size: 1.175rem; font-weight: 600; line-height: 1.35; }
  .card-title a { color: var(--color-text); text-decoration: none; transition: color var(--transition-fast); }
  .card-title a:hover { color: var(--color-primary-light); }
  .card-excerpt { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .tag-chip { font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: var(--radius-full); border: 1px solid var(--color-border); color: var(--color-text-muted); }
  .read-more { font-size: 0.875rem; color: var(--color-primary-light); text-decoration: none; font-weight: 500; margin-top: auto; transition: color var(--transition-fast); }
  .read-more:hover { color: var(--color-primary); }

  /* ── Pagination ── */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .page-numbers {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    min-width: 2.5rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition: all var(--transition-base);
    text-decoration: none;
    cursor: pointer;
  }

  .page-btn:hover:not(.page-btn--disabled):not(.page-btn--active) {
    color: var(--color-primary-light);
    border-color: var(--color-primary-light);
    background: rgba(212, 166, 84, 0.05);
  }

  .page-btn--active {
    background: var(--color-primary);
    color: var(--color-bg);
    border-color: var(--color-primary);
    cursor: default;
  }

  .page-btn--disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .page-arrow {
    gap: 0.25rem;
    padding-inline: 1rem;
  }
  .no-posts-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 5rem 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.15) !important;
    max-width: 600px;
    margin: 2rem auto 0;
    width: 100%;
  }

  .no-posts-container svg {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .no-posts-container h3 {
    font-size: 1.625rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .no-posts-container p {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  /* ── Search Bar ── */
  .search-form {
    margin-top: 2rem;
    display: flex;
    gap: 0.75rem;
    max-width: 600px;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  .search-input-wrapper {
    position: relative;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 1.25rem;
    color: var(--color-text-muted, #7c7c7c);
    pointer-events: none;
    transition: color var(--transition-fast);
  }

  .search-input {
    width: 100%;
    padding: 0.875rem 3rem 0.875rem 3rem;
    border-radius: var(--radius-lg, 8px);
    border: 1px solid var(--color-border, rgba(255,255,255,0.15));
    background: rgba(22, 24, 26, 0.75);
    color: var(--color-text, #ffffff);
    font-size: 1rem;
    transition: all var(--transition-base);
    backdrop-filter: blur(10px);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary-light, #f0c878);
    background: rgba(22, 24, 26, 0.9);
    box-shadow: 0 0 12px rgba(212, 166, 84, 0.25);
  }

  .search-input:focus-within + .search-icon {
    color: var(--color-primary-light, #f0c878);
  }

  .search-clear-btn {
    position: absolute;
    right: 1.25rem;
    color: var(--color-text-muted, #7c7c7c);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 0;
    transition: color var(--transition-fast);
  }

  .search-clear-btn:hover {
    color: var(--color-text, #ffffff);
  }

  .search-submit-btn {
    padding-inline: 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    white-space: nowrap;
    border-radius: var(--radius-lg, 8px);
    cursor: pointer;
  }

  @media (max-width: 576px) {
    .search-form {
      gap: 0.5rem;
    }
    .search-input {
      padding: 0.75rem 2.5rem 0.75rem 2.5rem;
      font-size: 0.875rem;
    }
    .search-icon {
      left: 0.875rem;
    }
    .search-clear-btn {
      right: 0.875rem;
    }
    .search-submit-btn {
      padding-inline: 1.25rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // Programmatically handle mobile keyboard enter/go submit to guarantee compatibility
  document.querySelectorAll('.search-input').forEach(el => {
    const input = el as HTMLInputElement;
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const form = input.closest('form');
        if (form) {
          form.submit();
        }
      }
    });
  });

  function initInsightsPagination() {
    const grid = document.getElementById('insights-grid');
    const paginationNav = document.querySelector('.container .pagination');
    if (!grid) return;

    const cards = grid.querySelectorAll('.post-card');
    const urlParams = new URLSearchParams(window.location.search);
    const pageFromUrl = parseInt(urlParams.get('page') || '');
    const currentPage = !isNaN(pageFromUrl) && pageFromUrl > 0
      ? pageFromUrl
      : parseInt(grid.getAttribute('data-current-page') || '1');

    cards.forEach((card) => {
      const pageIndex = parseInt(card.getAttribute('data-page-index') || '1');
      (card as HTMLElement).style.display = pageIndex === currentPage ? 'flex' : 'none';
    });

    if (paginationNav) {
      const pageButtons = paginationNav.querySelectorAll('.page-numbers .page-btn');
      pageButtons.forEach((btn) => {
        const pageNum = parseInt(btn.textContent || '1');
        if (pageNum === currentPage) {
          btn.classList.add('page-btn--active', 'active');
          btn.setAttribute('aria-current', 'page');
        } else {
          btn.classList.remove('page-btn--active', 'active');
          btn.removeAttribute('aria-current');
        }
      });
    }
  }

  initInsightsPagination();
  document.addEventListener('astro:page-load', initInsightsPagination);
</script>
