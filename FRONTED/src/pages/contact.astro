---
// src/pages/contact.astro — Premium B2B Inquiry and RFQ page
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';

// Pre-fill query param support
const title = "Contact GINKVORA | B2B Plant Extract Sourcing & RFQ";
const description = "Contact GINKVORA for B2B plant extract inquiries, bulk pricing, custom formulation specs & free sample requests. Fast global commercial RFQ support.";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact GINKVORA",
  "description": description,
  "url": "https://ginkvora.com/contact"
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "GINKVORA",
  "image": "https://ginkvora.com/images/logo.svg",
  "email": "inquiry@ginkvora.com",
  "telephone": "+86 13201818603",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Xi'an International Trade & Logistics Park",
    "addressLocality": "Xi'an",
    "addressCountry": "CN"
  },
  "url": "https://ginkvora.com"
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <main class="contact-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <h1 class="banner-title">Contact GINKVORA</h1>
      </div>
    </header>

    <div class="container contact-container">
      <div class="contact-grid">
        <!-- Left: Form -->
        <section class="form-card glass" aria-label="RFQ Inquiry Form">
          <h2>Request for Quotation / Sample</h2>
          <p class="form-subtitle">Fields marked with an asterisk (*) are required.</p>

          <form id="contact-full-form" class="full-form">
            <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="Leave this field empty" />
            <div class="form-row-2">
              <div class="form-field">
                <label for="name" class="form-label">Name/Company Name *</label>
                <input type="text" id="name" name="name" required class="form-input" placeholder="John Doe / BioTech Ltd" />
              </div>
              <div class="form-field">
                <label for="email" class="form-label">Email / Work Email *</label>
                <input type="email" id="email" name="email" required class="form-input" placeholder="john@company.com" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-field">
                <label for="phone" class="form-label">Phone / WhatsApp *</label>
                <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+1 (555) 123-4567" />
              </div>
              <div class="form-field">
                <label for="website" class="form-label">Company Website</label>
                <input type="url" id="website" name="website" class="form-input" placeholder="https://company.com" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-field">
                <label for="industry" class="form-label">Industry Sector</label>
                <select id="industry" name="industry" class="form-input form-select">
                  <option value="" disabled selected>Select sector...</option>
                  <option value="dietary-supplements">Dietary Supplements</option>
                  <option value="cosmetics">Cosmetics & Skincare</option>
                  <option value="pet-health">Pet Health & Feeds</option>
                  <option value="food-beverage">Functional Food/Beverage</option>
                  <option value="pharmaceuticals">Pharmaceuticals</option>
                  <option value="other">Other / Research</option>
                </select>
              </div>
              <div class="form-field">
                <label for="productSelect" class="form-label">Target Ingredient</label>
                <input type="text" id="productSelect" name="productName" class="form-input" placeholder="e.g. PQQ, NMN, Glabridin..." />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-field">
                <label for="quantity" class="form-label">Required Quantity</label>
                <input type="text" id="quantity" name="quantity" class="form-input" placeholder="e.g. 25kg, 100kg" />
              </div>
            </div>

            <div class="form-field">
              <label for="message" class="form-label">Message & Specification Requirements</label>
              <textarea id="message" name="message" class="form-input" rows="5" placeholder="Optional. Specify purity levels, target shipping port, certification requirements, or custom formulation requests..."></textarea>
            </div>

            <button type="submit" class="btn btn--gold btn--lg" id="submit-btn">
              Send RFQ Inquiry
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>

            <div id="success-msg" class="success-message" style="display: none;" role="alert">
              ✓ Quotation request sent. An executive will email you within 12 hours.
            </div>
          </form>
        </section>

        <!-- Right: Info -->
        <aside class="info-sidebar">
          <div class="info-card glass">
            <h3>Direct Contact Coordinates</h3>
            <p>Skip the form and communicate directly with our commercial desk.</p>

            <div class="contact-list">
              <div class="contact-item">
                <div class="contact-icon p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 text-[var(--color-primary-light)] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <div class="contact-body">
                  <span class="label">General Inquiry & RFQ</span>
                  <a href="mailto:inquiry@ginkvora.com" class="val">inquiry@ginkvora.com</a>
                </div>
              </div>

              <div class="contact-item">
                <div class="contact-icon p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 text-[var(--color-primary-light)] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div class="contact-body">
                  <span class="label">Phone / WhatsApp Support</span>
                  <a href="https://wa.me/8613201818603" target="_blank" rel="noopener noreferrer" class="val">+86 13201818603</a>
                </div>
              </div>

              <div class="contact-item">
                <div class="contact-icon p-2 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 text-[var(--color-primary-light)] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div class="contact-body">
                  <span class="label">HQ Address</span>
                  <span class="val">Xi'an International Trade & Logistics Park, Xi'an, China</span>
                </div>
              </div>
            </div>
          </div>

          <div class="info-card glass mt-6">
            <h3>B2B Sourcing Policies</h3>
            <ul class="policy-list">
              <li>
                <strong>Free Samples:</strong> Standard 10g-50g samples are available for qualified manufacturers (shipping charges apply).
              </li>
              <li>
                <strong>MOQ Standards:</strong> Standard packaging MOQs are 1kg or 25kg (fiber drums) depending on the ingredient value.
              </li>
              <li>
                <strong>Documentation:</strong> COA, MSDS, Specifications, and Allergen declarations are provided with every quotation.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </main>
  

</BaseLayout>

<style>
  .contact-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 8rem 4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Grid ── */
  .contact-container {
    margin-top: -2rem;
    position: relative;
    z-index: var(--z-float);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 2.5rem;
  }

  @media (max-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .form-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.18) !important;
  }

  .form-card h2 {
    font-size: 1.875rem;
    margin-bottom: 0.25rem;
  }

  .form-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .full-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .form-row-2 { grid-template-columns: 1fr; gap: 1.25rem; }
  }

  .full-form #submit-btn {
    align-self: center;
    margin-top: 1rem;
  }

  .mt-6 { margin-top: 1.5rem; }

  /* ── Sidebar ── */
  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
  }

  .info-card h3 {
    font-size: 1.375rem;
    color: var(--color-primary-light);
    margin-bottom: 0.75rem;
  }

  .info-card p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .contact-icon {
    font-size: 1.5rem;
    line-height: 1;
    padding-top: 0.2rem;
  }

  .contact-body {
    display: flex;
    flex-direction: column;
  }

  .contact-body .label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-body .val {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .contact-body a.val:hover {
    color: var(--color-primary-light);
  }

  .policy-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .policy-list li strong {
    color: var(--color-primary-light);
    display: block;
    margin-bottom: 0.15rem;
  }

  .success-message {
    padding: 1rem;
    background: rgba(124, 184, 122, 0.15);
    border: 1px solid var(--color-success);
    color: var(--color-success);
    border-radius: var(--radius-sm);
    text-align: center;
    font-weight: 500;
    margin-top: 1rem;
  }
</style>

<script>
  function initContactForm() {
    // Fill query param product name if exists
    const urlParams = new URLSearchParams(window.location.search);
    const targetProduct = urlParams.get('product');
    const productInput = document.getElementById('productSelect') as HTMLInputElement;

    if (targetProduct && productInput) {
      productInput.value = targetProduct;
    }

    const siteKey = '6LfauEktAAAAAMqxmIliI2O9cby28DZr-cQyhLid';
    const loadRecaptcha = () => {
      return new Promise<any>((resolve) => {
        if ((window as any).grecaptcha) {
          (window as any).grecaptcha.ready(() => resolve((window as any).grecaptcha));
          return;
        }
        const script = document.createElement('script');
        script.src = `https://www.recaptcha.net/recaptcha/api.js?render=${siteKey}`;
        script.async = true;
        script.onload = () => {
          if ((window as any).grecaptcha) {
            (window as any).grecaptcha.ready(() => resolve((window as any).grecaptcha));
          } else {
            resolve(null);
          }
        };
        script.onerror = () => resolve(null);
        document.head.appendChild(script);
      });
    };

    const form = document.getElementById('contact-full-form') as HTMLFormElement;
    const successMsg = document.getElementById('success-msg');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (form) {
      // Lazy load recaptcha on user focus
      form.addEventListener('focusin', () => loadRecaptcha(), { once: true });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending Request...';
        }

        const formData = new FormData(form);
        if (formData.get('b_website')) {
          console.warn('Bot submission detected via honeypot field.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send RFQ Inquiry';
          }
          return;
        }

        const submitData = async (token?: string) => {
          const data = {
            name: formData.get('name'),
            email: formData.get('email'),
            website: formData.get('website') || 'None',
            phone: formData.get('phone'),
            industry: formData.get('industry'),
            productName: formData.get('productName'),
            quantity: formData.get('quantity'),
            message: formData.get('message') || 'None',
            b_website: formData.get('b_website'),
            recaptchaToken: token || null,
          };

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });

            if (res.ok) {
              form.reset();
              if (successMsg) successMsg.style.display = 'block';
              if (submitBtn) submitBtn.textContent = 'Sent ✓';
              window.location.href = '/thank-you';
            } else {
              const errData = await res.json();
              alert(errData.error || 'Failed to submit form. Please check details or email us directly.');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send RFQ Inquiry';
              }
            }
          } catch (err) {
            alert('Connection error. Please try again.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send RFQ Inquiry';
            }
          }
        };

        try {
          const grecaptcha = await loadRecaptcha();
          if (grecaptcha) {
            grecaptcha.execute(siteKey, { action: 'submit_rfq' })
              .then((token: string) => submitData(token))
              .catch((err: any) => {
                console.error('reCAPTCHA execution failed:', err);
                submitData();
              });
          } else {
            submitData();
          }
        } catch (e) {
          submitData();
        }
      });
    }
  }

  // Astro page-load support
  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
