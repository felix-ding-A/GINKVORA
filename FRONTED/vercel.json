{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["hkg1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/media/images/:path*", "destination": "https://cdn.sanity.io/:path*" },
    { "source": "/media/files/:path*", "destination": "https://files.sanity.io/:path*" }
  ],
  "redirects": [
    { "source": "/blog/:path*", "destination": "/insights/:path*", "permanent": true },
    { "source": "/es/ru/:path*", "destination": "/ru/:path*", "permanent": true },
    { "source": "/ar/ru/:path*", "destination": "/ru/:path*", "permanent": true },
    { "source": "/ru/ru/:path*", "destination": "/ru/:path*", "permanent": true },
    { "source": "/es/ru", "destination": "/ru", "permanent": true },
    { "source": "/ar/ru", "destination": "/ru", "permanent": true },
    { "source": "/ru/ru", "destination": "/ru", "permanent": true },
    { "source": "/es/formulator", "destination": "/es/calculator", "permanent": true },
    { "source": "/ar/formulator", "destination": "/ar/calculator", "permanent": true },
    { "source": "/ru/formulator", "destination": "/ru/calculator", "permanent": true },
    { "source": "/es/ru/formulator", "destination": "/ru/calculator", "permanent": true },
    { "source": "/ar/ru/formulator", "destination": "/ru/calculator", "permanent": true },
    { "source": "/products/egcg", "destination": "/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/products/egcg-98", "destination": "/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/ru/products/egcg", "destination": "/ru/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/ru/products/egcg-98", "destination": "/ru/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/es/products/egcg", "destination": "/es/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/es/products/egcg-98", "destination": "/es/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/ar/products/egcg", "destination": "/ar/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/ar/products/egcg-98", "destination": "/ar/products/egcg-epigallocatechin-gallate", "permanent": true },
    { "source": "/products/nmn-beta-nicotinamide-mononucleotide", "destination": "/products/nmn-nicotinamide-mononucleotide", "permanent": true },
    { "source": "/ru/products/nmn-beta-nicotinamide-mononucleotide", "destination": "/ru/products/nmn-nicotinamide-mononucleotide", "permanent": true },
    { "source": "/es/products/nmn-beta-nicotinamide-mononucleotide", "destination": "/es/products/nmn-nicotinamide-mononucleotide", "permanent": true },
    { "source": "/ar/products/nmn-beta-nicotinamide-mononucleotide", "destination": "/ar/products/nmn-nicotinamide-mononucleotide", "permanent": true },
    { "source": "/products/copper-tripeptide-1-ghk-cu-hydrochloride", "destination": "/products/ghk-cu", "permanent": true },
    { "source": "/ru/products/copper-tripeptide-1-ghk-cu-hydrochloride", "destination": "/ru/products/ghk-cu", "permanent": true },
    { "source": "/es/products/copper-tripeptide-1-ghk-cu-hydrochloride", "destination": "/es/products/ghk-cu", "permanent": true },
    { "source": "/ar/products/copper-tripeptide-1-ghk-cu-hydrochloride", "destination": "/ar/products/ghk-cu", "permanent": true },
    { "source": "/insights/quercetin-senolytic-aging", "destination": "/insights", "permanent": true },

    { "source": "/Featured%20Formulas", "destination": "/featured-formulas", "permanent": true },
    { "source": "/ru/Featured%20Formulas", "destination": "/ru/featured-formulas", "permanent": true },
    { "source": "/es/Featured%20Formulas", "destination": "/es/featured-formulas", "permanent": true },
    { "source": "/ar/Featured%20Formulas", "destination": "/ar/featured-formulas", "permanent": true },
    { "source": "/Featured Formulas", "destination": "/featured-formulas", "permanent": true },
