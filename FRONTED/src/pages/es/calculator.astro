---
// src/pages/es/calculator.astro — Spanish Formulation Console page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulatorConsole from '../../components/calculators/FormulatorConsole.vue';
import { useTranslations } from '../../i18n/utils';
const lang = 'es';
const t = useTranslations(lang);

const siteUrl = 'https://ginkvora.com';

// WebPage schema
const formulatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Consola de Formulación Científica | GINKVORA",
  "description": "Calculadoras interactivas B2B gratuitas para molaridad química, diluciones en serie, masa molecular y formulaciones de cosméticos/suplementos.",
  "url": `${siteUrl}/es/calculator`,
  "isPartOf": { "@type": "WebSite", "url": siteUrl, "name": "GINKVORA" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${siteUrl}/es` },
      { "@type": "ListItem", "position": 2, "name": "Calculadora de formulación", "item": `${siteUrl}/es/calculator` }
    ]
  }
};

// SoftwareApplication schema (calculator tool)
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Consola de Formulación GINKVORA",
  "description": "Conjunto de herramientas profesionales de cálculo para científicos de laboratorio: cálculo de molaridad, diluciones en serie, masa molecular, equilibrio hidrófilo-lipófilo HLB, tamaños de cápsulas y formulación de suplementos.",
  "applicationCategory": "ScienceApplication",
  "operatingSystem": "Web Browser",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "url": `${siteUrl}/es/calculator`,
  "provider": { "@type": "Organization", "name": "GINKVORA", "url": siteUrl }
};

// FAQPage schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué es una solución madre en diluciones de laboratorio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una solución madre es una solución concentrada que se diluirá a una concentración menor para su uso real en el laboratorio. El uso de soluciones madre ahorra tiempo en la preparación, reduce el desperdicio de materiales y mejora la precisión al trabajar con microcomponentes."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo afectan los hidratos al cálculo del peso molecular?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los compuestos hidratados contienen moléculas de agua unidas químicamente en su estructura cristalina (por ejemplo, CuSO₄·5H₂O). Al pesar la sustancia química seca, el peso de las moléculas de agua debe incluirse en el cálculo del peso molecular para garantizar una dosificación molar precisa."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué es el HLB en las formulaciones cosméticas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "HLB significa equilibrio hidrófilo-lipófilo. Es un valor de 0 a 20 que indica la afinidad de un emulsionante por el agua (hidrófilo) o el aceite (lipófilo). Los emulsionantes con HLB bajo (3-6) forman emulsiones de agua en aceite (W/O), mientras que los emulsionantes con HLB alto (8-16) forman emulsiones de aceite en agua (O/W)."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo calcular la masa necesaria para una solución molar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para preparar una solución molar: Masa (g) = Concentración (M) × Volumen (L) × Peso Molecular (g/mol). Por ejemplo, para preparar 10 mL de una solución de vitamina C (PM=176.12) a una concentración de 50 mM: 0.05 mol/L × 0.01 L × 176.12 g/mol = 0.08806 g = 88.06 mg."
      }
    }
  ]
};
---
<BaseLayout lang={lang} title="Consola de Formulación Científica | GINKVORA" description="Herramientas profesionales para calcular molaridad, diluciones y formulaciones. Diseñadas para investigadores y especialistas en I+D.">
  <script type="application/ld+json" set:html={JSON.stringify(formulatorSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <main class="formulator-page bg-noise">
    <header class="page-banner">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">{t('formulator.label')}</span>
        <h1 class="banner-title">{t('formulator.title')}</h1>
        <p class="banner-desc">Herramientas de cálculo profesionales para especialistas en I+D e investigadores de formulación.</p>
      </div>
    </header>
    <div class="container formulator-layout">
      <FormulatorConsole client:only="vue" />
    </div>
  </main>
</BaseLayout>
<style>
  .formulator-page { padding-block: 0 var(--space-4xl); }
  .page-banner { position: relative; padding-block: 8rem 4rem; background: linear-gradient(135deg, #030201 0%, #0e1007 60%, #0a0703 100%); overflow: hidden; margin-bottom: var(--space-2xl); }
  .banner-gradient { position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(212,166,84,0.07) 0%, transparent 70%); }
  .banner-content { position: relative; z-index: 1; text-align: center; max-width: 700px; margin-inline: auto; }
  .banner-title { font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 700; line-height: 1.15; margin-bottom: 1rem; }
  .banner-desc { font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.75; }
  .formulator-layout { padding-bottom: var(--space-2xl); }
</style>
