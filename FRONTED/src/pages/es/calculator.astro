---
// src/pages/es/calculator.astro — Spanish Formulation Calculator page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulatorConsole from '../../components/calculators/FormulatorConsole.vue';

const lang = 'es';
const siteUrl = 'https://ginkvora.com';

// WebPage schema
const formulatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Calculadora de Formulación Científica y Laboratorio | GINKVORA",
  "description": "Herramienta de calculadora de laboratorio en línea gratuita: calcula molaridad química, diluciones en serie (C1V1), masa molecular y formulaciones.",
  "url": `${siteUrl}/es/calculator`,
  "isPartOf": { "@type": "WebSite", "url": siteUrl, "name": "GINKVORA" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${siteUrl}/es` },
      { "@type": "ListItem", "position": 2, "name": "Calculadora de laboratorio", "item": `${siteUrl}/es/calculator` }
    ]
  }
};

// SoftwareApplication schema (calculator tool)
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Calculadora de Formulación y Laboratorio GINKVORA",
  "description": "Herramienta de calculadora de laboratorio profesional gratuita: molaridad química, diluciones en serie (C1V1), masa molecular y escala de recetas.",
  "applicationCategory": "ScienceApplication",
  "operatingSystem": "Web Browser",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "url": `${siteUrl}/es/calculator`,
  "provider": { "@type": "Organization", "name": "GINKVORA", "url": siteUrl }
};

// FAQPage schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué es una solución madre en diluciones de laboratorio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Una solución madre es una solución concentrada que se diluirá a una concentración menor para su uso real en el laboratorio. El uso de soluciones madre ahorra tiempo en la preparación, reduce el desperdicio de materiales y mejora la precisión al trabajar con microcomponentes."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo afectan los hidratos al cálculo del peso molecular?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los compuestos hidratados contienen moléculas de agua unidas químicamente en su estructura cristalina (por ejemplo, CuSO₄·5H₂O). Al pesar la sustancia química seca, el peso de las moléculas de agua debe incluirse en el cálculo del peso molecular para garantizar una dosificación molar precisa."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué es el HLB en las formulaciones cosméticas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "HLB significa equilibrio hidrófilo-lipófilo. Es un valor de 0 a 20 que indica la afinidad de un emulsionante por el agua (hidrófilo) o el aceite (lipófilo). Los emulsionantes con HLB bajo (3-6) forman emulsiones de agua en aceite (W/O), mientras que los emulsionantes con HLB alto (8-16) forman emulsiones de aceite en agua (O/W)."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo calcular la masa necesaria para una solución molar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para preparar una solución molar: Masa (g) = Concentración (M) × Volumen (L) × Peso Molecular (g/mol). Por ejemplo, para preparar 10 mL de una solución de vitamina C (PM=176.12) a una concentración de 50 mM: 0.05 mol/L × 0.01 L × 176.12 g/mol = 0.08806 g = 88.06 mg."
      }
    }
  ]
};
---

<BaseLayout
  lang={lang}
  title="Calculadora de Formulación Científica y Laboratorio | GINKVORA"
  description="Herramienta gratuita para calcular molaridad química, diluciones C1V1, masa molecular y escala de formulaciones. Diseñada para investigadores y R&D."
>
  <link rel="alternate" hreflang="en" href={`${siteUrl}/calculator`} slot="head" />
  <link rel="alternate" hreflang="es" href={`${siteUrl}/es/calculator`} slot="head" />
  <link rel="alternate" hreflang="ru" href={`${siteUrl}/ru/calculator`} slot="head" />
  <link rel="alternate" hreflang="ar" href={`${siteUrl}/ar/calculator`} slot="head" />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}/calculator`} slot="head" />

  <script type="application/ld+json" set:html={JSON.stringify(formulatorSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="formulator-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <h1 class="banner-title">Calculadora de Formulación Científica y Laboratorio</h1>
      </div>
    </header>

    <!-- Main interactive formulator wrapper -->
    <section class="container section--sm">
      <FormulatorConsole client:idle />
    </section>

    <!-- Static Reference Guide & FAQ Section for SEO -->
    <section class="container section reference-section" aria-labelledby="reference-title">
      <div class="divider"></div>
      
      <div class="reference-header">
        <span class="section-label">Documentación y Referencia</span>
        <h2 id="reference-title" class="section-title">Guía de Referencia de Formulación y Calculadora</h2>
        <p class="section-desc">
          Especificaciones técnicas, ecuaciones matemáticas y procedimientos operativos estándar (SOP) utilizados en nuestras calculadoras.
        </p>
      </div>

      <div class="grid grid-2">
        <!-- Card 1 -->
        <div class="reference-card glass">
          <div class="card-icon-wrapper w-10 h-10 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 flex items-center justify-center text-[var(--color-primary-light)] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v7.31L4.75 18.15A2 2 0 0 0 6.46 21h11.08a2 2 0 0 0 1.71-2.85L14 9.31V2"/><line x1="8.5" y1="2" x2="15.5" y2="2"/></svg>
          </div>
          <h3 class="card-title">Cálculos de Molaridad y Porcentajes % w/w</h3>
          <p class="card-text">
            La molaridad (M) define la concentración de un soluto en solución expresada en moles por litro (mol/L).
          </p>
          <div class="equation-block font-mono text-sm">
            Masa (g) = Concentración (M) × Volumen (L) × Peso Molecular (g/mol)
          </div>
          <p class="card-text mt-3">
            El porcentaje en peso (% w/w) representa la masa del soluto dividida por la masa total de la fórmula, multiplicada por 100.
          </p>
          <div class="equation-block font-mono text-sm">
            % w/w = (Masa del Soluto / Masa Total de la Fórmula) × 100%
          </div>
        </div>

        <!-- Card 2 -->
        <div class="reference-card glass">
          <div class="card-icon-wrapper w-10 h-10 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 flex items-center justify-center text-[var(--color-primary-light)] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
          </div>
          <h3 class="card-title">Dilución y Escala (C₁V₁ = C₂V₂)</h3>
          <p class="card-text">
            La ecuación de dilución relaciona la concentración y el volumen de una solución madre con la concentración y volumen finales deseados.
          </p>
          <div class="equation-block font-mono text-sm">
            C₁ × V₁ = C₂ × V₂
          </div>
          <p class="card-text mt-3">
            Para preparar una dilución, calcule el volumen madre necesario (V₁ = (C₂ × V₂) / C₁), trasváselo y añada diluyente hasta alcanzar V₂.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="reference-card glass">
          <div class="card-icon-wrapper w-10 h-10 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 flex items-center justify-center text-[var(--color-primary-light)] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 21a9 9 0 0 0 9-9 9 9 0 0 0-9-9 9 9 0 0 0-9 9 9 9 0 0 0 9 9z"/><path d="M2 12h20"/></svg>
          </div>
          <h3 class="card-title">Analizador de Peso Molecular</h3>
          <p class="card-text">
            El peso molecular (PM) se calcula sumando las masas atómicas de todos los átomos de la fórmula química.
          </p>
          <div class="equation-block font-mono text-sm">
            Ejemplo: CuSO₄·5H₂O (Sulfato de Cobre Pentahidratado)
          </div>
          <p class="card-text mt-3">
            El sistema analiza símbolos químicos estándar IUPAC y resuelve la estequiometría dinámicamente.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="reference-card glass">
          <div class="card-icon-wrapper w-10 h-10 rounded-xl bg-[var(--color-primary-glow)] border border-[var(--color-primary)]/30 flex items-center justify-center text-[var(--color-primary-light)] shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="card-title">Equilibrio HLB y Cinética de Emulsión</h3>
          <p class="card-text">
            El equilibrio hidrófilo-lipófilo (HLB) mide el grado de afinidad por agua o aceite de un surfactante.
          </p>
          <div class="equation-block font-mono text-sm">
            Emulsionante A% = (rHLB - HLB_B) / (HLB_A - HLB_B) × 100%
          </div>
          <p class="card-text mt-3">
            Permite balancear la fase oleosa para estabilidad óptima de lociones y cremas cosméticas.
          </p>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="faq-container mt-5">
        <h3 class="faq-section-title">Preguntas Frecuentes</h3>
        
        <div class="faq-item">
          <h4 class="faq-question">¿Qué es una solución madre en diluciones de laboratorio?</h4>
          <p class="faq-answer">
            Una solución madre es una solución concentrada que se diluirá a una concentración menor para su uso real en el laboratorio. El uso de soluciones madre ahorra tiempo en la preparación y mejora la precisión.
          </p>
        </div>

        <div class="faq-item">
          <h4 class="faq-question">¿Cómo afectan los hidratos al cálculo del peso molecular?</h4>
          <p class="faq-answer">
            Los compuestos hidratados contienen moléculas de agua unidas químicamente. Al pesar la sustancia química seca, el peso de las moléculas de agua debe incluirse en el cálculo del peso molecular.
          </p>
        </div>

        <div class="faq-item">
          <h4 class="faq-question">¿Qué es el HLB en las formulaciones cosméticas?</h4>
          <p class="faq-answer">
            HLB significa equilibrio hidrófilo-lipófilo. Es un valor de 0 a 20 que indica la afinidad de un emulsionante por el agua (hidrófilo) o el aceite (lipófilo).
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .formulator-page {
    padding-bottom: var(--space-4xl);
  }

  .page-banner {
    position: relative;
    padding-block: 3.5rem 1.25rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0e1007 60%, #0a0703 100%);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-xl);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(212,166,84,0.07) 0%, transparent 70%);
  }

  .banner-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
  }

  .banner-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
  }

  /* ── Reference Section ── */
  .reference-section {
    margin-top: var(--space-xl);
  }

  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border-strong), transparent);
    margin-bottom: var(--space-xl);
  }

  .reference-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .reference-card {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .reference-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-strong);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: var(--space-xs);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary-light);
  }

  .card-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .equation-block {
    background: rgba(0, 0, 0, 0.4);
    border-left: 2px solid var(--color-primary);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    color: var(--color-primary-light);
    font-size: 0.875rem;
    overflow-x: auto;
  }

  /* ── FAQ Section ── */
  .faq-container {
    margin-top: var(--space-3xl);
    max-width: 800px;
    margin-inline: auto;
  }

  .faq-section-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: var(--space-xl);
    color: var(--color-text);
  }

  .faq-item {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary-light);
    margin-bottom: var(--space-sm);
  }

  .faq-answer {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
