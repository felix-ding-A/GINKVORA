---
// src/pages/ru/about/mission.astro — Our Mission B2B Page (Russian)
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'ru';

const missionSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Наша миссия | GINKVORA",
  "description": "Узнайте о миссии GINKVORA, экологически чистых источниках сырья, строгих стандартах аудита качества и слиянии природы и науки.",
  "url": "https://ginkvora.com/ru/about/mission"
};
---

<BaseLayout
  lang={lang}
  title="Наша миссия и ценности поставок | GINKVORA"
  description="Узнайте о миссии GINKVORA, экологически чистых источниках сырья из биоразнообразных регионов и строгих стандартах аудита качества."
>
  <script type="application/ld+json" set:html={JSON.stringify(missionSchema)} slot="head" />
  <main class="mission-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">Наша миссия</span>
        <h1 class="banner-title">Сочетание чистоты природы с научными инновациями</h1>
        <p class="banner-desc">
          Где вековая мудрость аутентичных растений встречается с современной точностью лабораторий.
        </p>
      </div>
    </header>

    <!-- Section 1: From the Heart of Qinling -->
    <section class="container section intro-section" aria-label="Our Sourcing Origins">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <span class="accent-title">Истоки качества</span>
          <h2>Из самого сердца биоразнообразных регионов</h2>
          <p>
            С 2023 года GINKVORA стремится сократить разрыв между премиальным растительным сырьем и мировым рынком B2B. Наш путь начинается в ключевых биоразнообразных экосистемах, включая горы Циньлин, известные как «Банк генов» дикой флоры, и региональные базы выращивания в Сиане.
          </p>
          <p>
            Мы создали строгую сеть поставок, гарантируя, что каждый поставляемый нами растительный экстракт получает пользу от идеального климата, высоты над уровнем моря и почвенных условий, необходимых для максимальной эффективности активных компонентов.
          </p>
        </div>
        <div class="intro-right reveal">
          <div class="image-showcase glass">
            <img
              src="/images/qinling-mountains-natural-ingredient-source.webp"
              alt="Хребет Циньлин - Источник натуральных ингредиентов"
              class="showcase-img"
              width="800"
              height="600"
            />
            <div class="floating-caption">
              <strong>Горный хребет Циньлин</strong>
              <span>Зона подлинных географических поставок</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Curators & Scientific Fusion -->
    <section class="section curation-section bg-deep" aria-label="Curators & Technical Fusion">
      <div class="container">
        <div class="grid-2">
          <div class="glass-card reveal">
            <span class="card-icon-em">🔍</span>
            <h3>Больше чем поставщик: Мы — кураторы</h3>
            <p>
              Мы позиционируем себя как партнер, ориентированный на инновации, а не просто как трейдер. Мы понимаем, что качество начинается у источника. Вот почему мы не просто покупаем и продаем; мы проверяем, проводим аудит и интегрируем. Мы сотрудничаем исключительно с производителями, отвечающими самым строгим стандартам cGMP и ISO, применяя строгий 4-этапный аудит.
            </p>
          </div>
          
          <div class="glass-card reveal reveal-delay-1">
            <span class="card-icon-em">🧪</span>
            <h3>Слияние биологии и природы</h3>
            <p>
              Название GINKVORA отражает нашу философию: Гинкго (Ginkgo) символизирует природную жизнестойкость, а Вора (Vora) — яркую научную инновацию. Помимо наших ботанических корней, мы поставляем высокочистые биоактивные мономеры. Объединяя традиционную фитотерапию с современной синтетической биологией, мы предлагаем комплексные решения в области ингредиентов.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Core Values -->
    <section class="container section values-section" aria-label="Core Values">
      <div class="section-header">
        <span class="section-label">Наши ценности</span>
        <h2 class="section-title">Столпы наших обязательств</h2>
        <p class="section-desc">Мы строим доверие посредством прозрачности, строгой верификации и индивидуальных решений по поставкам.</p>
      </div>

      <div class="grid-3">
        <article class="value-card glass reveal">
          <div class="value-icon">🌍</div>
          <h3>Подлинное происхождение сырья</h3>
          <p>Использование нашего стратегического расположения для обеспечения сырьем с наибольшим содержанием активных веществ из проверенных природных мест произрастания.</p>
        </article>

        <article class="value-card glass reveal reveal-delay-1">
          <div class="value-icon">🛡️</div>
          <h3>Строгий аудит</h3>
          <p>Мы обеспечиваем строгий 4-этапный процесс аудита для наших партнеров, подтверждая соответствие мировым стандартам (GMP/ISO) и чистоту сырья.</p>
        </article>

        <article class="value-card glass reveal reveal-delay-2">
          <div class="value-icon">⚙️</div>
          <h3>Кастомные инновации</h3>
          <p>От стандартизированных экстрактов до индивидуального синтеза пептидов и OEM-рецептур — мы адаптируем нашу цепочку поставок под ваши требования R&D.</p>
        </article>

        <article class="value-card glass reveal">
          <div class="value-icon">🌿</div>
          <h3>Этичный сорсинг</h3>
          <p>Наши обязательства по этичному выбору поставщиков гарантируют, что каждый ингредиент собирается с уважением к окружающей среде и сообществам, которые их выращивают.</p>
        </article>

        <article class="value-card glass reveal reveal-delay-1">
          <div class="value-icon">🔋</div>
          <h3>Экологичное производство</h3>
          <p>Мы применяем экологически чистые производственные процессы, чтобы свести к минимуму отходы и снизить углеродный след.</p>
        </article>

        <article class="value-card glass reveal reveal-delay-2">
          <div class="value-icon">🤝</div>
          <h3>Поддержка сообществ</h3>
          <p>Поддержка местных фермеров и сообществ лежит в основе нашей миссии в области устойчивого развития.</p>
        </article>
      </div>
    </section>

    <!-- Section 4: Экология и Социальная Ответственность -->
    <section class="section sustainability-section bg-deep" aria-label="Устойчивое развитие">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Экология</span>
          <h2 class="section-title">Сохранение природы для будущих поколений</h2>
          <p class="section-desc">Наши сегодняшние действия формируют ландшафт завтрашнего дня. Мы стремимся к тому, чтобы наша деятельность не наносила вреда окружающей среде.</p>
        </div>

        <!-- Lucid Waters Quote -->
        <div class="slogan-container glass reveal">
          <div class="slogan-quote">«Чистые воды и зеленые горы — это бесценное достояние.»</div>
          <div class="slogan-source">
            <span>Орган перевода: Центральное бюро компиляции и перевода</span>
            <span class="source-sep">|</span>
            <span>Источник: Газета «Гуанмин жибао» (19 ноября 2015 г.)</span>
          </div>
        </div>



        <!-- Slogans/End Quote -->
        <div class="quote-footer reveal">
          <p>
            «Устойчивое развитие — это не просто цель, а обязанность, которой мы обязаны предкам, сохранившим эти горы, и детям, которые их унаследуют.»
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="container section cta-section">
      <div class="cta-box glass">
        <h2>Партнерство с GINKVORA</h2>
        <p>Запросите документацию, сертификаты анализа (COA) или образцы для любого активного растительного компонента напрямую в нашем коммерческом отделе.</p>
        <div class="cta-btns">
          <a href="/ru/contact" class="btn btn--gold btn--lg">Запросить КП / образец</a>
          <a href="/ru/products" class="btn btn--primary btn--lg">Каталог продуктов</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .mission-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 8rem 4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Intro Section ── */
  .section {
    padding-block: var(--space-2xl);
  }

  .accent-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .intro-left h2 {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
  }

  .intro-left p {
    margin-bottom: 1.25rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .image-showcase {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-color: rgba(212,166,84,0.18) !important;
    cursor: pointer;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow, 400ms) ease;
  }

  .image-showcase:hover .showcase-img {
    transform: scale(1.05);
  }

  .floating-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(6, 5, 3, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .floating-caption strong {
    color: var(--color-primary-light);
    font-size: 0.875rem;
  }

  .floating-caption span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  /* ── Curation Section ── */
  .bg-deep {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }

  .glass-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
    transition: all var(--transition-base);
  }

  .glass-card:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: var(--shadow-glow-gold);
  }

  .card-icon-em {
    font-size: 2.25rem;
    display: block;
    margin-bottom: 1rem;
  }

  .glass-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .glass-card p {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  /* ── Values Section ── */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .section-desc {
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0.75rem auto 0;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }

  .value-card {
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
    text-align: center;
    transition: all var(--transition-base);
  }

  .value-card:hover {
    border-color: var(--color-primary-light) !important;
    box-shadow: var(--shadow-glow-gold);
    transform: translateY(-6px);
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .value-card p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ── CTA Box ── */
  .cta-box {
    padding: 3.5rem;
    border-radius: var(--radius-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid rgba(212, 166, 84, 0.2) !important;
  }

  .cta-box h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-family: var(--font-display);
    color: var(--color-text);
  }

  .cta-box p {
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.75;
  }

  .cta-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ── Sustainability Section ── */
  .sustainability-section {
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg-deep, #060708);
  }

  .sustainability-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: linear-gradient(to bottom, #060708 0%, rgba(6, 7, 8, 0.03) 15%, rgba(6, 7, 8, 0.03) 85%, #060708 100%), url('/images/qinling-mountains-traditional-chinese-shanshui-painting.webp');
    background-size: cover;
    background-position: center 30%;
    background-repeat: no-repeat;
    /* High brightness so the Shanshui painting is clearly visible, but slightly softened to protect contrast */
    filter: brightness(0.78) contrast(1.02) saturate(0.95);
    z-index: 1;
    pointer-events: none;
  }

  .sustainability-section .container {
    position: relative;
    z-index: 2;
  }

  .sustainability-section .section-label {
    color: #ffffff !important;
  }

  .sustainability-section .section-title {
    color: #000000 !important;
  }

  .sustainability-section .section-desc {
    color: #222222 !important;
  }

  @media (max-width: 768px) {
    .sustainability-section::before {
      background-image: linear-gradient(to bottom, #060708 0%, rgba(6, 7, 8, 0.05) 15%, rgba(6, 7, 8, 0.05) 85%, #060708 100%), url('/images/qinling-mountains-traditional-chinese-shanshui-painting.webp');
      background-position: center 20%;
    }
  }

  .slogan-container {
    max-width: 800px;
    margin: 0 auto 3rem;
    padding: 2rem 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 0, 0, 0.15) !important;
    text-align: center;
    background: rgba(255, 255, 255, 0.75) !important;
    backdrop-filter: blur(10px);
    transition: all var(--transition-base, 250ms) ease;
  }

  .slogan-container:hover {
    border-color: rgba(0, 0, 0, 0.3) !important;
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .slogan-quote {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--color-accent-dark, #b05818);
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .slogan-source {
    font-size: 0.75rem;
    color: #000000 !important;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    opacity: 1 !important;
  }

  .source-sep {
    color: #000000 !important;
  }



  .quote-footer {
    max-width: 680px;
    margin: 3.5rem auto 0;
    text-align: center;
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }

  .quote-footer p {
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
</style>
