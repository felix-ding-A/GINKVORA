---

<section class="ingredients-section section" id="key-ingredients">
  <div class="container">
    <!-- Header with controls -->
    <div class="section-header-wrap reveal">
      <div class="section-header">
        <span class="section-label">{t('featured.label')}</span>
        <h2 class="section-title">
          {t('featured.title_1')}<br/>
          <span class="gradient-text">{t('featured.title_2')}</span>
        </h2>
        <p class="section-desc">
          {t('featured.desc')}
        </p>
      </div>

      <!-- Carousel arrows -->
      <div class="carousel-controls">
        <button id="ing-prev" class="carousel-control-btn" aria-label="Previous ingredients" title="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button id="ing-next" class="carousel-control-btn" aria-label="Next ingredients" title="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel track wrap -->
    <div class="ingredients-carousel-wrapper reveal">
      <div class="ingredients-carousel-track" id="ingredients-track" tabindex="0" aria-label="Featured ingredients carousel">
        {ingredients.map((ing) => {
          const fullName = lang === 'ar' ? (ing.fullName_ar || ing.fullName) : (lang === 'ru' ? (ing.fullName_ru || ing.fullName) : (lang === 'es' ? (ing.fullName_es || ing.fullName) : ing.fullName));
          const category = lang === 'ar' ? (ing.category_ar || ing.category) : (lang === 'ru' ? (ing.category_ru || ing.category) : (lang === 'es' ? (ing.category_es || ing.category) : ing.category));
          const description = lang === 'ar' ? (ing.description_ar || ing.description) : (lang === 'ru' ? (ing.description_ru || ing.description) : (lang === 'es' ? (ing.description_es || ing.description) : ing.description));
          const benefits = lang === 'ar' ? (ing.benefits_ar || ing.benefits) : (lang === 'ru' ? (ing.benefits_ru || ing.benefits) : (lang === 'es' ? (ing.benefits_es || ing.benefits) : ing.benefits));
          const cardId = `ingredient-${ing.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`;

          return (
            <a
              href={lp(`/products/${ing.slug}`)}
              class="ingredient-card glass"
              style={`--ing-color: ${ing.color};`}
              id={cardId}
              aria-label={`${ing.name} — ${fullName}`}
            >
              <!-- Top accent line -->
              <div class="card-accent-line"></div>

              <!-- Header -->
              <div class="card-header">
                <div class="card-name-group">
                  <h3 class="card-name">{ing.name}</h3>
                  <span class="card-full-name">{fullName}</span>
                </div>
                <span class="card-category">{category}</span>
              </div>

              <!-- Purity indicator -->
              <div class="card-purity">
                <span class="purity-label">{t('products.purity_label')}</span>
                <div class="purity-bar-wrap">
                  <div class="purity-bar" style={`--purity: ${parseInt(ing.purity) / 100};`}></div>
                </div>
                <span class="purity-number">{ing.purity}</span>
              </div>

              <!-- Description -->
              <p class="card-desc">{description}</p>

              <!-- Benefits tags -->
              <div class="card-benefits">
                {benefits.map((b) => (
                  <span class="benefit-tag">{b}</span>
                ))}
              </div>

              <!-- Link -->
              <div class="card-link">
                {t('products.view_details')}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Pagination Dots -->
    <div class="carousel-dots reveal" id="ingredients-dots" aria-label="Ingredients pagination">
      {ingredients.map((ing, idx) => (
        <button
          type="button"
          class={`carousel-dot ${idx === 0 ? 'active' : ''}`}
          data-index={idx}
          aria-label={`Go to ${ing.name}`}
        ></button>
      ))}
    </div>

    <div class="ingredients-cta reveal">
      <a href={lp('/products')} class="btn btn--primary" id="view-all-ingredients-btn">
        {t('featured.cta')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  function initCarousel() {
    const track = document.getElementById('ingredients-track');
    const prevBtn = document.getElementById('ing-prev');
    const nextBtn = document.getElementById('ing-next');
    const dotsContainer = document.getElementById('ingredients-dots');

    if (!track || !prevBtn || !nextBtn || !dotsContainer) return;

    const dots = Array.from(dotsContainer.querySelectorAll('.carousel-dot'));
    if (dots.length === 0) return;

    function getStep() {
      const firstCard = track.querySelector('.ingredient-card');
      const cardWidth = firstCard ? firstCard.getBoundingClientRect().width : 300;
      const gap = parseFloat(getComputedStyle(track).gap) || 24;
      return cardWidth + gap;
    }

    function updateActiveDot() {
      const step = getStep();
      if (step <= 0) return;

      const scrollLeft = track.scrollLeft;
      const maxScroll = track.scrollWidth - track.clientWidth;

      let activeIndex = 0;
      if (maxScroll > 0 && scrollLeft >= maxScroll - 20) {
        activeIndex = dots.length - 1;
      } else {
        activeIndex = Math.min(dots.length - 1, Math.max(0, Math.round(scrollLeft / step)));
      }

      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    // Prev / Next button actions (1 card step per click for 1:1 rhythm)
    prevBtn.onclick = (e) => {
      e.preventDefault();
      const step = getStep();
      const maxScroll = track.scrollWidth - track.clientWidth;

      if (track.scrollLeft <= 15) {
        // Wrap to the end
        track.scrollTo({ left: maxScroll, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: -step, behavior: 'smooth' });
      }
    };

    nextBtn.onclick = (e) => {
      e.preventDefault();
      const step = getStep();
      const maxScroll = track.scrollWidth - track.clientWidth;

      if (track.scrollLeft >= maxScroll - 15) {
        // Loop back to start
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: step, behavior: 'smooth' });
      }
    };

    // Dot click actions
    dots.forEach((dot) => {
      dot.onclick = (e) => {
        e.preventDefault();
        const index = parseInt(dot.getAttribute('data-index') || '0', 10);
        const step = getStep();
        const maxScroll = track.scrollWidth - track.clientWidth;

        let targetScroll = index * step;
        if (index === dots.length - 1) {
          targetScroll = maxScroll;
        } else {
          targetScroll = Math.min(maxScroll, targetScroll);
        }

        track.scrollTo({ left: targetScroll, behavior: 'smooth' });

        dots.forEach((d, idx) => {
          if (idx === index) d.classList.add('active');
          else d.classList.remove('active');
        });
      };
    });

    // Keyboard navigation
    track.onkeydown = (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevBtn.click();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextBtn.click();
      }
    };

    // Mouse drag scrolling with threshold
    let isMouseDown = false;
    let startX = 0;
    let initialScrollLeft = 0;
    let hasDragged = false;

    track.onmousedown = (e) => {
      if (e.button !== 0) return;
      isMouseDown = true;
      hasDragged = false;
      startX = e.pageX - track.offsetLeft;
      initialScrollLeft = track.scrollLeft;
      track.classList.add('is-dragging');
    };

    window.addEventListener('mouseup', () => {
      if (!isMouseDown) return;
      isMouseDown = false;
      track.classList.remove('is-dragging');
    });

    track.onmousemove = (e) => {
      if (!isMouseDown) return;
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX);
      if (Math.abs(walk) > 6) {
        hasDragged = true;
        track.scrollLeft = initialScrollLeft - walk;
      }
    };

    track.addEventListener('click', (e) => {
      if (hasDragged) {
        e.preventDefault();
        e.stopPropagation();
        hasDragged = false;
      }
    }, true);

    // Scroll listener for dot updates
    track.addEventListener('scroll', updateActiveDot, { passive: true });

    // Initial dot status
    updateActiveDot();
  }

  // Run on load and after client navigation (Astro ClientRouter compatibility)
  document.addEventListener('astro:page-load', initCarousel);
  initCarousel();
</script>

<style>
  .section-header-wrap {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
  }

  .section-header {
    max-width: 800px;
  }

  .carousel-controls {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1rem;
    flex-shrink: 0;
  }

  .carousel-control-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.3s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .carousel-control-btn:hover {
    border-color: rgba(212, 166, 84, 0.5);
    color: var(--color-text);
    background: var(--color-surface);
    transform: scale(1.05);
  }

  .carousel-control-btn:active {
    transform: scale(0.95);
  }

  .ingredients-carousel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .ingredients-carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
