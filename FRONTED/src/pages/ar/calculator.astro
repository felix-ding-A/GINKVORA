---
// src/pages/ar/calculator.astro — Arabic Formulation Calculator page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulatorConsole from '../../components/calculators/FormulatorConsole.vue';

const lang = 'ar';
const siteUrl = 'https://ginkvora.com';

// WebPage schema
const formulatorSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "حاسبة التركيبات العلمية والمختبرية | GINKVORA",
  "description": "أداة حاسبة تفاعلية مجانية للمختبرات: حل الموولارية، وتخطيط التخفيف المتسلسل C1V1، وتحليل الوزن الجزيئي، وحساب التركيبات.",
  "url": `${siteUrl}/ar/calculator`,
  "isPartOf": { "@type": "WebSite", "url": siteUrl, "name": "GINKVORA" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": `${siteUrl}/ar` },
      { "@type": "ListItem", "position": 2, "name": "حاسبة التركيبات والمختبرات", "item": `${siteUrl}/ar/calculator` }
    ]
  }
};

// SoftwareApplication schema (calculator tool)
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "حاسبة التركيبات والمختبرات GINKVORA",
  "description": "أداة حاسبة علمية مجانية عبر الإنترنت للعلماء والمختبرات — تغطي الموولارية، والتخفيف المتسلسل C1V1، وتحليل الوزن الجزيئي، وموازنة التركيبات.",
  "applicationCategory": "ScienceApplication",
  "operatingSystem": "Web Browser",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "url": `${siteUrl}/ar/calculator`,
  "provider": { "@type": "Organization", "name": "GINKVORA", "url": siteUrl }
};

// FAQPage schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "ما هو المحلول القياسي في التخفيف المختبري؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "المحلول القياسي (المحلول الأم) هو محلول مركز يتم تخفيفه إلى تركيز أقل للاستخدام الفعلي في المختبر. يوفر استخدام المحاليل القياسية وقت التحضير، ويقلل من هدر المواد، ويحسن الدقة بالنسبة للمكونات النزرة."
      }
    },
    {
      "@type": "Question",
      "name": "كيف تؤثر الهيدرات على حسابات الوزن الجزيئي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تحتوي المركبات المهدرجة على جزيئات ماء مرتبطة كيميائياً داخل بنيتها البلورية (مثل كبريتات النحاس خماسية الماء CuSO₄·5H₂O). عند وزن المادة الكيميائية الجافة، يجب تضمين وزن جزيئات الماء في حساب الوزن الجزيئي لضمان دقة الجرعات المولية."
      }
    },
    {
      "@type": "Question",
      "name": "ما هو HLB في تركيبات مستحضرات التجميل؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "يرمز HLB إلى التوازن المحب للماء والمحب للدهن. وهي قيمة تتراوح بين 0 و20 تشير إلى ألفة المستحلب للماء (محب للماء) أو الزيت (محب للدهن). تنتج المستحلبات ذات قيمة HLB المنخفضة (3-6) مستحلبات ماء في زيت (W/O)، بينما تنتج قيم HLB العالية (8-16) مستحلبات زيت في ماء (O/W)."
      }
    },
    {
      "@type": "Question",
      "name": "كيف يمكنني حساب الكتلة اللازمة لتحضير محلول مولي؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "لتحضير محلول مولي: الكتلة (جرام) = التركيز (M) × الحجم (لتر) × الوزن الجزيئي (جرام/مول). على سبيل المثال، لتحضير 10 مل من محلول فيتامين سي بتركيز 50 ملي مولار (الوزن الجزيئي = 176.12): 0.05 مول/لتر × 0.01 لتر × 176.12 جرام/مول = 0.08806 جرام = 88.06 ملي جرام."
      }
    }
  ]
};
---

<BaseLayout
  lang={lang}
  title="حاسبة التركيبات العلمية والمختبرية | GINKVORA"
  description="أداة حاسبة تفاعلية مجانية للمختبرات: حل الموولارية، وتخطيط التخفيف المتسلسل C1V1، وتحليل الوزن الجزيئي، وحساب مستحلبات HLB والتركيبات."
>
  <link rel="alternate" hreflang="en" href={`${siteUrl}/calculator`} slot="head" />
  <link rel="alternate" hreflang="es" href={`${siteUrl}/es/calculator`} slot="head" />
  <link rel="alternate" hreflang="ru" href={`${siteUrl}/ru/calculator`} slot="head" />
  <link rel="alternate" hreflang="ar" href={`${siteUrl}/ar/calculator`} slot="head" />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}/calculator`} slot="head" />

  <script type="application/ld+json" set:html={JSON.stringify(formulatorSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="formulator-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="ترويسة الصفحة">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <h1 class="banner-title">حاسبة التركيبات العلمية والمختبرية</h1>
      </div>
    </header>

    <!-- Main interactive formulator wrapper -->
    <section class="container section--sm">
      <FormulatorConsole client:idle />
    </section>

    <!-- Static Reference Guide & FAQ Section for SEO -->
    <section class="container section reference-section" aria-labelledby="reference-title">
      <div class="divider"></div>
      
      <div class="reference-header">
        <span class="section-label">التوثيق والمراجع</span>
        <h2 id="reference-title" class="section-title">دليل مرجعي لحاسبة التركيبات والمختبرات</h2>
        <p class="section-desc">
          المواصفات الفنية والمعادلات الرياضية وإجراءات التشغيل القياسية (SOP) المستخدمة في حاسباتنا.
        </p>
      </div>

      <div class="grid grid-2">
        <!-- Card 1 -->
        <div class="reference-card glass">
          <div class="card-icon">🧪</div>
          <h3 class="card-title">حسابات الموولارية والنسب المئوية % w/w</h3>
          <p class="card-text">
            تحدد الموولارية (M) تركيز المذاب في المحلول مقاساً بالمول لكل لتر (مول/لتر).
          </p>
          <div class="equation-block font-mono text-sm">
            الكتلة (جرام) = التركيز (M) × الحجم (لتر) × الوزن الجزيئي (جرام/مول)
          </div>
          <p class="card-text mt-3">
            تمثل النسبة المئوية بالوزن (% w/w) كتلة المذاب مقسومة على الكتلة الإجمالية للتركيبة، مضروبة في 100.
          </p>
          <div class="equation-block font-mono text-sm">
            % w/w = (كتلة المذاب / كتلة التركيبة الإجمالية) × 100%
          </div>
        </div>

        <!-- Card 2 -->
        <div class="reference-card glass">
          <div class="card-icon">💧</div>
          <h3 class="card-title">التخفيف وموازنة الحجم (C₁V₁ = C₂V₂)</h3>
          <p class="card-text">
            تربط معادلة التخفيف بين تركيز وحجم المحلول القياسي مع التركيز والحجم النهائيين المطلوبين.
          </p>
          <div class="equation-block font-mono text-sm">
            C₁ × V₁ = C₂ × V₂
          </div>
          <p class="card-text mt-3">
            لتحضير التخفيف، احسب حجم المحلول الأم المطلوب (V₁ = (C₂ × V₂) / C₁)، وانقله ثم أضف المذيب حتى الوصول إلى V₂.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="reference-card glass">
          <div class="card-icon">🧬</div>
          <h3 class="card-title">محلل الوزن الجزيئي</h3>
          <p class="card-text">
            يتم حساب الوزن الجزيئي (MW) عن طريق جمع الكتل الذرية لجميع الذرات المكونة في الصيغة الكيميائية.
          </p>
          <div class="equation-block font-mono text-sm">
            مثال: CuSO₄·5H₂O (كبريتات النحاس خماسية الماء)
          </div>
          <p class="card-text mt-3">
            يطابق النظام الرموز الكيميائية القياسية IUPAC ويحل تكافؤ الهيدرات ديناميكياً.
          </p>
        </div>

        <!-- Card 4 -->
        <div class="reference-card glass">
          <div class="card-icon">⚖️</div>
          <h3 class="card-title">توازن HLB وحركية المستحلبات</h3>
          <p class="card-text">
            يقيس التوازن المحب للماء والمحب للدهن (HLB) درجة ألفة الخافض للتوتر السطحي للماء أو الزيت.
          </p>
          <div class="equation-block font-mono text-sm">
            نسبة المستحلب أ% = (rHLB - HLB_ب) / (HLB_أ - HLB_ب) × 100%
          </div>
          <p class="card-text mt-3">
            يتيح موازنة الطور الزيتي للحصول على استقرار مثالي للسيورمات والكريمات التجميلية.
          </p>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="faq-container mt-5">
        <h3 class="faq-section-title">الأسئلة الشائعة</h3>
        
        <div class="faq-item">
          <h4 class="faq-question">ما هو المحلول القياسي في التخفيف المختبري؟</h4>
          <p class="faq-answer">
            المحلول القياسي هو محلول مركز يتم تخفيفه إلى تركيز أقل للاستخدام الفعلي في المختبر. توفر المحاليل القياسية وقت التحضير وتزيد الدقة.
          </p>
        </div>

        <div class="faq-item">
          <h4 class="faq-question">كيف تؤثر الهيدرات على حسابات الوزن الجزيئي؟</h4>
          <p class="faq-answer">
            تحتوي المركبات المهدرجة على جزيئات ماء مرتبطة كيميائياً. عند وزن المادة الجافة، يجب تضمين وزن جزيئات الماء في الحساب.
          </p>
        </div>

        <div class="faq-item">
          <h4 class="faq-question">ما هو HLB في تركيبات مستحضرات التجميل؟</h4>
          <p class="faq-answer">
            يرمز HLB إلى التوازن المحب للماء والمحب للدهن. وهي قيمة تتراوح بين 0 و20 تشير إلى ألفة المستحلب للماء أو الزيت.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .formulator-page {
    padding-bottom: var(--space-4xl);
  }

  .page-banner {
    position: relative;
    padding-block: 3.5rem 1.25rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-xl);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
  }

  /* ── Reference Section ── */
  .reference-section {
    margin-top: var(--space-xl);
  }

  .divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border-strong), transparent);
    margin-bottom: var(--space-xl);
  }

  .reference-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }

  .reference-card {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .reference-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-strong);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: var(--space-xs);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary-light);
  }

  .card-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .equation-block {
    background: rgba(0, 0, 0, 0.4);
    border-left: 2px solid var(--color-primary);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    color: var(--color-primary-light);
    font-size: 0.875rem;
    overflow-x: auto;
  }

  /* ── FAQ Section ── */
  .faq-container {
    margin-top: var(--space-3xl);
    max-width: 800px;
    margin-inline: auto;
  }

  .faq-section-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: var(--space-xl);
    color: var(--color-text);
  }

  .faq-item {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary-light);
    margin-bottom: var(--space-sm);
  }

  .faq-answer {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
