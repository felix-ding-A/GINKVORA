---
// src/pages/ru/about/mission.astro — Our Mission B2B Page (Russian)
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';

const lang = 'ru';

const missionSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Наша миссия | GINKVORA",
  "description": "Узнайте о миссии GINKVORA, экологически чистых источниках сырья, строгих стандартах аудита качества и слиянии природы и науки.",
  "url": "https://ginkvora.com/ru/about/mission"
};
---

<BaseLayout
  lang={lang}
  title="Наша миссия и ценности поставок | GINKVORA"
  description="Узнайте о миссии GINKVORA, экологически чистых источниках сырья из биоразнообразных регионов и строгих стандартах аудита качества."
>
  <script type="application/ld+json" set:html={JSON.stringify(missionSchema)} slot="head" />
  <main class="mission-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">Наша миссия</span>
        <h1 class="banner-title">Сочетание чистоты природы с научными инновациями</h1>
        <p class="banner-desc">
          Где вековая мудрость аутентичных растений встречается с современной точностью лабораторий.
        </p>
      </div>
    </header>

    <!-- Section 1: From the Heart of Qinling -->
    <section class="container section intro-section" aria-label="Our Sourcing Origins">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <span class="accent-title">Истоки качества</span>
          <h2>Из самого сердца биоразнообразных регионов</h2>
          <p>
            С 2023 года GINKVORA стремится сократить разрыв между премиальным растительным сырьем и мировым рынком B2B. Наш путь начинается в ключевых биоразнообразных экосистемах, включая горы Циньлин, известные как «Банк генов» дикой флоры, и региональные базы выращивания в Сиане.
          </p>
          <p>
            Мы создали строгую сеть поставок, гарантируя, что каждый поставляемый нами растительный экстракт получает пользу от идеального климата, высоты над уровнем моря и почвенных условий, необходимых для максимальной эффективности активных компонентов.
          </p>
        </div>
        <div class="intro-right reveal">
          <div class="image-showcase glass">
            <img
              src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&auto=format&fit=crop&q=70"
              alt="Mountain Sourcing Origin"
              class="showcase-img"
            />
            <div class="floating-caption">
              <strong>Горный хребет Циньлин</strong>
              <span>Зона подлинных географических поставок</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Curators & Scientific Fusion -->
    <section class="section curation-section bg-deep" aria-label="Curators & Technical Fusion">
      <div class="container">
        <div class="grid-2">
          <div class="glass-card reveal">
            <span class="card-icon-em">🔍</span>
            <h3>Больше чем поставщик: Мы — кураторы</h3>
            <p>
              Мы позиционируем себя как партнер, ориентированный на инновации, а не просто как трейдер. Мы понимаем, что качество начинается у источника. Вот почему мы не просто покупаем и продаем; мы проверяем, проводим аудит и интегрируем. Мы сотрудничаем исключительно с производителями, отвечающими самым строгим стандартам cGMP и ISO, применяя строгий 4-этапный аудит.
            </p>
          </div>
          
          <div class="glass-card reveal reveal-delay-1">
            <span class="card-icon-em">🧪</span>
            <h3>Слияние биологии и природы</h3>
            <p>
              Название GINKVORA отражает нашу философию: Гинкго (Ginkgo) символизирует природную жизнестойкость, а Вора (Vora) — яркую научную инновацию. Помимо наших ботанических корней, мы поставляем высокочистые биоактивные мономеры. Объединяя традиционную фитотерапию с современной синтетической биологией, мы предлагаем комплексные решения в области ингредиентов.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Core Values -->
    <section class="container section values-section" aria-label="Core Values">
      <div class="section-header">
        <span class="section-label">Наши ценности</span>
        <h2 class="section-title">Столпы наших обязательств</h2>
        <p class="section-desc">Мы строим доверие посредством прозрачности, строгой верификации и индивидуальных решений по поставкам.</p>
      </div>

      <div class="grid-3">
        <article class="value-card glass reveal">
          <div class="value-icon">🌍</div>
          <h3>Подлинное происхождение сырья</h3>
          <p>Использование нашего стратегического расположения для обеспечения сырьем с наибольшим содержанием активных веществ из проверенных природных мест произрастания.</p>
        </article>

        <article class="value-card glass reveal reveal-delay-1">
          <div class="value-icon">🛡️</div>
          <h3>Строгий аудит</h3>
          <p>Мы обеспечиваем строгий 4-этапный процесс аудита для наших партнеров, подтверждая соответствие мировым стандартам (GMP/ISO) и чистоту сырья.</p>
        </article>

        <article class="value-card glass reveal reveal-delay-2">
          <div class="value-icon">⚙️</div>
          <h3>Кастомные инновации</h3>
          <p>От стандартизированных экстрактов до индивидуального синтеза пептидов и OEM-рецептур — мы адаптируем нашу цепочку поставок под ваши требования R&D.</p>
        </article>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="container section cta-section">
      <div class="cta-box glass">
        <h2>Партнерство с GINKVORA</h2>
        <p>Запросите документацию, сертификаты анализа (COA) или образцы для любого активного растительного компонента напрямую в нашем коммерческом отделе.</p>
        <div class="cta-btns">
          <a href="/ru/contact" class="btn btn--gold btn--lg">Запросить КП / образец</a>
          <a href="/ru/products" class="btn btn--primary btn--lg">Каталог продуктов</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .mission-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 8rem 4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Intro Section ── */
  .section {
    padding-block: var(--space-2xl);
  }

  .accent-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .intro-left h2 {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
  }

  .intro-left p {
    margin-bottom: 1.25rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .image-showcase {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-color: rgba(212,166,84,0.18) !important;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .floating-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(6, 5, 3, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .floating-caption strong {
    color: var(--color-primary-light);
    font-size: 0.875rem;
  }

  .floating-caption span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  /* ── Curation Section ── */
  .bg-deep {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr;
    }
  }

  .glass-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
    transition: all var(--transition-base);
  }

  .glass-card:hover {
    border-color: rgba(212, 166, 84, 0.25) !important;
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.03);
  }

  .card-icon-em {
    font-size: 2.25rem;
    display: block;
    margin-bottom: 1rem;
  }

  .glass-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .glass-card p {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  /* ── Values Section ── */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .section-desc {
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0.75rem auto 0;
  }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }

  .value-card {
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
    text-align: center;
    transition: all var(--transition-base);
  }

  .value-card:hover {
    border-color: var(--color-border-strong) !important;
    box-shadow: var(--shadow-glow-gold);
    transform: translateY(-4px);
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .value-card p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ── CTA Box ── */
  .cta-box {
    padding: 3.5rem;
    border-radius: var(--radius-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid rgba(212, 166, 84, 0.2) !important;
  }

  .cta-box h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-family: var(--font-display);
    color: var(--color-text);
  }

  .cta-box p {
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: 1.75;
  }

  .cta-btns {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
