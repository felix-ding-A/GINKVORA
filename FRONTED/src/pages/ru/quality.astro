---
// src/pages/ru/quality.astro — Russian Quality page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
const lang = 'ru';
const t = useTranslations(lang);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://ginkvora.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'Качество и сертификаты', item: 'https://ginkvora.com/ru/quality' },
  ],
};
---
<BaseLayout lang={lang} title="Качество и сертификаты GMP | GINKVORA" description="Стандарты качества GINKVORA: ВЭЖХ анализ чистоты, испытания GC-MS, сертификация ISO 9001, GMP, и соответствие REACH. Скачайте COA.">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  <main class="quality-page bg-noise">
    <header class="page-banner">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label fade-in-up">{t('quality.label')}</span>
        <h1 class="banner-title fade-in-up delay-1">{t('quality.title')}</h1>
        <p class="banner-desc fade-in-up delay-2">Обеспечение стабильной чистоты, надёжной документации и полного соответствия требованиям — для каждой партии.</p>
      </div>
    </header>
    <section class="container section lab-section" aria-label="Аналитические приборы">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <h2>Передовые лабораторные анализы и испытания</h2>
          <p>В GINKVORA мы считаем химическое тестирование основой доверия. Наш партнёрский центр исследований и разработок в Сиане оснащён высокопроизводительными аналитическими приборами для анализа чистоты активных компонентов и выявления примесей.</p>
          <div class="instrument-list">
            <div class="instrument-item"><span class="inst-icon">⚗️</span><div><strong>ВЭЖХ (высокоэффективная жидкостная хроматография)</strong><p>Обеспечивает точное количественное определение активных компонентов, например подтверждает содержание глабридина ≥40,0 % или лютеолина ≥98,0 %.</p></div></div>
            <div class="instrument-item"><span class="inst-icon">🧬</span><div><strong>ICP-MS (масс-спектрометрия с индуктивно связанной плазмой)</strong><p>Подтверждает соответствие строгим международным ограничениям по тяжёлым металлам: свинцу, мышьяку, кадмию и ртути.</p></div></div>
            <div class="instrument-item"><span class="inst-icon">🧪</span><div><strong>GC-MS (газовая хроматография-масс-спектрометрия)</strong><p>Оценивает летучие соединения и остатки пестицидов для соответствия строгим сельскохозяйственным ограничениям.</p></div></div>
          </div>
        </div>
        <div class="intro-right reveal reveal-delay-2"><div class="image-showcase glass"><img src="/images/ginkvora QC Laboratory.webp" alt="Лаборатория контроля качества GINKVORA" class="showcase-img" /></div></div>
      </div>
    </section>

    <section class="section certs-grid-section bg-deep" aria-label="Каталог сертификатов">
      <div class="container">
        <div class="section-header"><span class="section-label">Нормативное соответствие</span><h2 class="section-title">Международные сертификаты</h2><p class="section-desc">Производственные площадки партнёров GINKVORA соответствуют глобальным требованиям к пищевым и косметическим ингредиентам.</p></div>
        <div class="grid-4">
          <div class="cert-box glass reveal"><div class="cert-badge-icon">🛡️</div><h3>Соответствие GMP</h3><p>Наши ингредиенты производятся на площадках, соответствующих требованиям GMP, что обеспечивает контроль перекрёстного загрязнения.</p></div>
          <div class="cert-box glass reveal reveal-delay-1"><div class="cert-badge-icon">📜</div><h3>ISO 9001:2015</h3><p>Сертифицированные системы менеджмента качества охватывают все этапы — от приёмки сырья до упаковки и отгрузки.</p></div>
          <div class="cert-box glass reveal reveal-delay-2"><div class="cert-badge-icon">🕌</div><h3>Сертификация Halal</h3><p>Сертифицировано признанными исламскими советами и соответствует религиозным диетическим требованиям мировых рынков.</p></div>
          <div class="cert-box glass reveal reveal-delay-3"><div class="cert-badge-icon">✡️</div><h3>Сертификация Kosher</h3><p>Производится под надзором Kosher, подтверждая гигиену производства и соблюдение традиционных диетических норм.</p></div>
        </div>
      </div>
    </section>

    <section class="container section specs-limits-section" aria-label="Стандартизированные пределы">
      <div class="section-header"><span class="section-label">Стандарты верификации</span><h2>Стандартизированные параметры испытаний</h2><p class="section-desc">Если не указано иное, каждая партия проверяется по следующим нормативам.</p></div>
      <div class="specs-limit-box glass reveal"><table class="limits-table"><thead><tr><th>Категория испытаний</th><th>Стандартный параметр</th><th>Целевой предел спецификации</th><th>Ссылка на метод</th></tr></thead><tbody>
        <tr><td><strong>Тяжёлые металлы</strong></td><td>Свинец (Pb)</td><td>≤ 0,5 ppm</td><td>USP &lt;233&gt; ICP-MS</td></tr>
        <tr><td><strong>Тяжёлые металлы</strong></td><td>Мышьяк (As)</td><td>≤ 1,0 ppm</td><td>USP &lt;233&gt; ICP-MS</td></tr>
        <tr><td><strong>Тяжёлые металлы</strong></td><td>Ртуть (Hg)</td><td>≤ 0,1 ppm</td><td>USP &lt;233&gt; ICP-MS</td></tr>
        <tr><td><strong>Микробиология</strong></td><td>Общее количество микроорганизмов</td><td>≤ 1 000 КОЕ/г</td><td>USP &lt;2021&gt;</td></tr>
        <tr><td><strong>Микробиология</strong></td><td>Дрожжи и плесень</td><td>≤ 100 КОЕ/г</td><td>USP &lt;2021&gt;</td></tr>
        <tr><td><strong>Микробиология</strong></td><td>E. coli / Salmonella</td><td>Отрицательно</td><td>USP &lt;2022&gt;</td></tr>
        <tr><td><strong>Химические показатели</strong></td><td>Остатки пестицидов</td><td>Соответствует пределам EP/USP</td><td>GC-MS / LC-MS</td></tr>
        <tr><td><strong>Химические показатели</strong></td><td>Остатки растворителей</td><td>≤ 500 ppm (этанол)</td><td>GC-Headspace</td></tr>
      </tbody></table></div>
    </section>
  </main>
</BaseLayout>
<style>
  .quality-page { padding-bottom: var(--space-4xl); }
  .page-banner { position: relative; padding-block: 7rem 3.5rem; overflow: hidden; background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%); border-bottom: 1px solid var(--color-border); }
  .banner-gradient { position: absolute; inset: 0; background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%); }
  .banner-title { font-size: clamp(2rem, 3.8vw, 3.1rem); font-weight: 700; line-height: 1.15; margin-top: 0.5rem; color: var(--color-text); }
  .banner-desc { max-width: 600px; margin-top: 1rem; color: var(--color-text-secondary); font-size: 1.0625rem; }
  .intro-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 4rem; align-items: center; }
  .intro-left h2 { font-size: 2.25rem; margin-bottom: 1.25rem; }.intro-left p { color: var(--color-text-secondary); margin-bottom: 2rem; }
  .instrument-list { display: flex; flex-direction: column; gap: 1.5rem; }.instrument-item { display: flex; gap: 1.25rem; align-items: flex-start; }.inst-icon { font-size: 1.75rem; line-height: 1; background: rgba(212,166,84,0.1); padding: 0.5rem; border-radius: var(--radius-sm); color: var(--color-primary); }.instrument-item strong { color: var(--color-primary-light); font-size: 1rem; display: block; margin-bottom: 0.15rem; }.instrument-item p { font-size: 0.875rem; color: var(--color-text-secondary); line-height: 1.5; }
  .image-showcase { position: relative; aspect-ratio: 4/3; overflow: hidden; border-color: rgba(212,166,84,0.18) !important; }.showcase-img { width: 100%; height: 100%; object-fit: cover; }
  .bg-deep { background-color: var(--color-bg-deep); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }.cert-box { padding: 2rem 1.5rem; border-radius: var(--radius-lg); border-color: rgba(212,166,84,0.1) !important; text-align: center; }.cert-box:hover { border-color: var(--color-border-strong) !important; box-shadow: var(--shadow-glow-gold); }.cert-badge-icon { font-size: 2.25rem; margin-bottom: 0.875rem; }.cert-box h3 { font-size: 1.25rem; color: var(--color-primary-light); margin-bottom: 0.5rem; }.cert-box p { font-size: 0.8125rem; line-height: 1.6; }
  .specs-limit-box { padding: 1.5rem; overflow-x: auto; border-radius: var(--radius-lg); border-color: rgba(212,166,84,0.15) !important; }.limits-table { width: 100%; border-collapse: collapse; min-width: 600px; }.limits-table th, .limits-table td { padding: 0.875rem 1rem; text-align: left; border-bottom: 1px solid var(--color-border); }.limits-table th { background: var(--color-surface); color: var(--color-primary-light); font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }.limits-table td { font-size: 0.875rem; color: var(--color-text-secondary); }.limits-table tbody tr:hover td { color: var(--color-text); }
  @media (max-width: 900px) { .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
