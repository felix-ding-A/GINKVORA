# Server-only secrets. Set these in Vercel; never commit real values.
SANITY_REVALIDATE_SECRET=
ISR_BYPASS_TOKEN=

# Use the Preview deployment URL only when testing a Preview webhook.
REVALIDATE_BASE_URL=https://ginkvora.com

# Preview only: use the Vercel Protection Bypass secret to call a protected
# Preview deployment. Leave unset in Production.
REVALIDATE_PROTECTION_BYPASS=
