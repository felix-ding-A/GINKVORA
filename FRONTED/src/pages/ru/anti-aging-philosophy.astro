---
// src/pages/ru/anti-aging-philosophy.astro — Russian Philosophy Page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getLocalePath } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';

const lang = 'ru';
const t = useTranslations(lang as Lang);
const lp = (path: string) => getLocalePath(lang as Lang, path);

const philosophySchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "ECM-таргетное омоложение: научная философия | GINKVORA",
  "description": "Узнайте о научном подходе GINKVORA к воздействию на внеклеточный матрикс (ECM). Синергия наружного ухода и перорального приема для глубокого ремоделирования дермы.",
  "url": "https://ginkvora.com/ru/anti-aging-philosophy"
};
---

<BaseLayout
  lang={lang}
  title="ECM-таргетное омоложение: научная философия | GINKVORA"
  description="Узнайте о научном подходе GINKVORA к воздействию на внеклеточный матрикс (ECM). Синергия наружного ухода и перорального приема для глубокого ремоделирования дермы."
>
  <script type="application/ld+json" set:html={JSON.stringify(philosophySchema)} slot="head" />
  
  <main class="philosophy-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="Page Header">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">Научная философия</span>
        <h1 class="banner-title">Платформа ECM-таргетного омоложения</h1>
        <p class="banner-desc">
          Переосмысление долголетия кожи изнутри и снаружи. Мы рассматриваем внеклеточный матрикс (ECM) как ключевую мишень для восстановления структуры дермы.
        </p>
      </div>
    </header>

    <!-- Section 1: What is ECM -->
    <section class="container section intro-section" id="what-is-ecm" aria-label="Extracellular Matrix Science">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <span class="accent-title">Дермальный каркас</span>
          <h2>Что такое внеклеточный матрикс (ECM)?</h2>
          <p>
            Внеклеточный матрикс (ECM) — это сложная динамическая сеть, которая окружает и поддерживает клетки кожи. Состоящий в основном из структурных белков (коллаген и эластин) и специализированных протеогликанов/гликозаминогликанов (гиалуроновая кислота), ECM служит физическим каркасом, отвечающим за упругость, плотность и молодость кожи.
          </p>
          <p>
            С возрастом и под воздействием факторов внешней среды (таких как УФ-излучение и гликация) дермальный матрикс разрушается. Синтез коллагена замедляется, ферменты металлопротеиназы (MMP) разрушают существующие волокна, а молекулы сахара склеивают белки (гликация). Это приводит к потере упругости, глубоким морщинам и сухости.
          </p>
        </div>
        <div class="intro-right reveal">
          <div class="image-showcase glass">
            <div class="ecm-diagram" aria-hidden="true">
              <div class="matrix-grid-line"></div>
              <div class="matrix-grid-line"></div>
              <div class="matrix-grid-line"></div>
              <div class="fibroblast-node animate-pulse-glow">
                <span>Фибробласт</span>
              </div>
              <div class="collagen-fiber"></div>
              <div class="collagen-fiber" style="transform: rotate(30deg); top: 60%;"></div>
            </div>
            <div class="floating-caption">
              <strong>Внеклеточный матрикс (ECM)</strong>
              <span>Архитектура дермального каркаса</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Three Mechanism Pathways -->
    <section class="section pathways-section bg-deep" id="three-pathways" aria-label="Three Mechanism Pathways">
      <div class="container">
        <div class="section-header reveal">
          <span class="section-label">Пути к обновлению</span>
          <h2>Как мы воздействуем на ECM: три научных механизма</h2>
          <p class="section-desc">
            GINKVORA поставляет активные ингредиенты, нацеленные на ключевые биологические пути синтеза и защиты дермального матрикса.
          </p>
        </div>

        <div class="grid-3">
          <div class="glass-card reveal">
            <span class="card-icon-em">🧬</span>
            <h3>Синтез коллагена</h3>
            <p class="card-subtitle">Восстановление структуры матрикса</p>
            <p class="card-body-text">
              Стимуляция выработки структурных белков. Воздействуя на фибробласты, эти компоненты ускоряют синтез коллагена I, III и IV типов, увеличивая плотность кожи.
            </p>
            <a href={lp('/products?mechanism=matrix-rebuilder')} class="card-anchor-link">
              Купить <span>стимуляторы синтеза коллагена</span> &rarr;
            </a>
          </div>

          <div class="glass-card reveal reveal-delay-1">
            <span class="card-icon-em">🛡️</span>
            <h3>Ингибирование MMP</h3>
            <p class="card-subtitle">Защита от разрушения волокон</p>
            <p class="card-body-text">
              Подавление матриксных металлопротеиназ (MMP) — ферментов, которые активируются солнцем и стрессом и разрушают коллагеновые связи. Это биологический щит кожи.
            </p>
            <a href={lp('/products?mechanism=matrix-shield')} class="card-anchor-link">
              Купить <span>натуральные ингибиторы MMP</span> &rarr;
            </a>
          </div>

          <div class="glass-card reveal reveal-delay-2">
            <span class="card-icon-em">⏳</span>
            <h3>Защита от гликации</h3>
            <p class="card-subtitle">Предотвращение сшивания белков</p>
            <p class="card-body-text">
              Борьба с процессом склеивания белков сахарами, из-за которого коллаген становится жестким и хрупким. Защита от конечных продуктов гликации (AGEs).
            </p>
            <a href={lp('/products?mechanism=glyco-defense')} class="card-anchor-link">
              Купить <span>ингредиенты против гликации</span> &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Dual Routes -->
    <section class="container section synergy-section" id="dual-routes-synergy" aria-label="Topical & Ingestible Synergy">
      <div class="section-header reveal">
        <span class="section-label">Комплексный подход</span>
        <h2>Два пути, одна цель: синергия наружного и перорального применения</h2>
        <p class="section-desc">
          Ремоделирование кожи — это замкнутый цикл. Максимальный эффект достигается при сочетании внешней защиты барьера и внутренней клеточной стимуляции.
        </p>
      </div>

      <div class="synergy-grid">
        <div class="synergy-left glass reveal">
          <div class="synergy-header">
            <span class="synergy-number">01</span>
            <h3>Наружное применение: защита и локальное восстановление</h3>
          </div>
          <p>
            Косметические средства обеспечивают быстрое локальное действие. Компоненты на поверхности кожи (глабридин, медные пептиды, лютеолин) борются с УФ-индуцированным повреждением, нейтрализуют свободные радикалы и активируют синтез коллагена в зоне дермо-эпидермального соединения.
          </p>
          <div class="badge-label">Спецификация: Косметическое сырье (INCI)</div>
        </div>

        <div class="synergy-right glass reveal reveal-delay-1">
          <div class="synergy-header">
            <span class="synergy-number">02</span>
            <h3>Пероральный прием: внутренняя клеточная энергия</h3>
          </div>
          <p>
            Нутрицевтики запускают процессы сборки белков изнутри. Для синтеза белков ECM фибробластам требуется колоссальное количество клеточной энергии (АТФ). Прием активаторов митохондрий (NMN, PQQ) стимулирует обновление митохондрий, обеспечивая фибробласты энергией для постоянной выработки коллагена.
          </p>
          <div class="badge-label">Спецификация: Пищевое / нутрицевтическое сырье</div>
        </div>
      </div>

      <div class="slogan-container glass reveal reveal-delay-2">
        <div class="slogan-quote">«Косметические средства защищают матрикс снаружи, а нутрицевтики оптимизируют клеточную энергию для биосинтеза ECM изнутри»</div>
        <p class="slogan-sub">
          GINKVORA предлагает сырье двойного применения (PQQ, NMN), сертифицированное как по пищевым, так и по косметическим стандартам, помогая создавать синергетические комплексы красоты.
        </p>
        <div class="slogan-cta">
          <a href={lp('/products?application=dual')} class="btn btn--gold">Каталог ингредиентов двойного назначения</a>
        </div>
      </div>
    </section>

    <!-- Section 4: Quality & Compliance -->
    <section class="section compliance-section bg-deep" id="compliance" aria-label="Quality & Compliance Standards">
      <div class="container">
        <div class="grid-2">
          <div class="reveal">
            <span class="accent-title">Контроль и надежность</span>
            <h2>Строгие стандарты качества и соответствия</h2>
            <p>
              Работа на международном B2B рынке требует безупречного соблюдения регуляторных требований. Все ингредиенты GINKVORA проходят тестирование в аккредитованных лабораториях.
            </p>
            <p>
              Наша косметическая линейка полностью зарегистрирована в INCI и соответствует регламенту REACH для поставок в ЕС. Продукты для нутрицевтиков производятся по стандартам GMP, имеют регистрацию FDA и пищевые сертификаты, гарантируя чистоту и безопасность каждой партии.
            </p>
          </div>
          <div class="compliance-features reveal reveal-delay-1">
            <div class="comp-item glass">
              <span class="comp-icon">✓</span>
              <div>
                <h4>Соответствие REACH</h4>
                <p>Полная сертификация сырья для косметической индустрии ЕС.</p>
              </div>
            </div>
            <div class="comp-item glass">
              <span class="comp-icon">✓</span>
              <div>
                <h4>Регистрация в FDA</h4>
                <p>Производство на предприятиях, проверенных FDA.</p>
              </div>
            </div>
            <div class="comp-item glass">
              <span class="comp-icon">✓</span>
              <div>
                <h4>Не тестируется на животных</h4>
                <p>Этичное производство косметических активов (Cruelty-Free).</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="container section cta-section">
      <div class="cta-box glass">
        <h2>Развивайте формулы ваших продуктов с нами</h2>
        <p>Закупайте премиальное сырье с доказанными механизмами действия. Предоставляем бесплатные образцы для тестирования.</p>
        <div class="cta-btns">
          <a href={lp('/contact')} class="btn btn--gold btn--lg">Запросить цены и образцы</a>
          <a href={lp('/products')} class="btn btn--primary btn--lg">Перейти в каталог сырья</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Reuse same styles as EN philosophy page */
  .philosophy-page {
    padding-bottom: var(--space-4xl);
  }
  .page-banner {
    position: relative;
    padding-block: 8rem 4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }
  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }
  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }
  .banner-desc {
    max-width: 700px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .section {
    padding-block: var(--space-2xl);
  }
  .accent-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .intro-left h2 {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }
  .intro-left p {
    margin-bottom: 1.25rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }
  .image-showcase {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-color: rgba(212,166,84,0.18) !important;
  }
  .ecm-diagram {
    width: 100%;
    height: 100%;
    background: #080705;
    position: relative;
    overflow: hidden;
  }
  .matrix-grid-line {
    position: absolute;
    width: 100%;
    height: 1px;
    background: rgba(212, 166, 84, 0.05);
    top: 30%;
  }
  .matrix-grid-line:nth-child(2) { top: 60%; }
  .matrix-grid-line:nth-child(3) {
    width: 1px;
    height: 100%;
    left: 50%;
    top: 0;
  }
  .fibroblast-node {
    position: absolute;
    top: 40%;
    left: 35%;
    background: rgba(212, 166, 84, 0.15);
    border: 1px solid var(--color-primary);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--color-primary-light);
    z-index: 2;
  }
  .collagen-fiber {
    position: absolute;
    height: 2px;
    width: 80%;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    top: 45%;
    left: 10%;
    opacity: 0.4;
  }
  .floating-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(6, 5, 3, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }
  .floating-caption strong {
    color: var(--color-primary-light);
    font-size: 0.875rem;
  }
  .floating-caption span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }
  .bg-deep {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }
  .section-header h2 {
    font-size: 2.25rem;
    line-height: 1.25;
  }
  .section-desc {
    color: var(--color-text-secondary);
    margin-top: 0.75rem;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 900px) {
    .grid-3 {
      grid-template-columns: 1fr;
    }
  }
  .glass-card {
    padding: 2.5rem 2rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }
  .glass-card:hover {
    border-color: rgba(212, 166, 84, 0.25) !important;
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.03);
  }
  .card-icon-em {
    font-size: 2.25rem;
    display: block;
    margin-bottom: 1rem;
  }
  .glass-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }
  .card-subtitle {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--color-primary-light);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .card-body-text {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    flex: 1;
  }
  .card-anchor-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .card-anchor-link span {
    text-decoration: underline;
  }
  .card-anchor-link:hover {
    color: var(--color-accent-light);
  }
  .synergy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  @media (max-width: 900px) {
    .synergy-grid {
      grid-template-columns: 1fr;
    }
  }
  .synergy-left, .synergy-right {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
  }
  .synergy-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .synergy-number {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    color: var(--color-primary);
    font-weight: 700;
    opacity: 0.8;
  }
  .synergy-header h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-text);
  }
  .synergy-left p, .synergy-right p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }
  .badge-label {
    font-size: 0.75rem;
    background: rgba(212, 166, 84, 0.08);
    color: var(--color-primary-light);
    border: 1px solid rgba(212, 166, 84, 0.2);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    font-weight: 600;
  }
  .synergy-right .badge-label {
    background: rgba(124, 184, 122, 0.08);
    color: #a8d5a6;
    border-color: rgba(124, 184, 122, 0.2);
  }
  .slogan-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(212, 166, 84, 0.15) !important;
    text-align: center;
    background: linear-gradient(135deg, rgba(212, 166, 84, 0.03) 0%, rgba(0, 0, 0, 0) 100%);
  }
  .slogan-quote {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1.45;
    margin-bottom: 1rem;
  }
  .slogan-sub {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 760px;
    margin: 0 auto 2rem;
  }
  .slogan-cta {
    display: flex;
    justify-content: center;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .grid-2 {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .grid-2 h2 {
    font-size: 2.25rem;
    line-height: 1.25;
    margin-bottom: 1.5rem;
  }
  .grid-2 p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }
  .compliance-features {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .comp-item {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(212, 166, 84, 0.1) !important;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .comp-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(124, 184, 122, 0.15);
    color: #a8d5a6;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
    flex-shrink: 0;
