---
const lang = 'ar';
// src/pages/about.astro — Premium B2B About page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllAuthors, urlFor, getLocalizedField } from '../../lib/sanity';

const authors = await getAllAuthors();

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "من نحن GINKVORA",
  "description": "تعرف على تاريخ GINKVORA، وتقنيات الاستخلاص عالية النقاء، ومعايير مصادر المواد الخام لدينا.",
  "url": "https://ginkvora.com/ar/about",
  "mainEntity": authors.map(author => ({
    "@type": "Person",
    "name": getLocalizedField(author, 'name', lang) || author.name,
    "jobTitle": getLocalizedField(author, 'title', lang) || author.title || undefined,
    "description": getLocalizedField(author, 'bio', lang) || author.bio || undefined,
    "image": author.avatar ? urlFor(author.avatar).url() : undefined
  }))
};




---

<BaseLayout lang={lang}
  title="مورد مستخلصات نباتية B2B | من نحن GINKVORA"
  description="تعرف على تاريخ GINKVORA، وتقنيات الاستخلاص عالية النقاء، ومعايير مصادر المواد الخام لدينا. ندعم العلامات التجارية العالمية للمكملات الغذائية."
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} slot="head" />
  <main class="about-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="ترويسة الصفحة">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">شركتنا</span>
        <h1 class="banner-title">الريادة في المواد النشطة الحيوية النباتية النقية</h1>
        <p class="banner-desc">
          ربط المصادر النباتية البكر مع العزل المختبري المتقدم لتوريد مكونات نشطة صيدلانية النقاء إلى الصناعات العالمية.
        </p>
      </div>
    </header>

    <!-- Company Intro -->
    <section class="container section intro-section" aria-label="نظرة عامة على الشركة">
      <div class="intro-grid">
        <div class="intro-left reveal">
          <h2>طبيعة نقية، علم موثق</h2>
          <p>
            تأسست GINKVORA مع الالتزام بالنقاء الكيميائي والسلامة النباتية، وتطورت لتصبح مصنعاً متميزاً ومطوراً مخصصاً لمستخلصات النباتات الطبيعية ذات القيمة العالية والمركبات المعزولة لقطاع B2B.
          </p>
          <p>
            نحن ندير سلسلة إمداد شاملة تمتد من مناطق مصادر النباتات المحلية المعتمدة، ومنشآت الاستخلاص بالمذيبات وثاني أكسيد الكربون فوق الحرج الحديثة، إلى مختبر البحث والتطوير المتقدم في شيان.
          </p>
          <div class="mission-box">
            <span class="mission-title">مهمتنا الأساسية</span>
            <blockquote class="mission-text">
              "تمكين العلامات التجارية لصحة الإنسان من خلال تقديم النقاء المطلق للمكونات النشطة، وسجلات مراقبة الجودة القابلة للتحقق، وحلول التوريد بالجملة الموثوقة."
            </blockquote>
          </div>
        </div>
        <div class="intro-right reveal reveal-delay-2">
          <div class="image-showcase glass">
            <img
              src="/images/ginkvora-rd-analytical-laboratory.webp"
              alt="مرفق أبحاث ومختبر GINKVORA"
              class="showcase-img"
              width="800"
              height="600"
            />
            <div class="floating-caption">
              <strong>مركز البحث والتطوير في شيان</strong>
              <span>تحليل الكروماتوغرافيا السائلة HPLC وطيف الكتلة</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Extraction Values -->
    <section class="section values-section bg-deep" aria-label="ميزاتنا التكنولوجية">
      <div class="container">
        <div class="section-header">
          <span class="section-label">الكفاءة العلمية</span>
          <h2 class="section-title">عملية الاستخلاص الصناعي لدينا</h2>
          <p class="section-desc">
            الجمع بين الحكمة العشبية التقليدية وتقنيات العزل التحليلي المتطورة.
          </p>
        </div>

        <div class="grid-3">
          <article class="value-card glass reveal">
            <div class="value-icon">🔬</div>
            <h3>عزل مدفوع بالنقاء</h3>
            <p>
              نركز على عزل المكونات الأحادية النشطة (مثل NMN و PQQ وجلابريدين) بدرجات نقاء قياسية تبلغ ≥98% و ≥99% باستخدام أنظمة الكروماتوغرافيا المتقدمة.
            </p>
          </article>

          <article class="value-card glass reveal reveal-delay-1">
            <div class="value-icon">⚙️</div>
            <h3>طرق استخلاص صديقة للبيئة</h3>
            <p>
              نستخدم تقنية استخلاص ثاني أكسيد الكربون فوق الحرج (sCO2) والعمليات المائية ذات الحرارة المنخفضة للتخلص من المذيبات الكيميائية المتبقية السامة وحماية المركبات النشطة.
            </p>
          </article>

          <article class="value-card glass reveal reveal-delay-2">
            <div class="value-icon">🛡️</div>
            <h3>سجلات جودة قابلة للتتبع</h3>
            <p>
              تخضع كل دفعة مصنعة لاختبارات صارمة للهوية والنقاء والمعادن الثقيلة والميكروبات وبقايا المبيدات. تتوفر تقارير التحقق من المختبرات الخارجية (SGS/Eurofins) عند الطلب.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Timeline/History Section -->
    <section class="container section history-section" aria-label="تاريخنا">
      <div class="section-header">
        <span class="section-label">مسيرتنا</span>
        <h2>النمو والمحطات الرئيسية</h2>
      </div>

      <div class="timeline">
        <div class="timeline-item reveal">
          <div class="timeline-badge">2023</div>
          <div class="timeline-content glass">
            <h3>التأسيس والبحث والتطوير الأولي</h3>
            <p>تأسيس GINKVORA في شيان، والتخصص في أبحاث الميتوكوندريا المساعدة وإطلاق قنوات توريد PQQ وNMN عالية النقاء.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-1">
          <div class="timeline-badge">2024</div>
          <div class="timeline-content glass">
            <h3>شهادات التصنيع الجيد GMP والآيزو ISO</h3>
            <p>اكتمل بناء مصنع الاستخلاص الشريك لدينا. حصلنا على شهادات GMP وISO 9001:2015 وحلال وكوشر للامتثال الغذائي العالمي.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-2">
          <div class="timeline-badge">2025</div>
          <div class="timeline-content glass">
            <h3>إطلاق خطوط التجميل وصحة الحيوان</h3>
            <p>قمنا بتوسيع الكتالوج الكيميائي ليشمل جلابريدين لتفتيح البشرة، والفلافونويدات الطبيعية، والمكونات الغذائية المتخصصة لقطاع صحة الحيوانات الأليفة.</p>
          </div>
        </div>

        <div class="timeline-item reveal reveal-delay-3">
          <div class="timeline-badge">2026</div>
          <div class="timeline-content glass">
            <h3>الخدمات اللوجستية العالمية والمنصة الرقمية</h3>
            <p>أطلقنا شبكة إمداد دولية عالية الأداء تخدم مكملات العناية بالبشرة والرياضة في أكثر من 50 دولة مع مراكز لوجستية محسنة.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Authors Section -->
    <section class="container section authors-section" aria-label="خبراؤنا العلميون">
      <div class="section-header">
        <span class="section-label">الخبرة والجودة</span>
        <h2>فريقنا العلمي والتنظيمي</h2>
        <p class="section-desc">
          تعرف على الباحثين والمطورين وخبراء مراقبة الجودة وراء المكونات النشطة الحيوية النباتية النقية من GINKVORA.
        </p>
      </div>

      <div class="authors-grid">
        {authors.map((author) => (
          <div class="author-card glass reveal">
            <div class="author-avatar-wrapper">
              <img
                src={urlFor(author.avatar).width(160).height(160).fit('crop').url()}
                alt={author.name}
                class="author-avatar"
                width="160"
                height="160"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="author-info">
              <h3>{getLocalizedField(author, 'name', lang) || author.name}</h3>
              {(getLocalizedField(author, 'title', lang) || author.title) && <p class="author-title">{getLocalizedField(author, 'title', lang) || author.title}</p>}
              {(getLocalizedField(author, 'credentials', lang) || author.credentials) && <span class="author-creds">{getLocalizedField(author, 'credentials', lang) || author.credentials}</span>}
              {(getLocalizedField(author, 'bio', lang) || author.bio) && <p class="author-bio">{getLocalizedField(author, 'bio', lang) || author.bio}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 8rem 4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Intro Section ── */
  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }

  .intro-left h2 {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
  }

  .intro-left p {
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }

  .mission-box {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .mission-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .mission-text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.6;
  }

  .image-showcase {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    border-color: rgba(212,166,84,0.18) !important;
    cursor: pointer;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow, 400ms) ease;
  }

  .image-showcase:hover .showcase-img {
    transform: scale(1.05);
  }

  .floating-caption {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    background: rgba(6, 5, 3, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .floating-caption strong {
    color: var(--color-primary-light);
    font-size: 0.875rem;
  }

  .floating-caption span {
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  /* ── Values Section ── */
  .bg-deep {
    background-color: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .value-card {
    padding: 2.25rem 1.75rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212,166,84,0.1) !important;
    text-align: center;
    transition: all var(--transition-base, 250ms) ease;
  }

  .value-card:hover {
    border-color: var(--color-primary-light) !important;
    box-shadow: var(--shadow-glow-gold);
    transform: translateY(-6px);
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.375rem;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .value-card p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ── Timeline ── */
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 3rem auto 0;
    padding-left: 2rem;
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-badge {
    position: absolute;
    left: calc(-2rem - 13px);
    top: 0.5rem;
    width: 26px;
    height: 26px;
    background: var(--color-bg);
    border: 2px solid var(--color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-primary-light);
    box-shadow: 0 0 10px rgba(212,166,84,0.3);
  }

  .timeline-content {
    padding: 1.5rem;
    border-radius: var(--radius-md);
    border-color: rgba(212,166,84,0.12) !important;
    transition: all var(--transition-base, 250ms) ease;
  }

  .timeline-content:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-glow-gold);
  }

  .timeline-content h3 {
    font-size: 1.125rem;
    color: var(--color-primary-light);
    margin-bottom: 0.25rem;
  }

  .timeline-content p {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ── Authors Section ── */
  .authors-section {
    margin-top: 2rem;
  }

  .authors-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .authors-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .author-card {
    display: flex;
    gap: 2rem;
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
    align-items: center;
    transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }

  @media (max-width: 540px) {
    .author-card {
      flex-direction: column;
      text-align: center;
      padding: 2rem;
    }
  }

  .author-card:hover {
    border-color: var(--color-primary-light) !important;
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow-gold);
  }

  .author-avatar-wrapper {
    flex-shrink: 0;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-primary-light);
    box-shadow: 0 0 15px rgba(212, 166, 84, 0.15);
  }

  .author-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base, 250ms) ease;
  }

  .author-card:hover .author-avatar {
    transform: scale(1.08);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-info h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .author-title {
    font-size: 0.9rem;
    color: var(--color-primary-light);
    font-weight: 500;
  }

  .author-creds {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: rgba(212, 166, 84, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    align-self: start;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 540px) {
    .author-creds {
      align-self: center;
    }
  }

  .author-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-top: 0.25rem;
  }
</style>
