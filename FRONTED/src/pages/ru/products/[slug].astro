    transition: all var(--transition-fast);
  }
  .checkbox-label input:checked ~ .custom-checkbox {
    border-color: var(--color-primary);
    background: rgba(212, 166, 84, 0.08);
  }
  .custom-checkbox::after {
    content: '';
    position: absolute;
    display: none;
    left: 5px;
    top: 2px;
    width: 4px;
    height: 7px;
    border: solid var(--color-primary-light);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .checkbox-label input:checked ~ .custom-checkbox::after {
    display: block;
  }
  .modal-submit-wrap {
    margin-top: 1rem;
  }
  .w-full {
    width: 100%;
  }
  .modal-privacy-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.4;
    margin-top: 0.75rem;
  }
  .success-icon-wrap {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .success-check {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: block;
    stroke-width: 2;
    stroke: var(--color-success);
    stroke-miterlimit: 10;
    box-shadow: inset 0px 0px 0px var(--color-success);
    animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s dashed;
    margin: 0 auto;
  }
  .success-check-circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    stroke-width: 2;
    stroke-miterlimit: 10;
    stroke: var(--color-success);
    fill: none;
    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
  }
  .success-check-mark {
    transform-origin: 50% 50%;
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    stroke-width: 3;
    stroke: var(--color-success);
    animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
  }
  @keyframes stroke {
    100% { stroke-dashoffset: 0; }
  }
  @keyframes fill {
    100% { box-shadow: inset 0px 0px 0px 30px rgba(124, 184, 122, 0.05); }
  }
</style>

<script>
  function initTabs() {
    const descSection = document.querySelector('.description-section');
    document.querySelectorAll('.detail-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const target = (tab as HTMLElement).dataset.tab;
        document.querySelectorAll('.detail-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => (c as HTMLElement).style.display = 'none');
        tab.classList.add('active');
        const panel = document.getElementById(`tab-${target}`);
        if (panel) panel.style.display = 'block';

        if (descSection) {
          const rect = descSection.getBoundingClientRect();
          const navbarOffset = 70;
          if (rect.top < navbarOffset) {
            const targetY = window.scrollY + rect.top - navbarOffset;
            window.scrollTo({
              top: Math.max(0, targetY),
              behavior: 'smooth'
            });
          }
        }
      });
    });
  }

  function initCOAModal() {
    const coaBtn = document.getElementById('download-coa-btn');
    const modal = document.getElementById('coa-modal');
    const closeBtn = document.getElementById('coa-modal-close');
    const form = document.getElementById('coa-lead-form') as HTMLFormElement;
    const formState = document.getElementById('coa-form-state');
    const successState = document.getElementById('coa-success-state');
    const fallbackLink = document.getElementById('coa-fallback-link') as HTMLAnchorElement;
    const successClose = document.getElementById('coa-success-close');
    const submitBtn = document.getElementById('coa-submit-btn') as HTMLButtonElement;

    if (!coaBtn || !modal) return;

    const productName = coaBtn.getAttribute('data-product-name') || '';
    const coaUrl = coaBtn.getAttribute('data-coa-url') || '';

    coaBtn.addEventListener('click', (e) => {
      e.preventDefault();
      
      // Reset form and states
      if (form) form.reset();
      if (formState) formState.style.display = 'block';
      if (successState) successState.style.display = 'none';
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Отправить и скачать';
      }
      
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
    });

    const closeModal = () => {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
    };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (successClose) successClose.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Обработка...';
        }

        const formData = new FormData(form);

        // Honeypot check
        if (formData.get('b_website')) {
          console.warn('Bot detected.');
          closeModal();
          return;
        }

        const applications: string[] = [];
        form.querySelectorAll('input[name="application"]:checked').forEach((el) => {
          applications.push((el as HTMLInputElement).value);
        });

        const submitCoa = async (token?: string) => {
          const data = {
            name: formData.get('name'),
            company: formData.get('company') || 'None',
            email: formData.get('email'),
            phone: formData.get('phone'),
            role: formData.get('role'),
            demand: formData.get('demand'),
            application: applications,
            productName,
            coaUrl,
            b_website: formData.get('b_website'),
            recaptchaToken: token || null,
          };

          try {
            const res = await fetch('/api/coa-lead', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });

            if (res.ok) {
              if (formState) formState.style.display = 'none';
              if (successState) successState.style.display = 'block';
              
              if (fallbackLink) {
                fallbackLink.href = coaUrl;
              }

              // Push custom event to dataLayer for GTM tracking
              window.dataLayer = window.dataLayer || [];
              window.dataLayer.push({
                event: 'coa_lead_submit',
                productName: productName,
                coaUrl: coaUrl
              });

              // Trigger download in new window
              window.open(coaUrl, '_blank');
            } else {
              const errData = await res.json();
              alert(errData.error || 'Ошибка при отправке формы. Пожалуйста, попробуйте еще раз.');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Отправить и скачать';
              }
            }
          } catch (err) {
            alert('Ошибка сети. Проверьте соединение и повторите попытку.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Отправить и скачать';
            }
          }
        };

        // @ts-ignore
        if (typeof grecaptcha !== 'undefined') {
          // @ts-ignore
          grecaptcha.ready(() => {
            // @ts-ignore
            grecaptcha.execute('6LfauEktAAAAAMqxmIliI2O9cby28DZr-cQyhLid', { action: 'submit_coa' })
              .then((token) => {
                submitCoa(token);
              })
              .catch((err) => {
                console.error('reCAPTCHA execution failed:', err);
                submitCoa();
              });
          });
        } else {
          submitCoa();
        }
      });
    }
  }

  function initSocialShare() {
    const shareFacebook = document.getElementById('share-facebook');
    const shareLinkedin = document.getElementById('share-linkedin');
    const shareTwitter = document.getElementById('share-twitter');
    const shareCopy = document.getElementById('share-copy');
    const shareEmail = document.getElementById('share-email');

    const pageUrl = window.location.href;
    const pageTitle = document.title;

    shareFacebook?.addEventListener('click', () => {
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=600');
    });

    shareLinkedin?.addEventListener('click', () => {
      window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`, '_blank', 'width=600,height=600');
    });

    shareTwitter?.addEventListener('click', () => {
      window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`, '_blank', 'width=600,height=400');
    });

    shareEmail?.addEventListener('click', () => {
      window.location.href = `mailto:?subject=${encodeURIComponent(pageTitle)}&body=${encodeURIComponent(pageUrl)}`;
    });

    shareCopy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pageUrl);
        const tooltip = document.getElementById('share-copy-tooltip');
        if (tooltip) {
          tooltip.classList.add('share-tooltip--visible');
          setTimeout(() => {
            tooltip.classList.remove('share-tooltip--visible');
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy link: ', err);
      }
    });
  }

  function runInit() {
    initTabs();
    initCOAModal();
    initSocialShare();
  }

  // Astro page-load support
  runInit();
  document.addEventListener('astro:page-load', runInit);
</script>
