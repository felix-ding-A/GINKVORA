---
const lang = 'ar';
// src/pages/contact.astro — Premium B2B Inquiry and RFQ page
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Pre-fill query param support
const title = "اتصل بـ GINKVORA | توريد المستخلصات النباتية B2B وطلب عرض الأسعار RFQ";
const description = "اتصل بـ GINKVORA للاستفسارات عن المستخلصات النباتية B2B، وأسعار الجملة، ومواصفات الصيغ المخصصة، وطلب عينات مجانية. دعم سريع لطلب عروض الأسعار RFQ.";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "الاتصال بـ GINKVORA",
  "description": description,
  "url": "https://ginkvora.com/ar/contact"
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "GINKVORA",
  "image": "https://ginkvora.com/ar/images/logo.svg",
  "email": "inquiry@ginkvora.com",
  "telephone": "+86 13201818603",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "منطقة التجارة الحرة والخدمات اللوجستية الدولية بشيان",
    "addressLocality": "شيان",
    "addressCountry": "CN"
  },
  "url": "https://ginkvora.com/ar"
};




---

<BaseLayout lang={lang} title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <main class="contact-page bg-noise">
    <!-- Header banner -->
    <header class="page-banner" aria-label="ترويسة الصفحة">
      <div class="banner-gradient"></div>
      <div class="container banner-content">
        <span class="section-label">تواصل معنا</span>
        <h1 class="banner-title">الاتصال بـ GINKVORA — استفسار وطلب عروض أسعار المكونات بالجملة B2B</h1>
        <p class="banner-desc">
          هل أنت جاهز لتوريد مكونات نشطة عالية النقاء؟ اتصل بفريقنا التجاري للحصول على عروض أسعار فورية وشحن العينات ووثائق الامتثال.
        </p>
      </div>
    </header>

    <div class="container contact-container">
      <div class="contact-grid">
        <!-- Left: Form -->
        <section class="form-card glass" aria-label="نموذج طلب عروض الأسعار">
          <h2>طلب عرض أسعار / عينة</h2>
          <p class="form-subtitle">الحقول المصحوبة بنجمة (*) مطلوبة.</p>

          <form id="contact-full-form" class="full-form">
            <input type="text" name="b_website" class="honeypot-field" autocomplete="off" tabindex="-1" placeholder="اترك هذا الحقل فارغًا" />
            <div class="form-row-2">
              <div class="form-field">
                <label for="name" class="form-label">الاسم / اسم الشركة *</label>
                <input type="text" id="name" name="name" required class="form-input" placeholder="جون دو / شركة التكنولوجيا الحيوية المحدودة" />
              </div>
              <div class="form-field">
                <label for="email" class="form-label">البريد الإلكتروني للعمل *</label>
                <input type="email" id="email" name="email" required class="form-input" placeholder="john@company.com" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-field">
                <label for="phone" class="form-label">الهاتف / واتساب *</label>
                <input type="tel" id="phone" name="phone" required class="form-input" placeholder="+1 (555) 123-4567" />
              </div>
              <div class="form-field">
                <label for="website" class="form-label">الموقع الإلكتروني للشركة</label>
                <input type="url" id="website" name="website" class="form-input" placeholder="https://company.com" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-field">
                <label for="industry" class="form-label">قطاع الصناعة *</label>
                <select id="industry" name="industry" required class="form-input form-select">
                  <option value="" disabled selected>اختر القطاع...</option>
                  <option value="dietary-supplements">المكملات الغذائية</option>
                  <option value="cosmetics">مستحضرات التجميل والعناية بالبشرة</option>
                  <option value="pet-health">صحة الحيوانات الأليفة والأعلاف</option>
                  <option value="food-beverage">الأغذية والمشروبات الوظيفية</option>
                  <option value="pharmaceuticals">الصناعات الدوائية</option>
                  <option value="other">أخرى / أبحاث</option>
                </select>
              </div>
              <div class="form-field">
                <label for="productSelect" class="form-label">المكون المستهدف *</label>
                <input type="text" id="productSelect" name="productName" required class="form-input" placeholder="مثال: PQQ، NMN، جلابريدين..." />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-field">
                <label for="quantity" class="form-label">الكمية المطلوبة *</label>
                <input type="text" id="quantity" name="quantity" required class="form-input" placeholder="مثال: 25 كجم، 100 كجم" />
              </div>
            </div>

            <div class="form-field">
              <label for="message" class="form-label">الرسالة ومتطلبات المواصفات</label>
              <textarea id="message" name="message" class="form-input" rows="5" placeholder="اختياري. حدد مستويات النقاء، ميناء الشحن المستهدف، متطلبات الشهادات، أو طلبات التركيب المخصصة..."></textarea>
            </div>

            <button type="submit" class="btn btn--gold btn--lg" id="submit-btn">
              إرسال طلب الاستفسار RFQ
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>

            <div id="success-msg" class="success-message" style="display: none;" role="alert">
              ✓ تم إرسال طلب عرض الأسعار. سيرد عليك أحد المسؤولين عبر البريد الإلكتروني في غضون 12 ساعة.
            </div>
          </form>
        </section>

        <!-- Right: Info -->
        <aside class="info-sidebar">
          <div class="info-card glass">
            <h3>إحداثيات الاتصال المباشر</h3>
            <p>تجاوز النموذج وتواصل مباشرة مع مكتبنا التجاري.</p>

            <div class="contact-list">
              <div class="contact-item">
                <div class="contact-icon">📧</div>
                <div class="contact-body">
                  <span class="label">الاستفسارات العامة وطلب عروض الأسعار RFQ</span>
                  <a href="mailto:inquiry@ginkvora.com" class="val">inquiry@ginkvora.com</a>
                </div>
              </div>

              <div class="contact-item">
                <div class="contact-icon">📞</div>
                <div class="contact-body">
                  <span class="label">دعم الهاتف / واتساب</span>
                  <a href="https://wa.me/8613201818603" target="_blank" rel="noopener noreferrer" class="val">+86 13201818603</a>
                </div>
              </div>

              <div class="contact-item">
                <div class="contact-icon">📍</div>
                <div class="contact-body">
                  <span class="label">عنوان المقر الرئيسي</span>
                  <span class="val">منطقة التجارة الحرة والخدمات اللوجستية الدولية، شيان، الصين</span>
                </div>
              </div>
            </div>
          </div>

          <div class="info-card glass mt-6">
            <h3>سياسات التوريد B2B</h3>
            <ul class="policy-list">
              <li>
                <strong>عينات مجانية:</strong> تتوفر عينات قياسية من 10 جرام إلى 50 جرام للمصنعين المؤهلين (تطبق رسوم الشحن).
              </li>
              <li>
                <strong>معايير الحد الأدنى للطلب (MOQ):</strong> موك التعبئة القياسي هو 1 كجم أو 25 كجم (ألياف برميلية) حسب قيمة المكون.
              </li>
              <li>
                <strong>الوثائق:</strong> يتم توفير شهادة التحليل (COA) وورقة بيانات سلامة المواد (MSDS) والمواصفات وإعلانات مسببات الحساسية مع كل عرض أسعار.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </main>
  
  <!-- Google reCAPTCHA v3 -->
  <script is:inline src={`https://www.recaptcha.net/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`}></script>
</BaseLayout>

<style>
  .contact-page {
    padding-bottom: var(--space-4xl);
  }

  /* ── Banner ── */
  .page-banner {
    position: relative;
    padding-block: 8rem 4rem;
    overflow: hidden;
    background: linear-gradient(135deg, #030201 0%, #0c0804 50%, #060503 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .banner-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 35% 50% at 75% 20%, rgba(212, 166, 84, 0.08) 0%, transparent 100%);
  }

  .banner-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-top: 0.5rem;
    color: var(--color-text);
  }

  .banner-desc {
    max-width: 600px;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
  }

  /* ── Grid ── */
  .contact-container {
    margin-top: -2rem;
    position: relative;
    z-index: var(--z-float);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 2.5rem;
  }

  @media (max-width: 1024px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .form-card {
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.18) !important;
  }

  .form-card h2 {
    font-size: 1.875rem;
    margin-bottom: 0.25rem;
  }

  .form-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .full-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .form-row-2 { grid-template-columns: 1fr; gap: 1.25rem; }
  }

  .full-form #submit-btn {
    align-self: center;
    margin-top: 1rem;
  }

  .mt-6 { margin-top: 1.5rem; }

  /* ── Sidebar ── */
  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    padding: 2rem;
    border-radius: var(--radius-lg);
    border-color: rgba(212, 166, 84, 0.1) !important;
  }

  .info-card h3 {
    font-size: 1.375rem;
    color: var(--color-primary-light);
    margin-bottom: 0.75rem;
  }

  .info-card p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .contact-icon {
    font-size: 1.5rem;
    line-height: 1;
    padding-top: 0.2rem;
  }

  .contact-body {
    display: flex;
    flex-direction: column;
  }

  .contact-body .label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-body .val {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .contact-body a.val:hover {
    color: var(--color-primary-light);
  }

  .policy-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .policy-list li strong {
    color: var(--color-primary-light);
    display: block;
    margin-bottom: 0.15rem;
  }

  .success-message {
    padding: 1rem;
    background: rgba(124, 184, 122, 0.15);
    border: 1px solid var(--color-success);
    color: var(--color-success);
    border-radius: var(--radius-sm);
    text-align: center;
    font-weight: 500;
    margin-top: 1rem;
  }
</style>

<script>
  function initContactForm() {
    // Fill query param product name if exists
    const urlParams = new URLSearchParams(window.location.search);
    const targetProduct = urlParams.get('product');
    const productInput = document.getElementById('productSelect') as HTMLInputElement;

    if (targetProduct && productInput) {
      productInput.value = targetProduct;
    }

    const form = document.getElementById('contact-full-form') as HTMLFormElement;
    const successMsg = document.getElementById('success-msg');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'جاري الإرسال...';
        }

        const formData = new FormData(form);
        if (formData.get('b_website')) {
          console.warn('Bot submission detected via honeypot field.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'إرسال طلب الاستفسار RFQ';
          }
          return;
        }

        const submitData = async (token?: string) => {
          const data = {
            name: formData.get('name'),
            email: formData.get('email'),
            website: formData.get('website') || 'None',
            phone: formData.get('phone'),
            industry: formData.get('industry'),
            productName: formData.get('productName'),
            quantity: formData.get('quantity'),
            message: formData.get('message') || 'None',
            b_website: formData.get('b_website'),
            recaptchaToken: token || null,
          };

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });

            if (res.ok) {
              form.reset();
              if (successMsg) successMsg.style.display = 'block';
              if (submitBtn) submitBtn.textContent = 'تم الإرسال ✓';
              window.location.href = '/ar/thank-you';
            } else {
              const errData = await res.json();
              alert(errData.error || 'فشل إرسال النموذج. يرجى التحقق من التفاصيل أو مراسلتنا عبر البريد الإلكتروني مباشرة.');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'إرسال طلب الاستفسار RFQ';
              }
            }
          } catch (err) {
            alert('خطأ في الاتصال. يرجى المحاولة مرة أخرى.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'إرسال طلب الاستفسار RFQ';
            }
          }
        };

        // @ts-ignore
        if (typeof grecaptcha !== 'undefined') {
          // @ts-ignore
          grecaptcha.ready(() => {
            // @ts-ignore
            grecaptcha.execute('6LfauEktAAAAAMqxmIliI2O9cby28DZr-cQyhLid', { action: 'submit_rfq' })
              .then((token) => {
                submitData(token);
              })
              .catch((err) => {
                console.error('reCAPTCHA execution failed:', err);
                submitData();
              });
          });
        } else {
          submitData();
        }
      });
    }
  }

  // Astro page-load support
  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
